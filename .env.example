# ============================================================================
# PRETTY CHARM E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env for local development. Never commit real secrets.
# ============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI assistant & studio endpoints.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical base URL where the application is hosted.
APP_URL="http://localhost:3000"

# DATABASE_PATH: Path to persistent SQLite database file.
DATABASE_PATH="./data/pretty_charm.sqlite"

# SESSION_SECRET: Random secret used for signing admin & customer sessions.
SESSION_SECRET="replace-with-strong-64-char-random-secret-in-production"

# ADMIN BOOTSTRAP CONFIGURATION:
# Used to safely create or reset the initial Owner/Admin account without a public open endpoint.
ADMIN_BOOTSTRAP_TOKEN="replace-with-one-time-bootstrap-token"
ADMIN_INITIAL_EMAIL="owner@prettycharm.in"
ADMIN_INITIAL_PASSWORD="replace-with-strong-admin-password"

# PAYMENT CONFIGURATION:
# Allowed values: "whatsapp" | "manual" | "razorpay" | "demo"
# WARNING: Do not assume a personal or minor savings/UPI account is approved for commercial/merchant use.
# Confirm merchant account eligibility with your bank/payment provider before accepting live payments.
PAYMENT_MODE="whatsapp"
PAYMENT_MANUAL_UPI_ID="placeholder-upi@bank"
PAYMENT_MANUAL_LINK=""
PAYMENT_MANUAL_QR_URL=""
PAYMENT_MANUAL_ACCOUNT_NOTE="Owner verification in actual bank/UPI statement required before marking paid."
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SHIPPING & COURIER (SHIPROCKET) CONFIGURATION:
# Automatic courier sync remains disabled until real credentials are supplied.
SHIPROCKET_ENABLED="false"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_WEBHOOK_TOKEN=""
SHIPPING_ORIGIN_CITY="Gurugram"
SHIPPING_ORIGIN_STATE="Haryana"
SHIPPING_ORIGIN_PINCODE="122001"

# WHATSAPP & INSTAGRAM SUPPORT CONFIGURATION:
# Click-to-Chat (wa.me) opens WhatsApp with a prefilled message for manual sending.
# Automatic outbound messages require an official WhatsApp Business Platform/API and approved templates.
STORE_WHATSAPP_NUMBER="919000000000"
STORE_SUPPORT_EMAIL="support-placeholder@prettycharm.in"
STORE_INSTAGRAM_HANDLE="prettycharm.in"

