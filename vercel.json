{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|assets|uploads|favicon|icon\\.svg|sw\\.js|workbox|manifest).*)$",
      "destination": "/index.html"
    }
  ]
}
