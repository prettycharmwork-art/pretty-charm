            lines {
              text: "function checkRateLimit(key: string, maxAttempts = 8, windowMs = 5 * 60 * 1000): boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const now = Date.now();"
