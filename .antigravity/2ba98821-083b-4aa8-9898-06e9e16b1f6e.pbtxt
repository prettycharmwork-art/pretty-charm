              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const hNew = container.clientHeight || window.innerHeight;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.aspect = wNew / hNew;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.updateProjectionMatrix();"
