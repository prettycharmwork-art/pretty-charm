    command_line: "npx --yes tsx -e \"\n(async () => {\n  const queries = [\n    { id: \'prod-pearl-claw\', q: \'\\\"hair clip\\\" OR \\\"claw clip\\\" OR \\\"pearl hair\\\" filetype:bitmap\' },\n    { id: \'prod-silk-scrunchie-trio\', q: \'intitle:scrunchie filetype:bitmap\' },\n    { id: \'prod-satin-bow-barrette\', q: \'intitle:bow \\\"pink\\\" \\\"ribbon\\\" filetype:bitmap\' },\n  ];\n\n  for (const item of queries) {\n    const url = \'https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=\' + encodeURIComponent(item.q) + \'&gsrnamespace=6&gsrlimit=6&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n    const res = await fetch(url, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n    const data = await res.json();\n    const pages = Object.values(data?.query?.pages || {}) as any[];\n    console.log(\'=== \' + item.id + \' ===\');\n    for (const p of pages) {\n      const ii = p.imageinfo?.[0];\n      if (!ii) continue;\n      console.log(JSON.stringify({\n        title: p.title,\n        thumbUrl: ii.thumburl || ii.url,\n        sourceUrl: ii.descriptionurl,\n        mime: ii.mime,\n        w: ii.width,\n        h: ii.height,\n        license: ii.extmetadata?.LicenseShortName?.value\n      }));\n    }\n  }\n})();\n\""
