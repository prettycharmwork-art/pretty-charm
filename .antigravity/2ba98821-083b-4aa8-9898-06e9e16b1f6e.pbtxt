      command {
        instruction: "Update AdminDashboard.tsx to use the exact keys from buildProductImageAuditReport (totalExistingProducts, statusBreakdown, integrityVerification, item.auditStatus, item.licenseInfo, v.name) and candidate payload keys (licenseInfo, hasReusePermission, exactProductMatch)."
