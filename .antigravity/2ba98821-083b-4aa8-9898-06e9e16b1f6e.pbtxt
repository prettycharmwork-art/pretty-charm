      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add unit test for sortCatalogueProducts covering Price: Low to High, Price: High to Low, and Newest Arrivals\", \"Instruction\":\"Import sortCatalogueProducts and PRODUCT_SORT_OPTIONS and add test #12\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":27, \"ReplacementContent\":\"  sanitizeSpreadsheetCell,\\n  buildSafeWhatsAppUrl,\\n  sortCatalogueProducts,\\n  PRODUCT_SORT_OPTIONS,\\n  DomainProduct,\\n  DomainVariant,\\n  ServiceablePinCode,\\n} from \'./domainLogic\';\", \"StartLine\":20, \"TargetContent\":\"  sanitizeSpreadsheetCell,\\n  buildSafeWhatsAppUrl,\\n  DomainProduct,\\n  DomainVariant,\\n  ServiceablePinCode,\\n} from \'./domainLogic\';\"}, {\"AllowMultiple\":false, \"EndLine\":295, \"ReplacementContent\":\"  const waUrl = buildSafeWhatsAppUrl(\'+91 9876543210\', \'tracking\', { orderId: \'PC-2026-0001\' });\\n  assert.ok(waUrl.startsWith(\'https://wa.me/919876543210?text=\'));\\n  assert.ok(waUrl.includes(\'PC-2026-0001\'));\\n});\\n\\ntest(\'12. Product listing & Category Page sorting (Price: Low to High, Price: High to Low, Newest Arrivals)\', () => {\\n  const sampleCatalogue = [\\n    {\\n      id: \'prod-1\',\\n      name: \'Rose Gold Pearl Hair Claw\',\\n      sellingPricePaise: 24900,\\n      status: \'active\',\\n      featured: true,\\n      createdAt: \'2026-10-15T10:00:00.000Z\',\\n    },\\n    {\\n      id: \'prod-2\',\\n      name: \'Blush Satin Pearl Bow Barrette\',\\n      sellingPricePaise: 17900,\\n      status: \'active\',\\n      featured: false,\\n      createdAt: \'2026-10-18T10:00:00.000Z\',\\n    },\\n    {\\n      id: \'prod-3\',\\n      name: \'Blush Quartz Layered Necklace\',\\n      sellingPricePaise: 42900,\\n      status: \'active\',\\n      featured: true,\\n      createdAt: \'2026-10-23T10:00:00.000Z\',\\n    },\\n    {\\n      id: \'prod-4\',\\n      name: \'Mulberry Silk Scrunchie Trio\',\\n      sellingPricePaise: 19900,\\n      status: \'active\',\\n      featured: true,\\n      createdAt: \'2026-10-20T10:00:00.000Z\',\\n    },\\n  ];\\n\\n  // Verify required option labels exist\\n  const labels = PRODUCT_SORT_OPTIONS.map((o) => o.label);\\n  assert.ok(labels.includes(\'Price: Low to High\'));\\n  assert.ok(labels.includes(\'Price: High to Low\'));\\n  assert.ok(labels.includes(\'Newest Arrivals\'));\\n\\n  // 1. Price: Low to High\\n  const lowToHigh = sortCatalogueProducts(sampleCatalogue, \'price-asc\');\\n  assert.deepEqual(\\n    lowToHigh.map((p) => p.sellingPricePaise),\\n    [17900, 19900, 24900, 42900]\\n  );\\n\\n  // 2. Price: High to Low\\n  const highToLow = sortCatalogueProducts(sampleCatalogue, \'price-desc\');\\n  assert.deepEqual(\\n    highToLow.map((p) => p.sellingPricePaise),\\n    [42900, 24900, 19900, 17900]\\n  );\\n\\n  // 3. Newest Arrivals (chronological descending by createdAt)\\n  const newest = sortCatalogueProducts(sampleCatalogue, \'newest\');\\n  assert.deepEqual(\\n    newest.map((p) => p.id),\\n    [\'prod-3\', \'prod-4\', \'prod-2\', \'prod-1\']\\n  );\\n\\n  // Ensure original array was not mutated\\n  assert.equal(sampleCatalogue[0].id, \'prod-1\');\\n});\\n\", \"StartLine\":290, \"TargetContent\":\"  const waUrl = buildSafeWhatsAppUrl(\'+91 9876543210\', \'tracking\', { orderId: \'PC-2026-0001\' });\\n  assert.ok(waUrl.startsWith(\'https://wa.me/919876543210?text=\'));\\n  assert.ok(waUrl.includes(\'PC-2026-0001\'));\\n});\"}], \"TargetFile\":\"/src/shared/domainLogic.test.ts\", \"toolAction\":\"Adding sorting unit test to src/shared/domainLogic.test.ts\", \"toolSummary\":\"Add sorting unit test to domainLogic.test.ts\"}"
      original_name: "multi_replace_file_content"
    }
