  code_action {
    action_spec {
      create_file {
        instruction: "# ============================================================================\n# PRETTY CHARM E-COMMERCE PLATFORM \342\200\224 ENVIRONMENT CONFIGURATION (.env.example)\n# Copy this file to .env for local development. Never commit real secrets.\n# ============================================================================\n\n# GEMINI_API_KEY: Required for server-side Gemini AI assistant & studio endpoints.\n# AI Studio automatically injects this at runtime from user secrets.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: Canonical base URL where the application is hosted.\nAPP_URL=\"http://localhost:3000\"\n\n# DATABASE_PATH: Path to persistent SQLite database file.\nDATABASE_PATH=\"./data/pretty_charm.sqlite\"\n\n# SESSION_SECRET: Random secret used for signing admin & customer sessions.\nSESSION_SECRET=\"replace-with-strong-64-char-random-secret-in-production\"\n\n# ADMIN BOOTSTRAP CONFIGURATION:\n# Used to safely create or reset the initial Owner/Admin account without a public open endpoint.\nADMIN_BOOTSTRAP_TOKEN=\"replace-with-one-time-bootstrap-token\"\nADMIN_INITIAL_EMAIL=\"owner@prettycharm.in\"\nADMIN_INITIAL_PASSWORD=\"replace-with-strong-admin-password\"\n\n# PAYMENT CONFIGURATION:\n# Allowed values: \"demo\" | \"manual\" | \"razorpay\"\nPAYMENT_MODE=\"demo\"\nPAYMENT_MANUAL_UPI_ID=\"placeholder-upi@bank\"\nPAYMENT_MANUAL_ACCOUNT_NOTE=\"Owner verification required before marking Paid.\"\nRAZORPAY_KEY_ID=\"\"\nRAZORPAY_KEY_SECRET=\"\"\nRAZORPAY_WEBHOOK_SECRET=\"\"\n\n# SHIPPING & COURIER (SHIPROCKET) CONFIGURATION:\n# Automatic courier sync remains disabled until real credentials are supplied.\nSHIPROCKET_ENABLED=\"false\"\nSHIPROCKET_EMAIL=\"\"\nSHIPROCKET_PASSWORD=\"\"\nSHIPROCKET_WEBHOOK_TOKEN=\"\"\nSHIPPING_ORIGIN_CITY=\"Gurugram\"\nSHIPPING_ORIGIN_STATE=\"Haryana\"\nSHIPPING_ORIGIN_PINCODE=\"122001\"\n\n# WHATSAPP & INSTAGRAM SUPPORT CONFIGURATION:\n# Placeholder support number for Click-to-Chat links until business owner confirms official number.\nSTORE_WHATSAPP_NUMBER=\"919000000000\"\nSTORE_SUPPORT_EMAIL=\"support-placeholder@prettycharm.in\"\nSTORE_INSTAGRAM_HANDLE=\"prettycharm.in\"\n"
        path {
          absolute_uri: "file:///.env.example"
        }
        overwrite: true
      }
    }
