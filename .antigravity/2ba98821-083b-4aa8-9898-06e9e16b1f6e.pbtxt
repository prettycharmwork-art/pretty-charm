912%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Rare_Vintage_Briolette_Drop_Earrings_~_Authentic_Pools_of_Light_~_Natural_Rock_Crystal_Quartz_Gemstone_Earrings_~_Accented_with_Natural_Saltwater_Akoya_Pearls_(7605381912).jpg\",\"mime\":\"image/jpeg\",\"w\":555,\"h\":637,\"license\":\"CC BY 2.0\"}{\"title\":\"File:Woman in an ivory gown, powdered hair, wearing pearl drop earrings.png\",\"thumbUrl\":\"https://upload.wikimedia.org/wikipedia/commons/a/a9/Woman_in_an_ivory_gown%2C_powdered_hair%2C_wearing_pearl_drop_earrings.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Woman_in_an_ivory_gown,_powdered_hair,_wearing_pearl_drop_earrings.png\",\"mime\":\"image/png\",\"w\":426,\"h\":497,\"license\":\"Public domain\"}=== prod-charm-bracelet ==={\"title\":\"File:Juicy Couture charm bracelet close up.jpg\",\"thumbUrl\":\"https://upload.wikimedia.org/wikipedia/commons/3/37/Juicy_Couture_charm_bracelet_close_up.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Juicy_Couture_charm_bracelet_close_up.jpg\",\"mime\":\"image/jpeg\",\"w\":426,\"h\":500,\"license\":\"CC BY 2.0\"}{\"title\":\"File:\320\222\320\270\320\275\321\202\320\260\320\266\320\275\321\213\320\271 \321\207\320\260\321\200\320\274-\320\261\321\200\320\260\321\201\320\273\320\265\321\202.png\",\"thumbUrl\":\"https://upload.wikimedia.org/wikipedia/commons/7/7b/%D0%92%D0%B8%D0%BD%D1%82%D0%B0%D0%B6%D0%BD%D1%8B%D0%B9_%D1%87%D0%B0%D1%80%D0%BC-%D0%B1%D1%80%D0%B0%D1%81%D0%BB%D0%B5%D1%82.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:%D0%92%D0%B8%D0%BD%D1%82%D0%B0%D0%B6%D0%BD%D1%8B%D0%B9_%D1%87%D0%B0%D1%80%D0%BC-%D0%B1%D1%80%D0%B0%D1%81%D0%BB%D0%B5%D1%82.png\",\"mime\":\"image/png\",\"w\":644,\"h\":600,\"license\":\"CC BY-SA 3.0\"}{\"title\":\"File:Charm Bracelet Pavement Plaque.JPG\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Charm_Bracelet_Pavement_Plaque.JPG/960px-Charm_Bracelet_Pavement_Plaque.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Charm_Bracelet_Pavement_Plaque.JPG\",\"mime\":\"image/jpeg\",\"w\":4000,\"h\":3000,\"license\":\"CC BY-SA 3.0\"}{\"title\":\"File:Charm Bracelet made by SF Bay Area Silver Clay Group.jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Charm_Bracelet_made_by_SF_Bay_Area_Silver_Clay_Group.jpg/960px-Charm_Bracelet_made_by_SF_Bay_Area_Silver_Clay_Group.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Charm_Bracelet_made_by_SF_Bay_Area_Silver_Clay_Group.jpg\",\"mime\":\"image/jpeg\",\"w\":3072,\"h\":2304,\"license\":\"CC BY 2.0\"}=== prod-quartz-necklace ==={\"title\":\"File:Rose quartz 3.jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Rose_quartz_3.jpg/960px-Rose_quartz_3.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Rose_quartz_3.jpg\",\"mime\":\"image/jpeg\",\"w\":3434,\"h\":2782,\"license\":\"CC BY 2.0\"}{\"title\":\"File:Rose quartz 4.jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Rose_quartz_4.jpg/960px-Rose_quartz_4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Rose_quartz_4.jpg\",\"mime\":\"image/jpeg\",\"w\":3396,\"h\":2797,\"license\":\"CC BY 2.0\"}{\"title\":\"File:Rose Quartz Beaded Necklace.jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Rose_Quartz_Beaded_Necklace.jpg/960px-Rose_Quartz_Beaded_Necklace.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Rose_Quartz_Beaded_Necklace.jpg\",\"mime\":\"image/jpeg\",\"w\":1000,\"h\":1500,\"license\":\"CC BY-SA 4.0\"}{\"title\":\"File:Rose quartz pendant necklace.jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Rose_quartz_pendant_necklace.jpg/960px-Rose_quartz_pendant_necklace.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Rose_quartz_pendant_necklace.jpg\",\"mime\":\"image/jpeg\",\"w\":2259,\"h\":3456,\"license\":\"CC BY-SA 4.0\"}"
    }
    command_line: "npx --yes tsx -e \"\n(async () => {\n  const queries = [\n    { id: \'prod-pearl-claw\', q: \'hair claw clip filetype:bitmap\' },\n    { id: \'prod-silk-scrunchie-trio\', q: \'scrunchie filetype:bitmap\' },\n    { id: \'prod-satin-bow-barrette\', q: \'hair bow pink filetype:bitmap\' },\n    { id: \'prod-pearl-drop-huggies\', q: \'pearl drop earrings filetype:bitmap\' },\n    { id: \'prod-charm-bracelet\', q: \'charm bracelet filetype:bitmap\' },\n    { id: \'prod-quartz-necklace\', q: \'rose quartz necklace filetype:bitmap\' },\n  ];\n\n  for (const item of queries) {\n    const url = \'https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=\' + encodeURIComponent(item.q) + \'&gsrnamespace=6&gsrlimit=4&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n    const res = await fetch(url, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n    const data = await res.json();\n    const pages = Object.values(data?.query?.pages || {}) as any[];\n    console.log(\'=== \' + item.id + \' ===\');\n    for (const p of pages) {\n      const ii = p.imageinfo?.[0];\n      if (!ii) continue;\n      console.log(JSON.stringify({\n        title: p.title,\n        thumbUrl: ii.thumburl || ii.url,\n        sourceUrl: ii.descriptionurl,\n        mime: ii.mime,\n        w: ii.width,\n        h: ii.height,\n        license: ii.extmetadata?.LicenseShortName?.value\n      }));\n    }\n  }\n})();\n\""
    proposed_command_line: "npx --yes tsx -e \"\n(async () => {\n  const queries = [\n    { id: \'prod-pearl-claw\', q: \'hair claw clip filetype:bitmap\' },\n    { id: \'prod-silk-scrunchie-trio\', q: \'scrunchie filetype:bitmap\' },\n    { id: \'prod-satin-bow-barrette\', q: \'hair bow pink filetype:bitmap\' },\n    { id: \'prod-pearl-drop-huggies\', q: \'pearl drop earrings filetype:bitmap\' },\n    { id: \'prod-charm-bracelet\', q: \'charm bracelet filetype:bitmap\' },\n    { id: \'prod-quartz-necklace\', q: \'rose quartz necklace filetype:bitmap\' },\n  ];\n\n  for (const item of queries) {\n    const url = \'https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=\' + encodeURIComponent(item.q) + \'&gsrnamespace=6&gsrlimit=4&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n    const res = await fetch(url, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n    const data = await res.json();\n    const pages = Object.values(data?.query?.pages || {}) as any[];\n    console.log(\'=== \' + item.id + \' ===\');\n    for (const p of pages) {\n      const ii = p.imageinfo?.[0];\n      if (!ii) continue;\n      console.log(JSON.stringify({\n        title: p.title,\n        thumbUrl: ii.thumburl || ii.url,\n        sourceUrl: ii.descriptionurl,\n        mime: ii.mime,\n        w: ii.width,\n        h: ii.height,\n        license: ii.extmetadata?.LicenseShortName?.value\n      }));\n    }\n  }\n})();\n\""
