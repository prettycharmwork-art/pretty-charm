sible,\n    badgeText,\n    initialClawStatus,\n    initialMiniStatus,\n    stagedMiniStatus,\n    approveBtnVisible,\n    rejectedMiniStatus,\n    finalBadgeText\n  };\n}\" && playwright-cli console error && playwright-cli close"
    proposed_command_line: "playwright-cli open http://localhost:3000 && playwright-cli run-code \"async page => {\n  await page.waitForTimeout(400);\n  await page.getByRole(\'button\', { name: /Admin/i }).first().click();\n  await page.waitForTimeout(300);\n  await page.locator(\'#admin-password\').fill(\'PrettyCharm#2026\');\n  await page.locator(\'button[type=submit]\').click();\n  await page.waitForTimeout(700);\n  await page.getByRole(\'button\', { name: /2\\. Products/i }).click();\n  await page.waitForTimeout(500);\n\n  const reportVisible = await page.getByTestId(\'admin-image-report\').isVisible();\n  const badgeText = await page.getByTestId(\'catalogue-integrity-badge\').innerText();\n  const initialClawStatus = await page.getByTestId(\'image-status-prod-pearl-claw\').innerText();\n  const initialMiniStatus = await page.getByTestId(\'image-status-prod-mini-hamper\').innerText();\n\n  // Stage a valid >=128 byte PNG data URI for prod-mini-hamper\n  await page.getByTestId(\'stage-photo-product-select\').selectOption(\'prod-mini-hamper\');\n  await page.getByTestId(\'stage-photo-url-input\').fill(\'data:image/png;base64,\' + \'A\'.repeat(256));\n  await page.getByTestId(\'stage-photo-source-input\').fill(\'https://prettycharm.in/catalogue/pc-hmp-mini\');\n  await page.getByTestId(\'stage-photo-submit-btn\').click();\n  await page.waitForTimeout(600);\n\n  const stagedMiniStatus = await page.getByTestId(\'image-status-prod-mini-hamper\').innerText();\n  const approveBtnVisible = await page.getByTestId(\'approve-photo-prod-mini-hamper\').isVisible();\n\n  // Reject it so no unapproved image is published and prod-mini-hamper returns to Image Needed\n  await page.getByTestId(\'reject-photo-prod-mini-hamper\').click();\n  await page.waitForTimeout(600);\n\n  const rejectedMiniStatus = await page.getByTestId(\'image-status-prod-mini-hamper\').innerText();\n  const finalBadgeText = await page.getByTestId(\'catalogue-integrity-badge\').innerText();\n\n  return {\n    reportVisible,\n    badgeText,\n    initialClawStatus,\n    initialMiniStatus,\n    stagedMiniStatus,\n    approveBtnVisible,\n    rejectedMiniStatus,\n    finalBadgeText\n  };\n}\" && playwright-cli console error && playwright-cli close"
    shell_name: "bash"
  }
}
