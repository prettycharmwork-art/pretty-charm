    tool_calls {
      id: "call_333073"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport * as THREE from \'three\';\\nimport { OrbitControls } from \'three/addons/controls/OrbitControls.js\';\\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\\nimport { ChevronDown, ChevronUp, RotateCcw, Eye, Box } from \'lucide-react\';\\n\\ninterface ThreeHamperViewerProps {\\n  onClose?: () => void;\\n}\\n\\ntype BoxFinish = \'blush\' | \'champagne\' | \'burgundy\';\\ntype CameraPreset = \'studio\' | \'flatlay\' | \'macro\';\\n\\nexport const ThreeHamperViewer: React.FC<ThreeHamperViewerProps> = ({ onClose }) => {\\n  const canvasMountRef = useRef<HTMLDivElement | null>(null);\\n  const [finish, setFinish] = useState<BoxFinish>(\'blush\');\\n  const [explodedProgress, setExplodedProgress] = useState<number>(0.45);\\n  const [cameraPreset, setCameraPreset] = useState<CameraPreset>(\'studio\');\\n  const [dockCollapsed, setDockCollapsed] = useState<boolean>(false);\\n\\n  // Refs for smooth frame-rate independent updates without tearing down WebGL\\n  const targetExplodedRef = useRef<number>(0.45);\\n  const targetFinishRef = useRef<BoxFinish>(\'blush\');\\n  const targetCameraPosRef = useRef<THREE.Vector3 | null>(new THREE.Vector3(0, 3.2, 5.4));\\n  const targetLookAtRef = useRef<THREE.Vector3>(new THREE.Vector3(0, 0.8, 0));\\n  const triggerRenderRef = useRef<() => void>(() => {});\\n\\n  useEffect(() => {\\n    targetExplodedRef.current = explodedProgress;\\n    triggerRenderRef.current();\\n  }, [explodedProgress]);\\n\\n  useEffect(() => {\\n    targetFinishRef.current = finish;\\n    triggerRenderRef.current();\\n  }, [finish]);\\n\\n  useEffect(() => {\\n    if (cameraPreset === \'studio\') {\\n      targetCameraPosRef.current = new THREE.Vector3(0, 3.2, 5.4);\\n      targetLookAtRef.current.set(0, 0.8, 0);\\n    } else if (cameraPreset === \'flatlay\') {\\n      targetCameraPosRef.current = new THREE.Vector3(0, 6.2, 0.8);\\n      targetLookAtRef.current.set(0, 0.5, 0);\\n    } else if (cameraPreset === \'macro\') {\\n      targetCameraPosRef.current = new THREE.Vector3(1.8, 2.2, 2.7);\\n      targetLookAtRef.current.set(0, 0.85, 0);\\n    }\\n    triggerRenderRef.current();\\n  }, [cameraPreset]);\\n\\n  useEffect(() => {\\n    const container = canvasMountRef.current;\\n    if (!container) return;\\n\\n    // 1. Software-WebGL detection from GPU renderer string\\n    const isSoftwareGl = (() => {\\n      const probeCanvas = document.createElement(\'canvas\');\\n      const gl = probeCanvas.getContext(\'webgl2\');\\n      if (!gl) return true;\\n      const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\\n      const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\\n      const gpu = String(gl.getParameter(param));\\n      gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\\n      return /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\\n    })();\\n\\n    const width = container.clientWidth || window.innerWidth;\\n    const height = container.clientHeight || window.innerHeight;\\n\\n    const renderer = new THREE.WebGLRenderer({\\n      antialias: !isSoftwareGl,\\n      powerPreference: \'high-performance\',\\n    });\\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\\n    renderer.toneMappingExposure = 1.1;\\n    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2));\\n    renderer.setSize(width, height);\\n    renderer.shadowMap.enabled = !isSoftwareGl;\\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\\n\\n    container.innerHTML = \'\';\\n    container.appendChild(renderer.domElement);\\n\\n    const scene = new THREE.Scene();\\n    const bgHex = 0xfdf4f6;\\n    scene.background = new THREE.Color(bgHex);\\n    scene.fog = new THREE.FogExp2(bgHex, 0.045);\\n\\n    // 2. Studio PBR Environment Reflections (RoomEnvironment)\\n    const pmremGenerator = new THREE.PMREMGenerator(renderer);\\n    scene.environment = pmremGenerator.fromScene(new RoomEnvironment(), 0.04).texture;\\n    pmremGenerator.dispose();\\n\\n    const camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 60);\\n    camera.position.set(0, 3.2, 5.4);\\n\\n    const controls = new OrbitControls(camera, renderer.domElement);\\n    controls.enableDamping = !isSoftwareGl;\\n    controls.dampingFactor = 0.06;\\n    controls.maxPolarAngle = Math.PI / 2 - 0.04;\\n    controls.minDistance = 2.2;\\n    controls.maxDistance = 10;\\n    controls.target.set(0, 0.8, 0);\\n\\n    // 3. Balanced 3-Point Studio Lighting Rig (Warm Key + Cool Hemisphere Fill + Rim)\\n    const hemiLight = new THREE.HemisphereLight(0xfff5f7, 0xd8c3c8, 0.85);\\n    scene.add(hemiLight);\\n\\n    const keyLight = new THREE.DirectionalLight(0xfff0e5, 1.8);\\n    keyLight.position.set(4.5, 7.5, 4.0);\\n    if (!isSoftwareGl) {\\n      keyLight.castShadow = true;\\n      keyLight.shadow.mapSize.set(1024, 1024);\\n      keyLight.shadow.camera.left = -4;\\n      keyLight.shadow.camera.right = 4;\\n      keyLight.shadow.camera.top = 4;\\n      keyLight.shadow.camera.bottom = -4;\\n      keyLight.shadow.bias = -0.0005;\\n      keyLight.shadow.normalBias = 0.02;\\n    }\\n    scene.add(keyLight);\\n\\n    const rimLight = new THREE.DirectionalLight(0xf7dce2, 0.9);\\n    rimLight.position.set(-4.0, 4.5, -3.5);\\n    scene.add(rimLight);\\n\\n    // Procedural CanvasTexture for Travertine Stone Micro-Relief\\n    const stoneCanvas = document.createElement(\'canvas\');\\n    stoneCanvas.width = 256;\\n    stoneCanvas.height = 256;\\n    const ctx = stoneCanvas.getContext(\'2d\')!;\\n    ctx.fillStyle = \'#f5eee8\';\\n    ctx.fillRect(0, 0, 256, 256);\\n    for (let i = 0; i < 600; i++) {\\n      ctx.fillStyle = i % 2 === 0 ? \'rgba(210,195,185,0.22)\' : \'rgba(255,255,255,0.25)\';\\n      ctx.fillRect((i * 37) % 256, (i * 73) % 256, 12, 3);\\n    }\\n    const stoneTex = new THREE.CanvasTexture(stoneCanvas);\\n    stoneTex.colorSpace = THREE.SRGBColorSpace;\\n    stoneTex.wrapS = THREE.RepeatWrapping;\\n    stoneTex.wrapT = THREE.RepeatWrapping;\\n    stoneTex.repeat.set(3, 3);\\n    stoneTex.anisotropy = renderer.capabilities.getMaxAnisotropy();\\n\\n    // 4. Composite 10-Part Procedural 3D Subject (THREE.Group)\\n    const hamperGroup = new THREE.Group();\\n    scene.add(hamperGroup);\\n\\n    // Part 1: Travertine Studio Pedestal Base (flush at y=0)\\n    const pedestalGeo = new THREE.CylinderGeometry(2.6, 2.75, 0.24, 48);\\n    const pedestalMat = new THREE.MeshStandardMaterial({\\n      color: 0xffffff,\\n      map: stoneTex,\\n      roughness: 0.78,\\n      metalness: 0.05,\\n    });\\n    const pedestal = new THREE.Mesh(pedestalGeo, pedestalMat);\\n    pedestal.position.y = 0.12;\\n    pedestal.receiveShadow = true;\\n    hamperGroup.add(pedestal);\\n\\n    // Part 2: Soft Radial Contact Shadow Disc (offset >= 0.02 on Y to avoid Z-fighting)\\n    const shadowCanvas = document.createElement(\'canvas\');\\n    shadowCanvas.width = 128;\\n    shadowCanvas.height = 128;\\n    const sctx = shadowCanvas.getContext(\'2d\')!;\\n    const grad = sctx.createRadialGradient(64, 64, 10, 64, 64, 60);\\n    grad.addColorStop(0, \'rgba(90, 45, 55, 0.45)\');\\n    grad.addColorStop(1, \'rgba(90, 45, 55, 0)\');\\n    sctx.fillStyle = grad;\\n    sctx.fillRect(0, 0, 128, 128);\\n    const shadowTex = new THREE.CanvasTexture(shadowCanvas);\\n    shadowTex.colorSpace = THREE.SRGBColorSpace;\\n\\n    const contactShadow = new THREE.Mesh(\\n      new THREE.CircleGeometry(1.85, 32),\\n      new THREE.MeshBasicMaterial({\\n        map: shadowTex,\\n        transparent: true,\\n        depthWrite: false,\\n        opacity: 0.85,\\n      })\\n    );\\n    contactShadow.rotation.x = -Math.PI / 2;\\n    contactShadow.position.y = 0.255;\\n    hamperGroup.add(contactShadow);\\n\\n    // Shared PBR Materials with varied roughness (>= 0.25 difference across adjacent parts)\\n    const boxOuterMat = new THREE.MeshPhysicalMaterial({\\n      color: 0xf7dce2,\\n      roughness: 0.58,\\n      metalness: 0.08,\\n      clearcoat: 0.2,\\n    });\\n    const roseGoldMat = new THREE.MeshPhysicalMaterial({\\n      color: 0xd48b95,\\n      roughness: 0.18,\\n      metalness: 0.92,\\n      clearcoat: 0.5,\\n    });\\n    const pearlMat = new THREE.MeshPhysicalMaterial({\\n      color: 0xfffaf5,\\n      roughness: 0.12,\\n      metalness: 0.15,\\n      clearcoat: 0.9,\\n      iridescence: 0.4,\\n    });\\n    const velvetMat = new THREE.MeshStandardMaterial({\\n      color: 0xfff8f6,\\n      roughness: 0.88,\\n      metalness: 0.0,\\n    });\\n\\n    // Part 3: Keepsake Box Lower Hull (Beveled Extrude)\\n    const boxShape = new THREE.Shape();\\n    const w = 1.15;\\n    const d = 0.9;\\n    boxShape.moveTo(-w, -d);\\n    boxShape.lineTo(w, -d);\\n    boxShape.lineTo(w, d);\\n    boxShape.lineTo(-w, d);\\n    boxShape.closePath();\\n\\n    const hullGeo = new THREE.ExtrudeGeometry(boxShape, {\\n      depth: 0.72,\\n      bevelEnabled: true,\\n      bevelSegments: 3,\\n      steps: 1,\\n      bevelSize: 0.04,\\n      bevelThickness: 0.04,\\n    });\\n    hullGeo.rotateX(Math.PI / 2);\\n    const boxHull = new THREE.Mesh(hullGeo, boxOuterMat);\\n    boxHull.position.y = 0.98;\\n    boxHull.castShadow = true;\\n    boxHull.receiveShadow = true;\\n    hamperGroup.add(boxHull);\\n\\n    // Part 4: Velvet Interior Cushion Insert\\n    const cushion = new THREE.Mesh(new THREE.BoxGeometry(2.12, 0.16, 1.62), velvetMat);\\n    cushion.position.y = 0.92;\\n    hamperGroup.add(cushion);\\n\\n    // Part 5: Rose-Gold Trim Band around Box Base\\n    const trimBand = new THREE.Mesh(new THREE.BoxGeometry(2.4, 0.07, 1.9), roseGoldMat);\\n    trimBand.position.y = 0.65;\\n    hamperGroup.add(trimBand);\\n\\n    // Part 6: Interior Gift Item 1 \342\200\224 Rose Gold Pearl Hair Claw (Arch + Pearls)\\n    const clawGroup = new THREE.Group();\\n    clawGroup.position.set(-0.52, 1.05, 0.12);\\n    const clawArch = new THREE.Mesh(\\n      new THREE.TorusGeometry(0.32, 0.035, 16, 32, Math.PI),\\n      roseGoldMat\\n    );\\n    clawGroup.add(clawArch);\\n    for (let i = 0; i < 5; i++) {\\n      const angle = (Math.PI / 6) * (i + 1);\\n      const pearl = new THREE.Mesh(new THREE.SphereGeometry(0.052, 16, 16), pearlMat);\\n      pearl.position.set(Math.cos(angle) * 0.34, Math.sin(angle) * 0.34, 0);\\n      clawGroup.add(pearl);\\n    }\\n    hamperGroup.add(clawGroup);\\n\\n    // Part 7: Interior Gift Item 2 \342\200\224 Mulberry Silk Scrunchie\\n    const scrunchieMat = new THREE.MeshPhysicalMaterial({\\n      color: 0xe69ca8,\\n      roughness: 0.35,\\n      metalness: 0.05,\\n      sheen: 1.0,\\n      sheenColor: new THREE.Color(0xfff0f3),\\n    });\\n    const scrunchie = new THREE.Mesh(new THREE.TorusGeometry(0.28, 0.11, 20, 36), scrunchieMat);\\n    scrunchie.rotation.x = Math.PI / 2;\\n    scrunchie.position.set(0.52, 1.08, 0.25);\\n    hamperGroup.add(scrunchie);\\n\\n    // Part 8: Interior Gift Item 3 \342\200\224 Pair of 18k Rose Gold Pearl Drop Earrings\\n    const earringsGroup = new THREE.Group();\\n    earringsGroup.position.set(0.45, 1.06, -0.35);\\n    for (const offsetX of [-0.18, 0.18]) {\\n      const hoop = new THREE.Mesh(new THREE.TorusGeometry(0.09, 0.018, 12, 24), roseGoldMat);\\n      hoop.position.set(offsetX, 0.1, 0);\\n      const dropPearl = new THREE.Mesh(new THREE.SphereGeometry(0.065, 16, 16), pearlMat);\\n      dropPearl.position.set(offsetX, -0.02, 0.05);\\n      earringsGroup.add(hoop, dropPearl);\\n    }\\n    hamperGroup.add(earringsGroup);\\n\\n    // Part 9 & 10: Detachable Box Lid + Sculpted Satin Rose-Gold Ribbon Bow\\n    const lidGroup = new THREE.Group();\\n    lidGroup.position.y = 1.12;\\n    hamperGroup.add(lidGroup);\\n\\n    const lidGeo = new THREE.ExtrudeGeometry(boxShape, {\\n      depth: 0.18,\\n      bevelEnabled: true,\\n      bevelSegments: 3,\\n      steps: 1,\\n      bevelSize: 0.06,\\n      bevelThickness: 0.03,\\n    });\\n    lidGeo.rotateX(Math.PI / 2);\\n    const lidMesh = new THREE.Mesh(lidGeo, boxOuterMat);\\n    lidMesh.castShadow = true;\\n    lidGroup.add(lidMesh);\\n\\n    const ribbonX = new THREE.Mesh(new THREE.BoxGeometry(2.44, 0.21, 0.24), roseGoldMat);\\n    ribbonX.position.y = -0.08;\\n    const ribbonZ = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.21, 1.94), roseGoldMat);\\n    ribbonZ.position.y = -0.08;\\n    lidGroup.add(ribbonX, ribbonZ);\\n\\n    const bowKnot = new THREE.Mesh(new THREE.TorusKnotGeometry(0.18, 0.048, 48, 12, 2, 3), roseGoldMat);\\n    bowKnot.position.y = 0.12;\\n    bowKnot.scale.set(1.2, 0.55, 1.2);\\n    lidGroup.add(bowKnot);\\n\\n    // Pre-warm shaders on hardware GPUs\\n    if (!isSoftwareGl) {\\n      renderer.compile(scene, camera);\\n    }\\n\\n    // 5. On-Demand & Software-WebGL Paced Render Loop\\n    let frameId = 0;\\n    let renderBusy = false;\\n    let renderDirty = false;\\n    let currentExploded = targetExplodedRef.current;\\n\\n    const finishColors: Record<BoxFinish, number> = {\\n      blush: 0xf7dce2,\\n      champagne: 0xfaf0e4,\\n      burgundy: 0x592531,\\n    };\\n\\n    function afterDraw(cb: () => void) {\\n      const gl = renderer.getContext() as WebGL2RenderingContext;\\n      const sync = gl.fenceSync ? gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0) : null;\\n      gl.flush();\\n      const poll = () => {\\n        const state = sync && gl.getSyncParameter(sync, gl.SYNC_STATUS);\\n        if (state === gl.UNSIGNALED) {\\n          frameId = window.setTimeout(poll, 5);\\n        } else {\\n          if (sync) gl.deleteSync(sync);\\n          frameId = window.setTimeout(cb, 80);\\n        }\\n      };\\n      frameId = window.setTimeout(poll, 5);\\n    }\\n\\n    function requestRender() {\\n      if (renderBusy) {\\n        renderDirty = true;\\n        return;\\n      }\\n      renderBusy = true;\\n      frameId = requestAnimationFrame(() => {\\n        renderDirty = false;\\n\\n        // Smooth damping of exploded lid height & rotation\\n        const dt = 0.032;\\n        const diff = Math.abs(currentExploded - targetExplodedRef.current);\\n        currentExploded = THREE.MathUtils.damp(\\n          currentExploded,\\n          targetExplodedRef.current,\\n          8,\\n          dt\\n        );\\n        lidGroup.position.y = 1.06 + currentExploded * 1.15;\\n        lidGroup.position.z = -currentExploded * 0.45;\\n        lidGroup.rotation.x = -currentExploded * 0.35;\\n        clawGroup.position.y = 1.05 + currentExploded * 0.22;\\n        scrunchie.position.y = 1.08 + currentExploded * 0.18;\\n        earringsGroup.position.y = 1.06 + currentExploded * 0.25;\\n\\n        // Smooth finish tint update\\n        boxOuterMat.color.setHex(finishColors[targetFinishRef.current]);\\n\\n        // Smooth camera preset transition if active\\n        if (targetCameraPosRef.current) {\\n          camera.position.lerp(targetCameraPosRef.current, 0.18);\\n          controls.target.lerp(targetLookAtRef.current, 0.18);\\n          if (camera.position.distanceTo(targetCameraPosRef.current) < 0.03) {\\n            targetCameraPosRef.current = null;\\n          } else {\\n            renderDirty = true;\\n          }\\n        }\\n\\n        if (diff > 0.005) {\\n          renderDirty = true;\\n        }\\n\\n        controls.update();\\n        renderer.render(scene, camera);\\n\\n        const done = () => {\\n          renderBusy = false;\\n          if (renderDirty) requestRender();\\n        };\\n        if (isSoftwareGl) afterDraw(done);\\n        else done();\\n      });\\n    }\\n\\n    triggerRenderRef.current = requestRender;\\n\\n    const onControlStart = () => {\\n      targetCameraPosRef.current = null;\\n    };\\n    const onControlChange = () => {\\n      requestRender();\\n    };\\n    controls.addEventListener(\'start\', onControlStart);\\n    controls.addEventListener(\'change\', onControlChange);\\n\\n    const onResize = () => {\\n      if (!container) return;\\n      const wNew = container.clientWidth || window.innerWidth;\\n      const hNew = container.clientHeight || window.innerHeight;\\n      camera.aspect = wNew / hNew;\\n      camera.updateProjectionMatrix();\\n      renderer.setSize(wNew, hNew);\\n      requestRender();\\n    };\\n    window.addEventListener(\'resize\', onResize);\\n\\n    requestRender();\\n\\n    return () => {\\n      cancelAnimationFrame(frameId);\\n      clearTimeout(frameId);\\n      window.removeEventListener(\'resize\', onResize);\\n      controls.removeEventListener(\'start\', onControlStart);\\n      controls.removeEventListener(\'change\', onControlChange);\\n      controls.dispose();\\n      renderer.dispose();\\n    };\\n  }, []);\\n\\n  return (\\n    <div\\n      className=\\\"relative w-full h-[540px] sm:h-[620px] rounded-2xl overflow-hidden border border-[#e4b7c0] bg-[#fdf4f6]\\\"\\n      data-testid=\\\"three-hamper-studio\\\"\\n    >\\n      {/* Top-Left Minimal Spec Badge */}\\n      <div className=\\\"absolute top-4 left-4 z-10 flex items-center gap-3 px-3.5 py-2 rounded-xl bg-[#fffdfb]/95 border border-[#e4b7c0] shadow-sm\\\">\\n        <Box className=\\\"w-4 h-4 text-[#9e5461]\\\" />\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-[#2d1e22]\\\">\\n            Pretty Charm 3D Keepsake Hamper &amp; Jewellery Studio\\n          </p>\\n          <p className=\\\"text-[11px] text-[#6e5259]\\\">\\n            Drag to rotate 360\302\260 \302\267 Inspect Pearl Hair Claw, Silk Scrunchie &amp; Rose Gold Earrings\\n          </p>\\n        </div>\\n      </div>\\n\\n      {onClose && (\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onClose}\\n          className=\\\"absolute top-4 right-4 z-10 px-3 py-1.5 rounded-xl bg-[#2d1e22] text-white text-xs font-medium hover:bg-[#452f35] transition-colors\\\"\\n        >\\n          Back to Store\\n        </button>\\n      )}\\n\\n      {/* Isolated WebGL Canvas Mount Container */}\\n      <div ref={canvasMountRef} className=\\\"w-full h-full\\\" />\\n\\n      {/* Unified Collapsible Bottom Control Dock (<= 15% viewport footprint, solid rgba surface) */}\\n      <div\\n        className=\\\"absolute bottom-4 left-1/2 -translate-x-1/2 z-10 w-[94%] max-w-3xl transition-transform duration-200\\\"\\n        style={{\\n          transform: dockCollapsed ? \'translate(-50%, calc(100% - 34px))\' : \'translate(-50%, 0)\',\\n        }}\\n      >\\n        <div className=\\\"flex justify-center\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setDockCollapsed((c) => !c)}\\n            className=\\\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-t-xl bg-[#2d1e22] text-white text-xs font-medium\\\"\\n          >\\n            {dockCollapsed ? (\\n              <>\\n                <ChevronUp className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Show 3D Controls</span>\\n              </>\\n            ) : (\\n              <>\\n                <ChevronDown className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Hide Controls</span>\\n              </>\\n            )}\\n          </button>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl bg-[#fffdfb] border border-[#e4b7c0] px-4 py-3 shadow-lg flex flex-wrap items-center justify-between gap-4\\\">\\n          {/* Box Finish Swatches */}\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-[#5c4349]\\\">Box Finish:</span>\\n            {(\\n              [\\n                { id: \'blush\', label: \'Blush Rose\', hex: \'#f7dce2\' },\\n                { id: \'champagne\', label: \'Champagne Cream\', hex: \'#faf0e4\' },\\n                { id: \'burgundy\', label: \'Velvet Wine\', hex: \'#592531\' },\\n              ] as const\\n            ).map((sw) => (\\n              <button\\n                key={sw.id}\\n                type=\\\"button\\\"\\n                onClick={() => setFinish(sw.id)}\\n                className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium border transition-colors whitespace-nowrap shrink-0 ${\\n                  finish === sw.id\\n                    ? \'border-[#9e5461] bg-[#fce9ee] text-[#2d1e22]\'\\n                    : \'border-[#e8d5d9] bg-white text-[#6e5259] hover:text-[#2d1e22]\'\\n                }`}\\n              >\\n                <span\\n                  className=\\\"w-3 h-3 rounded-full border border-black/15\\\"\\n                  style={{ backgroundColor: sw.hex }}\\n                />\\n                <span>{sw.label}</span>\\n              </button>\\n            ))}\\n          </div>\\n\\n          {/* Exploded Lid Slider */}\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <label htmlFor=\\\"lid-open-slider\\\" className=\\\"text-xs font-medium text-[#5c4349] whitespace-nowrap\\\">\\n              Open Box Reveal:\\n            </label>\\n            <input\\n              id=\\\"lid-open-slider\\\"\\n              type=\\\"range\\\"\\n              min=\\\"0\\\"\\n              max=\\\"1\\\"\\n              step=\\\"0.05\\\"\\n              value={explodedProgress}\\n              onChange={(e) => setExplodedProgress(parseFloat(e.target.value))}\\n              className=\\\"w-24 accent-[#9e5461]\\\"\\n            />\\n          </div>\\n\\n          {/* Camera Angles */}\\n          <div className=\\\"flex items-center gap-1.5\\\">\\n            <Eye className=\\\"w-3.5 h-3.5 text-[#9e5461]\\\" />\\n            {(\\n              [\\n                { id: \'studio\', label: \'Studio\' },\\n                { id: \'flatlay\', label: \'Flatlay\' },\\n                { id: \'macro\', label: \'Jewellery Close-Up\' },\\n              ] as const\\n            ).map((cam) => (\\n              <button\\n                key={cam.id}\\n                type=\\\"button\\\"\\n                onClick={() => setCameraPreset(cam.id)}\\n                className={`px-2.5 py-1 rounded-lg text-xs font-medium transition-colors whitespace-nowrap shrink-0 ${\\n                  cameraPreset === cam.id\\n                    ? \'bg-[#9e5461] text-white\'\\n                    : \'bg-[#fdf2f4] text-[#7a3b47] hover:bg-[#fce9ee]\'\\n                }`}\\n              >\\n                {cam.label}\\n              </button>\\n            ))}\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setCameraPreset(\'studio\');\\n                setExplodedProgress(0.45);\\n                setFinish(\'blush\');\\n              }}\\n              className=\\\"p-1.5 rounded-lg bg-[#fdf2f4] text-[#7a3b47] hover:bg-[#fce9ee]\\\"\\n              aria-label=\\\"Reset 3D camera\\\"\\n            >\\n              <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ThreeHamperViewer 3D interactive hamper and jewellery visualizer with software-WebGL pacing, RoomEnvironment, and collapsible bottom dock\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ThreeHamperViewer.tsx\", \"toolAction\":\"Creating ThreeHamperViewer.tsx 3D component\", \"toolSummary\":\"Create src/components/ThreeHamperViewer.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_333465"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  MessageSquare,\\n  Image as ImageIcon,\\n  Film,\\n  Search,\\n  MapPin,\\n  Send,\\n  Upload,\\n  X,\\n  Loader2,\\n} from \'lucide-react\';\\n\\ninterface GeminiStudioModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n}\\n\\nexport const GeminiStudioModal: React.FC<GeminiStudioModalProps> = ({ isOpen, onClose }) => {\\n  const [activeTab, setActiveTab] = useState<\'chat\' | \'image\' | \'video\' | \'grounding\'>(\'chat\');\\n\\n  // 1. Multi-Turn Chat State\\n  const [chatModel, setChatModel] = useState<\'standard\' | \'complex\' | \'fast\'>(\'standard\');\\n  const [messages, setMessages] = useState<Array<{ role: \'user\' | \'model\'; text: string }>>([\\n    {\\n      role: \'model\',\\n      text: \'Hello! I am your Pretty Charm Styling & Gifting Concierge. Ask me for hair claw or rose-gold jewellery gift ideas under \342\202\271500, or shipping rules from Gurugram!\',\\n    },\\n  ]);\\n  const [chatInput, setChatInput] = useState(\'\');\\n  const [chatLoading, setChatLoading] = useState(false);\\n\\n  // 2. Image Generation & Editing State\\n  const [imagePrompt, setImagePrompt] = useState(\\n    \'Luxury blush pink gift box with rose gold ribbon, pearl hair claw clip, and silk scrunchies on cream travertine stone\'\\n  );\\n  const [imageSize, setImageSize] = useState<\'1K\' | \'2K\' | \'4K\'>(\'1K\');\\n  const [aspectRatio, setAspectRatio] = useState<\'1:1\' | \'4:3\' | \'16:9\'>(\'1:1\');\\n  const [useProPreview, setUseProPreview] = useState<boolean>(false);\\n  const [uploadedImageBase64, setUploadedImageBase64] = useState<string | null>(null);\\n  const [generatedImageUrl, setGeneratedImageUrl] = useState<string | null>(null);\\n  const [imageLoading, setImageLoading] = useState(false);\\n  const [imageError, setImageError] = useState<string | null>(null);\\n\\n  // 3. Video Generation & Photo Animation State (gemini-omni-1.1-flash via Interactions API)\\n  const [videoPrompt, setVideoPrompt] = useState(\\n    \'Soft morning sunlight shimmering across a blush pink gift hamper with rose gold pearls in slow motion\'\\n  );\\n  const [videoAspectRatio, setVideoAspectRatio] = useState<\'16:9\' | \'9:16\'>(\'16:9\');\\n  const [videoResultUrl, setVideoResultUrl] = useState<string | null>(null);\\n  const [videoLoading, setVideoLoading] = useState(false);\\n  const [videoError, setVideoError] = useState<string | null>(null);\\n\\n  // 4. Search & Maps Grounding State\\n  const [groundingType, setGroundingType] = useState<\'search\' | \'maps\'>(\'search\');\\n  const [groundingQuery, setGroundingQuery] = useState(\\n    \'Latest bridal and bridesmaid hair accessory gifting trends in India\'\\n  );\\n  const [groundingResult, setGroundingResult] = useState<string>(\'\');\\n  const [groundingChunks, setGroundingChunks] = useState<any[]>([]);\\n  const [groundingLoading, setGroundingLoading] = useState(false);\\n\\n  if (!isOpen) return null;\\n\\n  const handleSendChat = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!chatInput.trim() || chatLoading) return;\\n    const nextMessages = [...messages, { role: \'user\' as const, text: chatInput.trim() }];\\n    setMessages(nextMessages);\\n    setChatInput(\'\');\\n    setChatLoading(true);\\n    try {\\n      const res = await fetch(\'/api/ai/chat\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ messages: nextMessages, modelMode: chatModel }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Chat request failed\');\\n      setMessages([...nextMessages, { role: \'model\', text: data.text }]);\\n    } catch (err: any) {\\n      setMessages([\\n        ...nextMessages,\\n        { role: \'model\', text: `Error: ${err.message || \'Unable to reach Gemini API.\'}` },\\n      ]);\\n    } finally {\\n      setChatLoading(false);\\n    }\\n  };\\n\\n  const handlePhotoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    const reader = new FileReader();\\n    reader.onload = () => {\\n      setUploadedImageBase64(String(reader.result));\\n    };\\n    reader.readAsDataURL(file);\\n  };\\n\\n  const handleGenerateOrEditImage = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setImageLoading(true);\\n    setImageError(null);\\n    try {\\n      const res = await fetch(\'/api/ai/image\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          prompt: imagePrompt,\\n          imageSize,\\n          aspectRatio,\\n          base64Image: uploadedImageBase64,\\n          useProPreview,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Image generation failed\');\\n      setGeneratedImageUrl(data.imageUrl);\\n    } catch (err: any) {\\n      setImageError(err.message);\\n    } finally {\\n      setImageLoading(false);\\n    }\\n  };\\n\\n  const handleGenerateVideo = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setVideoLoading(true);\\n    setVideoError(null);\\n    try {\\n      const res = await fetch(\'/api/ai/video\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          prompt: videoPrompt,\\n          aspectRatio: videoAspectRatio,\\n          base64Image: uploadedImageBase64,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Video generation failed\');\\n      setVideoResultUrl(data.videoUrl);\\n    } catch (err: any) {\\n      setVideoError(err.message);\\n    } finally {\\n      setVideoLoading(false);\\n    }\\n  };\\n\\n  const handleRunGrounding = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setGroundingLoading(true);\\n    try {\\n      const res = await fetch(\'/api/ai/grounding\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          query: groundingQuery,\\n          groundingType,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Grounding request failed\');\\n      setGroundingResult(data.text);\\n      setGroundingChunks(data.groundingChunks || []);\\n    } catch (err: any) {\\n      setGroundingResult(`Error: ${err.message}`);\\n    } finally {\\n      setGroundingLoading(false);\\n    }\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 overflow-y-auto\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"gemini-studio-title\\\"\\n    >\\n      <div className=\\\"w-full max-w-3xl rounded-2xl bg-[#fffdfb] border border-[#e4b7c0] shadow-2xl overflow-hidden\\\">\\n        {/* Header */}\\n        <div className=\\\"flex items-center justify-between px-6 py-4 bg-[#fdf2f4] border-b border-[#e4b7c0]\\\">\\n          <div>\\n            <h2 id=\\\"gemini-studio-title\\\" className=\\\"text-2xl font-bold text-[#2d1e22]\\\">\\n              Pretty Charm Gift Concierge &amp; Creative Studio\\n            </h2>\\n            <p className=\\\"text-xs text-[#6e5259]\\\">\\n              Multi-turn styling assistant, high-resolution hamper visualizer (1K/2K/4K), video animator &amp; live search/maps grounding\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"p-2 rounded-xl text-[#7a3b47] hover:bg-[#fce9ee]\\\"\\n            aria-label=\\\"Close Creative Studio\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Navigation Tabs */}\\n        <div className=\\\"flex items-center gap-2 px-6 py-3 bg-[#fff8fa] border-b border-[#f0d8de] overflow-x-auto\\\">\\n          {(\\n            [\\n              { id: \'chat\', label: \'Styling Chatbot\', icon: MessageSquare },\\n              { id: \'image\', label: \'Create & Edit Images (1K\342\200\2234K)\', icon: ImageIcon },\\n              { id: \'video\', label: \'Animate & Video (16:9 / 9:16)\', icon: Film },\\n              { id: \'grounding\', label: \'Search & Maps Grounding\', icon: Search },\\n            ] as const\\n          ).map((t) => {\\n            const Icon = t.icon;\\n            return (\\n              <button\\n                key={t.id}\\n                type=\\\"button\\\"\\n                onClick={() => setActiveTab(t.id)}\\n                className={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap shrink-0 ${\\n                  activeTab === t.id\\n                    ? \'bg-[#9e5461] text-white\'\\n                    : \'bg-white text-[#6e5259] border border-[#e4b7c0] hover:text-[#2d1e22]\'\\n                }`}\\n              >\\n                <Icon className=\\\"w-3.5 h-3.5\\\" />\\n                <span>{t.label}</span>\\n              </button>\\n            );\\n          })}\\n        </div>\\n\\n        {/* Body Content */}\\n        <div className=\\\"p-6 max-h-[72vh] overflow-y-auto\\\">\\n          {activeTab === \'chat\' && (\\n            <div className=\\\"space-y-4\\\">\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-2 bg-[#fdf2f4] p-3 rounded-xl border border-[#e4b7c0]\\\">\\n                <span className=\\\"text-xs font-medium text-[#5c4349]\\\">Select Gemini Reasoning Mode:</span>\\n                <div className=\\\"flex items-center gap-1.5\\\">\\n                  {(\\n                    [\\n                      { id: \'fast\', label: \'Fast (Flash Lite)\' },\\n                      { id: \'standard\', label: \'Balanced (3.8 Flash)\' },\\n                      { id: \'complex\', label: \'Deep Styling (4 Argon)\' },\\n                    ] as const\\n                  ).map((m) => (\\n                    <button\\n                      key={m.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => setChatModel(m.id)}\\n                      className={`px-2.5 py-1 rounded-lg text-xs font-medium transition-colors whitespace-nowrap shrink-0 ${\\n                        chatModel === m.id\\n                          ? \'bg-[#2d1e22] text-white\'\\n                          : \'bg-white text-[#6e5259] border border-[#e4b7c0]\'\\n                      }`}\\n                    >\\n                      {m.label}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"h-64 overflow-y-auto rounded-xl border border-[#e8d5d9] bg-white p-4 space-y-3\\\">\\n                {messages.map((m, idx) => (\\n                  <div\\n                    key={idx}\\n                    className={`flex ${m.role === \'user\' ? \'justify-end\' : \'justify-start\'}`}\\n                  >\\n                    <div\\n                      className={`max-w-[82%] rounded-2xl px-4 py-2.5 text-sm leading-relaxed ${\\n                        m.role === \'user\'\\n                          ? \'bg-[#9e5461] text-white\'\\n                          : \'bg-[#fdf2f4] text-[#2d1e22] border border-[#e4b7c0]\'\\n                      }`}\\n                    >\\n                      {m.text}\\n                    </div>\\n                  </div>\\n                ))}\\n                {chatLoading && (\\n                  <div className=\\\"flex items-center gap-2 text-xs text-[#7a3b47]\\\">\\n                    <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />\\n                    <span>Pretty Charm Concierge is thinking...</span>\\n                  </div>\\n                )}\\n              </div>\\n\\n              <form onSubmit={handleSendChat} className=\\\"flex gap-2\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  value={chatInput}\\n                  onChange={(e) => setChatInput(e.target.value)}\\n                  placeholder=\\\"Ask for gift hamper advice, hair accessory styling, or Gurugram shipping...\\\"\\n                  aria-label=\\\"Chat message\\\"\\n                  className=\\\"flex-1 rounded-xl border border-[#e4b7c0] bg-white px-4 py-2.5 text-sm focus:outline-none focus:border-[#9e5461]\\\"\\n                />\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={chatLoading}\\n                  className=\\\"inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-[#9e5461] text-white text-sm font-medium hover:bg-[#83424e] disabled:opacity-50\\\"\\n                >\\n                  <Send className=\\\"w-4 h-4\\\" />\\n                  <span>Send</span>\\n                </button>\\n              </form>\\n            </div>\\n          )}\\n\\n          {activeTab === \'image\' && (\\n            <form onSubmit={handleGenerateOrEditImage} className=\\\"space-y-4\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#5c4349] mb-1\\\">\\n                  Image Prompt (Create or Edit Gift Concept)\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  value={imagePrompt}\\n                  onChange={(e) => setImagePrompt(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-[#e4b7c0] bg-white p-3 text-sm\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-[#5c4349] mb-1\\\">\\n                    Resolution Size\\n                  </label>\\n                  <div className=\\\"flex gap-1.5\\\">\\n                    {([\'1K\', \'2K\', \'4K\'] as const).map((sz) => (\\n                      <button\\n                        key={sz}\\n                        type=\\\"button\\\"\\n                        onClick={() => setImageSize(sz)}\\n                        className={`flex-1 py-1.5 rounded-lg text-xs font-semibold border ${\\n                          imageSize === sz\\n                            ? \'bg-[#9e5461] text-white border-[#9e5461]\'\\n                            : \'bg-white text-[#5c4349] border-[#e4b7c0]\'\\n                        }`}\\n                      >\\n                        {sz}\\n                      </button>\\n                    ))}\\n                  </div>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-[#5c4349] mb-1\\\">\\n                    Aspect Ratio\\n                  </label>\\n                  <div className=\\\"flex gap-1.5\\\">\\n                    {([\'1:1\', \'4:3\', \'16:9\'] as const).map((ar) => (\\n                      <button\\n                        key={ar}\\n                        type=\\\"button\\\"\\n                        onClick={() => setAspectRatio(ar)}\\n                        className={`flex-1 py-1.5 rounded-lg text-xs font-semibold border ${\\n                          aspectRatio === ar\\n                            ? \'bg-[#9e5461] text-white border-[#9e5461]\'\\n                            : \'bg-white text-[#5c4349] border-[#e4b7c0]\'\\n                        }`}\\n                      >\\n                        {ar}\\n                      </button>\\n                    ))}\\n                  </div>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-[#5c4349] mb-1\\\">\\n                    Model Engine\\n                  </label>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setUseProPreview((p) => !p)}\\n                    className=\\\"w-full py-1.5 px-3 rounded-lg text-xs font-semibold border border-[#e4b7c0] bg-white text-[#2d1e22]\\\"\\n                  >\\n                    {useProPreview ? \'gemini-3-pro-image-preview\' : \'gemini-nano-banana-2.1\'}\\n                  </button>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-3 pt-1\\\">\\n                <label className=\\\"inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-[#e4b7c0] bg-[#fdf2f4] text-xs font-medium text-[#7a3b47] cursor-pointer\\\">\\n                  <Upload className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{uploadedImageBase64 ? \'Reference Photo Attached\' : \'Upload Photo to Edit (Optional)\'}</span>\\n                  <input type=\\\"file\\\" accept=\\\"image/*\\\" onChange={handlePhotoUpload} className=\\\"hidden\\\" />\\n                </label>\\n\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={imageLoading}\\n                  className=\\\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#9e5461] text-white text-sm font-medium hover:bg-[#83424e] disabled:opacity-50\\\"\\n                >\\n                  {imageLoading && <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />}\\n                  <span>{uploadedImageBase64 ? \'Edit Image\' : `Generate ${imageSize} Image`}</span>\\n                </button>\\n              </div>\\n\\n              {imageError && (\\n                <div className=\\\"p-3 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700\\\">\\n                  {imageError}\\n                </div>\\n              )}\\n\\n              {generatedImageUrl && (\\n                <div className=\\\"mt-3 rounded-xl overflow-hidden border border-[#e4b7c0] bg-white p-3\\\">\\n                  <img\\n                    src={generatedImageUrl}\\n                    alt=\\\"Generated custom Pretty Charm concept\\\"\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    className=\\\"max-h-72 mx-auto rounded-lg object-contain\\\"\\n                  />\\n                </div>\\n              )}\\n            </form>\\n          )}\\n\\n          {activeTab === \'video\' && (\\n            <form onSubmit={handleGenerateVideo} className=\\\"space-y-4\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#5c4349] mb-1\\\">\\n                  Video Motion Prompt (gemini-omni-1.1-flash via Interactions API)\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  value={videoPrompt}\\n                  onChange={(e) => setVideoPrompt(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-[#e4b7c0] bg-white p-3 text-sm\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <span className=\\\"text-xs font-semibold text-[#5c4349]\\\">Aspect Ratio:</span>\\n                  {([\'16:9\', \'9:16\'] as const).map((ratio) => (\\n                    <button\\n                      key={ratio}\\n                      type=\\\"button\\\"\\n                      onClick={() => setVideoAspectRatio(ratio)}\\n                      className={`px-3 py-1.5 rounded-lg text-xs font-semibold border ${\\n                        videoAspectRatio === ratio\\n                          ? \'bg-[#9e5461] text-white border-[#9e5461]\'\\n                          : \'bg-white text-[#5c4349] border-[#e4b7c0]\'\\n                      }`}\\n                    >\\n                      {ratio === \'16:9\' ? \'16:9 Landscape\' : \'9:16 Portrait Reel\'}\\n                    </button>\\n                  ))}\\n                </div>\\n\\n                <label className=\\\"inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-[#e4b7c0] bg-[#fdf2f4] text-xs font-medium text-[#7a3b47] cursor-pointer\\\">\\n                  <Upload className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{uploadedImageBase64 ? \'Starting Photo Ready\' : \'Upload Photo to Animate (Optional)\'}</span>\\n                  <input type=\\\"file\\\" accept=\\\"image/*\\\" onChange={handlePhotoUpload} className=\\\"hidden\\\" />\\n                </label>\\n\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={videoLoading}\\n                  className=\\\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#9e5461] text-white text-sm font-medium hover:bg-[#83424e] disabled:opacity-50\\\"\\n                >\\n                  {videoLoading && <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />}\\n                  <span>{uploadedImageBase64 ? \'Animate Photo into Video\' : \'Generate Video\'}</span>\\n                </button>\\n              </div>\\n\\n              {videoError && (\\n                <div className=\\\"p-3 rounded-xl bg-red-50 border border-red-200 text-xs text-red-700\\\">\\n                  {videoError}\\n                </div>\\n              )}\\n\\n              {videoResultUrl && (\\n                <div className=\\\"mt-3 rounded-xl overflow-hidden border border-[#e4b7c0] bg-black p-2\\\">\\n                  <video src={videoResultUrl} controls className=\\\"max-h-72 mx-auto rounded-lg\\\" />\\n                </div>\\n              )}\\n            </form>\\n          )}\\n\\n          {activeTab === \'grounding\' && (\\n            <form onSubmit={handleRunGrounding} className=\\\"space-y-4\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setGroundingType(\'search\');\\n                    setGroundingQuery(\'Trending bridesmaid gift hampers and hair accessories in India\');\\n                  }}\\n                  className={`inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold border ${\\n                    groundingType === \'search\'\\n                      ? \'bg-[#9e5461] text-white border-[#9e5461]\'\\n                      : \'bg-white text-[#5c4349] border-[#e4b7c0]\'\\n                  }`}\\n                >\\n                  <Search className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Google Search Grounding</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setGroundingType(\'maps\');\\n                    setGroundingQuery(\'Courier hubs and gifting shopping areas near Gurugram Haryana 122001\');\\n                  }}\\n                  className={`inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold border ${\\n                    groundingType === \'maps\'\\n                      ? \'bg-[#9e5461] text-white border-[#9e5461]\'\\n                      : \'bg-white text-[#5c4349] border-[#e4b7c0]\'\\n                  }`}\\n                >\\n                  <MapPin className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Google Maps Grounding (Gurugram Origin)</span>\\n                </button>\\n              </div>\\n\\n              <div className=\\\"flex gap-2\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  value={groundingQuery}\\n                  onChange={(e) => setGroundingQuery(e.target.value)}\\n                  className=\\\"flex-1 rounded-xl border border-[#e4b7c0] bg-white px-4 py-2.5 text-sm\\\"\\n                />\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={groundingLoading}\\n                  className=\\\"inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-[#9e5461] text-white text-sm font-medium hover:bg-[#83424e] disabled:opacity-50\\\"\\n                >\\n                  {groundingLoading && <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />}\\n                  <span>Search</span>\\n                </button>\\n              </div>\\n\\n              {groundingResult && (\\n                <div className=\\\"rounded-xl border border-[#e4b7c0] bg-white p-4 space-y-3\\\">\\n                  <p className=\\\"text-sm text-[#2d1e22] whitespace-pre-line leading-relaxed\\\">\\n                    {groundingResult}\\n                  </p>\\n                  {groundingChunks.length > 0 && (\\n                    <div className=\\\"pt-2 border-t border-[#f0d8de]\\\">\\n                      <p className=\\\"text-xs font-semibold text-[#7a3b47] mb-1\\\">Verified Sources:</p>\\n                      <ul className=\\\"space-y-1 text-xs\\\">\\n                        {groundingChunks.map((chunk: any, i: number) => {\\n                          const uri = chunk.web?.uri || chunk.maps?.uri;\\n                          const title = chunk.web?.title || chunk.maps?.title || uri;\\n                          if (!uri) return null;\\n                          return (\\n                            <li key={i}>\\n                              <a\\n                                href={uri}\\n                                target=\\\"_blank\\\"\\n                                rel=\\\"noopener noreferrer\\\"\\n                                className=\\\"text-[#9e5461] underline hover:text-[#7a3b47]\\\"\\n                              >\\n                                {title}\\n                              </a>\\n                            </li>\\n                          );\\n                        })}\\n                      </ul>\\n                    </div>\\n                  )}\\n                </div>\\n              )}\\n            </form>\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create GeminiStudioModal component for AI chatbot, Search/Maps grounding, 1K/2K/4K image generation/editing, and 16:9/9:16 video generation\", \"Overwrite\":true, \"TargetFile\":\"/src/components/GeminiStudioModal.tsx\", \"toolAction\":\"Creating GeminiStudioModal.tsx component\", \"toolSummary\":\"Create src/components/GeminiStudioModal.tsx\"}"
      original_name: "write_to_file"
    }
