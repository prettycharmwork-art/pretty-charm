            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Combine duplicate lines for the same product + variant so stock checks cannot be bypassed"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const aggregated = new Map<string, CheckoutCartItemInput>();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
