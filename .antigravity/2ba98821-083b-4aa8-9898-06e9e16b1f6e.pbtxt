    action_spec {
      command {
        instruction: "Update Section 11 in src/shared/domainLogic.ts to support the full set of Admin Image Management statuses, eligible available product filtering, local /uploads/products/*.jpg validation, AI-generated metadata labeling, and Gemini prompt construction from database fields."
        is_edit: true
        file {
          absolute_uri: "file:///src/shared/domainLogic.ts"
