  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect, useMemo } from \'react\';\nimport {\n  ShoppingBag,\n  Heart,\n  Search,\n  User,\n  Home,\n  Grid,\n  Truck,\n  Sparkles,\n  Box,\n  ShieldCheck,\n  ChevronRight,\n  ArrowLeft,\n  Plus,\n  Minus,\n  Trash2,\n  MapPin,\n  Phone,\n  Mail,\n  CheckCircle2,\n  AlertCircle,\n  MessageCircle,\n  Lock,\n  ExternalLink,\n  SlidersHorizontal,\n  Info,\n  HelpCircle,\n  FileText,\n  Clock,\n  Star\n} from \'lucide-react\';\nimport {\n  formatInrFromPaise,\n  calculateShippingPaise,\n  canAddProductToCart,\n  isValidIndianPinCode,\n  isValidIndianPhone,\n  formatHonestDeliveryEta,\n  buildWhatsAppSupportUrl,\n  INDIAN_STATES_AND_UTS\n} from \'./shared/domainLogic\';\nimport { PRODUCT_ARTWORK } from \'./assets/productArtwork\';\nimport { PWAInstallButton, OfflineIndicator } from \'./components/PWAInstallBanner\';\nimport ThreeHamperViewer from \'./components/ThreeHamperViewer\';\nimport GeminiStudioModal from \'./components/GeminiStudioModal\';\nimport AdminDashboard from \'./components/AdminDashboard\';\n\nexport type ScreenName =\n  | \'splash\'\n  | \'auth\'\n  | \'home\'\n  | \'categories\'\n  | \'shop\'\n  | \'product-details\'\n  | \'wishlist\'\n  | \'cart\'\n  | \'checkout\'\n  | \'payment-status\'\n  | \'order-success\'\n  | \'track-order\'\n  | \'about\'\n  | \'contact\'\n  | \'faq\'\n  | \'account\'\n  | \'my-orders\'\n  | \'saved-addresses\'\n  | \'shipping-policy\'\n  | \'return-policy\'\n  | \'privacy-policy\'\n  | \'terms\'\n  | \'3d-studio\'\n  | \'admin\'\n  | \'not-found\';\n\ninterface CartItem {\n  productId: number;\n  variantId?: number | null;\n  variantName?: string;\n  quantity: number;\n}\n\nexport default function App() {\n  const urlParams = new URLSearchParams(window.location.search);\n  const isAutostart = urlParams.get(\'autostart\') === \'1\';\n  const initialScreenParam = urlParams.get(\'screen\') as ScreenName | null;\n\n  const [screen, setScreen] = useState<ScreenName>(\n    initialScreenParam || (isAutostart ? \'home\' : \'splash\')\n  );\n  const [selectedProductSlug, setSelectedProductSlug] = useState<string | null>(null);\n  const [selectedCategorySlug, setSelectedCategorySlug] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [sortBy, setSortBy] = useState<\'featured\' | \'price-asc\' | \'price-desc\' | \'newest\'>(\'featured\');\n  const [showInStockOnly, setShowInStockOnly] = useState<boolean>(false);\n\n  // Storefront data from SQLite API\n  const [categories, setCategories] = useState<any[]>([]);\n  const [products, setProducts] = useState<any[]>([]);\n  const [banners, setBanners] = useState<any[]>([]);\n  const [faqs, setFaqs] = useState<any[]>([]);\n  const [policies, setPolicies] = useState<Record<string, any>>({});\n  const [settings, setSettings] = useState<Record<string, string>>({});\n  const [loadingCatalogue, setLoadingCatalogue] = useState<boolean>(true);\n  const [catalogueError, setCatalogueError] = useState<string>(\'\');\n\n  // Local non-sensitive convenience state\n  const [cart, setCart] = useState<CartItem[]>(() => {\n    try {\n      const saved = localStorage.getItem(\'pretty_charm_cart\');\n      return saved ? JSON.parse(saved) : [];\n    } catch {\n      return [];\n    }\n  });\n  const [wishlist, setWishlist] = useState<number[]>(() => {\n    try {\n      const saved = localStorage.getItem(\'pretty_charm_wishlist\');\n      return saved ? JSON.parse(saved) : [];\n    } catch {\n      return [];\n    }\n  });\n  const [recentlyViewed, setRecentlyViewed] = useState<number[]>(() => {\n    try {\n      const saved = localStorage.getItem(\'pretty_charm_recent\');\n      return saved ? JSON.parse(saved) : [];\n    } catch {\n      return [];\n    }\n  });\n\n  // Customer Auth & Account State\n  const [customerToken, setCustomerToken] = useState<string>(() => sessionStorage.getItem(\'pc_customer_token\') || \'\');\n  const [customerUser, setCustomerUser] = useState<any>(null);\n  const [customerOrders, setCustomerOrders] = useState<any[]>([]);\n  const [customerAddresses, setCustomerAddresses] = useState<any[]>([]);\n  const [authMode, setAuthMode] = useState<\'login\' | \'register\'>(\'login\');\n  const [authForm, setAuthForm] = useState({ name: \'\', email: \'\', phone: \'\', password: \'\' });\n  const [authError, setAuthError] = useState(\'\');\n\n  // Product Detail state\n  const [activeImageIdx, setActiveImageIdx] = useState(0);\n  const [selectedVariantId, setSelectedVariantId] = useState<number | null>(null);\n  const [detailQty, setDetailQty] = useState(1);\n  const [pinCheckInput, setPinCheckInput] = useState(\'\');\n  const [pinCheckResult, setPinCheckResult] = useState<any>(null);\n\n  // Checkout state\n  const [checkoutForm, setCheckoutForm] = useState({\n    fullName: \'\',\n    phone: \'\',\n    email: \'\',\n    houseLine1: \'\',\n    streetLine2: \'\',\n    landmark: \'\',\n    city: \'Gurugram\',\n    state: \'Haryana\',\n    pinCode: \'122001\',\n    deliveryNotes: \'\',\n    paymentMethod: \'manual_upi\'\n  });\n  const [couponInput, setCouponInput] = useState(\'\');\n  const [appliedCoupon, setAppliedCoupon] = useState<{ code: string; discountPaise: number } | null>(null);\n  const [couponError, setCouponError] = useState(\'\');\n  const [checkoutError, setCheckoutError] = useState(\'\');\n  const [submittingOrder, setSubmittingOrder] = useState(false);\n\n  // Active Order / Payment / Tracking state\n  const [lastCreatedOrder, setLastCreatedOrder] = useState<any>(null);\n  const [utrReferenceInput, setUtrReferenceInput] = useState(\'\');\n  const [utrSubmittedMsg, setUtrSubmittedMsg] = useState(\'\');\n  const [trackOrderForm, setTrackOrderForm] = useState({ orderNumber: \'\', phone: \'\' });\n  const [trackedOrderResult, setTrackedOrderResult] = useState<any>(null);\n  const [trackOrderError, setTrackOrderError] = useState(\'\');\n\n  // Contact Inquiry state\n  const [contactForm, setContactForm] = useState({ name: \'\', email: \'\', phone: \'\', subject: \'\', message: \'\' });\n  const [contactSuccess, setContactSuccess] = useState(\'\');\n\n  // New Saved Address form\n  const [newAddressForm, setNewAddressForm] = useState({\n    label: \'Home\',\n    fullName: \'\',\n    phone: \'\',\n    houseLine1: \'\',\n    streetLine2: \'\',\n    landmark: \'\',\n    city: \'\',\n    state: \'Haryana\',\n    pinCode: \'\'\n  });\n\n  // Gemini AI Concierge Modal\n  const [isAiModalOpen, setIsAiModalOpen] = useState(false);\n  const [toastMessage, setToastMessage] = useState(\'\');\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(\'\'), 3200);\n  };\n\n  const fetchCatalogue = async () => {\n    setLoadingCatalogue(true);\n    setCatalogueError(\'\');\n    try {\n      const res = await fetch(\'/api/catalogue\');\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || \'Failed to load catalogue\');\n      setCategories(data.categories || []);\n      setProducts(data.products || []);\n      setBanners(data.banners || []);\n      setFaqs(data.faqs || []);\n      setPolicies(data.policies || {});\n      setSettings(data.settings || {});\n    } catch (err: any) {\n      setCatalogueError(err.message || \'Unable to load storefront catalogue.\');\n    } finally {\n      setLoadingCatalogue(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchCatalogue();\n  }, []);\n\n  useEffect(() => {\n    localStorage.setItem(\'pretty_charm_cart\', JSON.stringify(cart));\n  }, [cart]);\n\n  useEffect(() => {\n    localStorage.setItem(\'pretty_charm_wishlist\', JSON.stringify(wishlist));\n  }, [wishlist]);\n\n  useEffect(() => {\n    localStorage.setItem(\'pretty_charm_recent\', JSON.stringify(recentlyViewed));\n  }, [recentlyViewed]);\n\n  useEffect(() => {\n    if (!customerToken) {\n      setCustomerUser(null);\n      return;\n    }\n    fetch(\'/api/customer/me\', {\n      headers: { Authorization: `Bearer ${customerToken}` }\n    })\n      .then((r) => (r.ok ? r.json() : Promise.reject()))\n      .then((data) => {\n        setCustomerUser(data.user);\n        setCustomerOrders(data.orders || []);\n        setCustomerAddresses(data.addresses || []);\n        setCheckoutForm((prev) => ({\n          ...prev,\n          fullName: prev.fullName || data.user.name || \'\',\n          email: prev.email || data.user.email || \'\',\n          phone: prev.phone || data.user.phone || \'\'\n        }));\n      })\n      .catch(() => {\n        sessionStorage.removeItem(\'pc_customer_token\');\n        setCustomerToken(\'\');\n      });\n  }, [customerToken]);\n\n  const navigateToProduct = (product: any) => {\n    setSelectedProductSlug(product.slug);\n    setActiveImageIdx(0);\n    setSelectedVariantId(product.variants?.[0]?.id || null);\n    setDetailQty(1);\n    setPinCheckResult(null);\n    setRecentlyViewed((prev) => {\n      const filtered = prev.filter((id) => id !== product.id);\n      return [product.id, ...filtered].slice(0, 8);\n    });\n    setScreen(\'product-details\');\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  const toggleWishlist = (productId: number) => {\n    setWishlist((prev) => {\n      if (prev.includes(productId)) {\n        showToast(\'Removed from your Wishlist\');\n        return prev.filter((id) => id !== productId);\n      } else {\n        showToast(\'Saved to your Wishlist\');\n        return [...prev, productId];\n      }\n    });\n  };\n\n  const handleAddToCart = (product: any, qty = 1, variantId?: number | null) => {\n    const check = canAddProductToCart({\n      status: product.status,\n      stockQuantity: product.stock_quantity,\n      requestedQuantity: qty\n    });\n    if (!check.allowed) {\n      showToast(check.reason || \'Cannot add this item right now.\');\n      return;\n    }\n    const chosenVariant = product.variants?.find((v: any) => v.id === variantId);\n    setCart((prev) => {\n      const existingIdx = prev.findIndex(\n        (item) => item.productId === product.id && (item.variantId || null) === (variantId || null)\n      );\n      if (existingIdx > -1) {\n        const nextQty = prev[existingIdx].quantity + qty;\n        if (nextQty > product.stock_quantity) {\n          showToast(`Only ${product.stock_quantity} units available in stock.`);\n          return prev;\n        }\n        const updated = [...prev];\n        updated[existingIdx] = { ...updated[existingIdx], quantity: nextQty };\n        showToast(`Updated ${product.name} quantity in bag`);\n        return updated;\n      }\n      showToast(`Added ${product.name} to your bag`);\n      return [\n        ...prev,\n        {\n          productId: product.id,\n          variantId: variantId || null,\n          variantName: chosenVariant ? `${chosenVariant.variant_name}: ${chosenVariant.variant_value}` : undefined,\n          quantity: qty\n        }\n      ];\n    });\n  };\n\n  const updateCartItemQty = (productId: number, variantId: number | null | undefined, delta: number) => {\n    const product = products.find((p) => p.id === productId);\n    if (!product) return;\n    setCart((prev) =>\n      prev\n        .map((item) => {\n          if (item.productId === productId && (item.variantId || null) === (variantId || null)) {\n            const nextQty = item.quantity + delta;\n            if (nextQty <= 0) return null;\n            if (nextQty > product.stock_quantity) {\n              showToast(`Maximum available stock is ${product.stock_quantity}`);\n              return item;\n            }\n            return { ...item, quantity: nextQty };\n          }\n          return item;\n        })\n        .filter(Boolean) as CartItem[]\n    );\n  };\n\n  const hydratedCart = useMemo(() => {\n    return cart\n      .map((item) => {\n        const product = products.find((p) => p.id === item.productId);\n        if (!product) return null;\n        const variant = product.variants?.find((v: any) => v.id === item.variantId);\n        const unitPricePaise = product.selling_price_paise + (variant?.price_delta_paise || 0);\n        return {\n          ...item,\n          product,\n          unitPricePaise,\n          lineTotalPaise: unitPricePaise * item.quantity\n        };\n      })\n      .filter(Boolean) as Array<{\n      productId: number;\n      variantId?: number | null;\n      variantName?: string;\n      quantity: number;\n      product: any;\n      unitPricePaise: number;\n      lineTotalPaise: number;\n    }>;\n  }, [cart, products]);\n\n  const cartSubtotalPaise = useMemo(\n    () => hydratedCart.reduce((acc, item) => acc + item.lineTotalPaise, 0),\n    [hydratedCart]\n  );\n\n  const discountPaise = appliedCoupon ? appliedCoupon.discountPaise : 0;\n  const discountedSubtotalPaise = Math.max(0, cartSubtotalPaise - discountPaise);\n  const shippingPaise = useMemo(\n    () => (hydratedCart.length > 0 ? calculateShippingPaise(discountedSubtotalPaise) : 0),\n    [hydratedCart.length, discountedSubtotalPaise]\n  );\n  const grandTotalPaise = discountedSubtotalPaise + shippingPaise;\n\n  const filteredProducts = useMemo(() => {\n    return products\n      .filter((p) => {\n        // Storefront visibility: show active & out-of-stock, plus draft/coming-soon with clear badges so customer sees why they are non-purchasable\n        if (p.status === \'archived\') return false;\n        if (selectedCategorySlug !== \'all\' && p.category_slug !== selectedCategorySlug) return false;\n        if (showInStockOnly && (p.status !== \'active\' || p.stock_quantity <= 0)) return false;\n        if (searchQuery.trim()) {\n          const q = searchQuery.toLowerCase();\n          const matchName = p.name.toLowerCase().includes(q);\n          const matchDesc = p.description.toLowerCase().includes(q);\n          const matchCategory = (p.category_name || \'\').toLowerCase().includes(q);\n          if (!matchName && !matchDesc && !matchCategory) return false;\n        }\n        return true;\n      })\n      .sort((a, b) => {\n        if (sortBy === \'price-asc\') return a.selling_price_paise - b.selling_price_paise;\n        if (sortBy === \'price-desc\') return b.selling_price_paise - a.selling_price_paise;\n        if (sortBy === \'newest\') return b.id - a.id;\n        // featured: active items first, then coming-soon/draft\n        if (a.status === \'active\' && b.status !== \'active\') return -1;\n        if (a.status !== \'active\' && b.status === \'active\') return 1;\n        return a.id - b.id;\n      });\n  }, [products, selectedCategorySlug, showInStockOnly, searchQuery, sortBy]);\n\n  const currentProduct = useMemo(\n    () => products.find((p) => p.slug === selectedProductSlug) || null,\n    [products, selectedProductSlug]\n  );\n\n  const handleCheckPinServiceability = async () => {\n    if (!isValidIndianPinCode(pinCheckInput)) {\n      setPinCheckResult({ serviceable: false, message: \'Enter a valid 6-digit Indian PIN code (e.g. 122001).\' });\n      return;\n    }\n    const res = await fetch(`/api/pincode/${pinCheckInput.trim()}`);\n    const data = await res.json();\n    setPinCheckResult(data);\n  };\n\n  const handleApplyCoupon = async () => {\n    setCouponError(\'\');\n    if (!couponInput.trim()) return;\n    const res = await fetch(\'/api/coupons/validate\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ code: couponInput.trim(), subtotalPaise: cartSubtotalPaise })\n    });\n    const data = await res.json();\n    if (!res.ok) {\n      setCouponError(data.error || \'Invalid coupon\');\n      setAppliedCoupon(null);\n      return;\n    }\n    setAppliedCoupon({ code: data.code, discountPaise: data.discountPaise });\n    showToast(`Applied coupon ${data.code}`);\n  };\n\n  const handlePlaceOrder = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setCheckoutError(\'\');\n    if (!isValidIndianPhone(checkoutForm.phone)) {\n      setCheckoutError(\'Please enter a valid 10-digit Indian mobile number starting with 6, 7, 8, or 9.\');\n      return;\n    }\n    if (!isValidIndianPinCode(checkoutForm.pinCode)) {\n      setCheckoutError(\'Please enter a valid 6-digit Indian PIN code.\');\n      return;\n    }\n    if (hydratedCart.length === 0) {\n      setCheckoutError(\'Your shopping bag is empty.\');\n      return;\n    }\n\n    setSubmittingOrder(true);\n    try {\n      const res = await fetch(\'/api/checkout\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          customerUserId: customerUser?.id || null,\n          items: hydratedCart.map((i) => ({\n            productId: i.productId,\n            variantId: i.variantId,\n            variantName: i.variantName,\n            quantity: i.quantity\n          })),\n          address: checkoutForm,\n          paymentMethod: checkoutForm.paymentMethod,\n          couponCode: appliedCoupon?.code || null\n        })\n      });\n      const data = await res.json();\n      if (!res.ok) {\n        setCheckoutError(data.error || \'Could not process checkout.\');\n        return;\n      }\n      setLastCreatedOrder(data.order);\n      setCart([]);\n      setAppliedCoupon(null);\n      await fetchCatalogue();\n      if (checkoutForm.paymentMethod === \'cod\') {\n        setScreen(\'order-success\');\n      } else {\n        setScreen(\'payment-status\');\n      }\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\n    } catch (err: any) {\n      setCheckoutError(err.message || \'Network error while creating order.\');\n    } finally {\n      setSubmittingOrder(false);\n    }\n  };\n\n  const handleSubmitUtrReference = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!lastCreatedOrder || !utrReferenceInput.trim()) return;\n    const res = await fetch(`/api/orders/${lastCreatedOrder.orderNumber}/submit-utr`, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        phone: lastCreatedOrder.customerPhone,\n        utrReference: utrReferenceInput.trim()\n      })\n    });\n    const data = await res.json();\n    if (res.ok) {\n      setUtrSubmittedMsg(data.message);\n      setLastCreatedOrder((prev: any) => ({ ...prev, paymentStatus: \'Pending Verification\' }));\n    }\n  };\n\n  const handleTrackOrder = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setTrackOrderError(\'\');\n    setTrackedOrderResult(null);\n    const res = await fetch(\'/api/orders/track\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(trackOrderForm)\n    });\n    const data = await res.json();\n    if (!res.ok) {\n      setTrackOrderError(data.error || \'Unable to locate order with those details.\');\n      return;\n    }\n    setTrackedOrderResult(data);\n  };\n\n  const handleCustomerAuth = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setAuthError(\'\');\n    const endpoint = authMode === \'login\' ? \'/api/auth/login\' : \'/api/auth/register\';\n    const res = await fetch(endpoint, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(authForm)\n    });\n    const data = await res.json();\n    if (!res.ok) {\n      setAuthError(data.error || \'Authentication failed\');\n      return;\n    }\n    sessionStorage.setItem(\'pc_customer_token\', data.token);\n    setCustomerToken(data.token);\n    setCustomerUser(data.user);\n    showToast(`Welcome to Pretty Charm, ${data.user.name}!`);\n    setScreen(\'account\');\n  };\n\n  const handleSaveAddress = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!customerToken) return;\n    const res = await fetch(\'/api/customer/addresses\', {\n      method: \'POST\',\n      headers: {\n        \'Content-Type\': \'application/json\',\n        Authorization: `Bearer ${customerToken}`\n      },\n      body: JSON.stringify({ ...newAddressForm, isDefault: true })\n    });\n    if (res.ok) {\n      const meRes = await fetch(\'/api/customer/me\', {\n        headers: { Authorization: `Bearer ${customerToken}` }\n      });\n      const meData = await meRes.json();\n      setCustomerAddresses(meData.addresses || []);\n      showToast(\'Address saved to your account\');\n    }\n  };\n\n  const handleContactSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    const res = await fetch(\'/api/contact\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(contactForm)\n    });\n    if (res.ok) {\n      setContactSuccess(\'Thank you! Our Gurugram studio team has recorded your inquiry and will respond within 24 hours.\');\n      setContactForm({ name: \'\', email: \'\', phone: \'\', subject: \'\', message: \'\' });\n    }\n  };\n\n  // If Admin Panel screen is active, render full Admin Suite\n  if (screen === \'admin\') {\n    return (\n      <>\n        <OfflineIndicator />\n        <AdminDashboard\n          onExitAdmin={() => {\n            fetchCatalogue();\n            setScreen(\'home\');\n          }}\n        />\n      </>\n    );\n  }\n\n  // Screen 1: Splash Screen (from uploaded UI reference)\n  if (screen === \'splash\') {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-b from-[#fdf2f4] via-[#fffdfb] to-[#f8e5e8] flex flex-col items-center justify-between p-6 text-center select-none\">\n        <OfflineIndicator />\n        <div className=\"w-full flex justify-end max-w-md\">\n          <button\n            onClick={() => setScreen(\'admin\')}\n            className=\"text-xs text-[#7c5c63] hover:text-[#9e5461] px-2.5 py-1 rounded-full transition-colors whitespace-nowrap\"\n          >\n            Admin Suite\n          </button>\n        </div>\n\n        <div className=\"my-auto max-w-md w-full space-y-6 py-8\">\n          <div className=\"w-28 h-28 mx-auto rounded-full bg-white shadow-md border border-[#f0d5da] flex items-center justify-center relative\">\n            <div className=\"w-24 h-24 rounded-full border border-[#e6b8c1] flex flex-col items-center justify-center bg-[#fdf2f4]/60\">\n              <Sparkles className=\"w-7 h-7 text-[#9e5461] mb-0.5\" />\n              <span className=\"font-serif text-xs tracking-[0.22em] uppercase text-[#9e5461] font-semibold\">\n                PC\n              </span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <p className=\"text-xs uppercase tracking-[0.25em] text-[#9e5461] font-semibold\">\n              Gurugram \302\267 Haryana \302\267 India\n            </p>\n            <h1 className=\"font-serif text-4xl sm:text-5xl text-[#2d1e21] font-semibold tracking-tight\">\n              Pretty Charm\n            </h1>\n            <p className=\"text-sm text-[#7c5c63] max-w-xs mx-auto leading-relaxed\">\n              Curated Keepsake Gift Hampers, Satin Hair Accessories &amp; Anti-Tarnish Demifine Jewellery.\n            </p>\n          </div>\n\n          <div className=\"w-64 h-44 mx-auto rounded-2xl overflow-hidden border border-[#f0d5da] shadow-sm bg-white\">\n            <img\n              src={PRODUCT_ARTWORK.heroBanner}\n              alt=\"Pretty Charm Keepsake Collection\"\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n\n          <div className=\"space-y-3 pt-2 max-w-xs mx-auto\">\n            <button\n              onClick={() => setScreen(\'home\')}\n              data-testid=\"enter-store-btn\"\n              className=\"w-full py-3.5 px-6 rounded-full bg-[#9e5461] hover:bg-[#86434f] text-white font-medium text-sm shadow-sm transition-all flex items-center justify-center gap-2 whitespace-nowrap\"\n            >\n              <span>Enter Pretty Charm Store</span>\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n            <div className=\"flex items-center justify-center gap-4 text-xs text-[#7c5c63]\">\n              <button\n                onClick={() => setScreen(\'auth\')}\n                className=\"hover:text-[#9e5461] underline underline-offset-4 whitespace-nowrap\"\n              >\n                Sign In / Create Account\n              </button>\n              <span>\302\267</span>\n              <button\n                onClick={() => setScreen(\'track-order\')}\n                className=\"hover:text-[#9e5461] underline underline-offset-4 whitespace-nowrap\"\n              >\n                Track Order\n              </button>\n            </div>\n          </div>\n        </div>\n\n        <p className=\"text-[11px] text-[#7c5c63]\">\n          Free Pan-India Shipping on orders \342\202\271999+ \302\267 Guest Checkout Enabled\n        </p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#fffdfb] text-[#2d1e21] flex flex-col pb-20 md:pb-0\">\n      <OfflineIndicator />\n\n      {/* Top Promotional Announcement Strip */}\n      <div className=\"bg-[#9e5461] text-white text-[11px] sm:text-xs py-2 px-4 text-center font-medium tracking-wide\">\n        <span>\n          Pan-India Dispatch from Gurugram \302\267 Shipping \342\202\27159 (&lt;\342\202\271499) \302\267 \342\202\27139 (\342\202\271499\342\200\223\342\202\271998) \302\267{\' \'}\n          <strong className=\"underline\">FREE on \342\202\271999+</strong>\n        </span>\n      </div>\n\n      {/* Top Navigation Bar (Follows Top Bar Contract: max 4 top-level groups, whitespace-nowrap, >=24px gap) */}\n      <header className=\"sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#f0d5da]\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-6\">\n          {/* Brand Logo */}\n          <div className=\"flex items-center gap-3\">\n            {screen !== \'home\' && (\n              <button\n                onClick={() => setScreen(\'home\')}\n                aria-label=\"Back to Home\"\n                className=\"p-1.5 rounded-full hover:bg-[#fdf2f4] text-[#7c5c63]\"\n              >\n                <ArrowLeft className=\"w-4 h-4\" />\n              </button>\n            )}\n            <button\n              onClick={() => setScreen(\'home\')}\n              className=\"text-left group focus:outline-none\"\n            >\n              <span className=\"font-serif text-2xl sm:text-[26px] font-semibold text-[#2d1e21] tracking-tight block leading-none\">\n                Pretty Charm\n              </span>\n              <span className=\"text-[10px] uppercase tracking-[0.2em] text-[#9e5461] block mt-0.5\">\n                Gurugram Studio\n              </span>\n            </button>\n          </div>\n\n          {/* Primary Desktop Navigation Links (4 top-level items) */}\n          <nav className=\"hidden md:flex items-center gap-7 text-sm font-medium text-[#5c3d42]\">\n            <button\n              onClick={() => {\n                setSelectedCategorySlug(\'all\');\n                setScreen(\'shop\');\n              }}\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap ${\n                screen === \'shop\' ? \'text-[#9e5461] font-semibold\' : \'\'\n              }`}\n            >\n              Shop Collection\n            </button>\n            <button\n              onClick={() => setScreen(\'categories\')}\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap ${\n                screen === \'categories\' ? \'text-[#9e5461] font-semibold\' : \'\'\n              }`}\n            >\n              Categories\n            </button>\n            <button\n              onClick={() => setScreen(\'3d-studio\')}\n              className={`hover:text-[#9e5461] transition-colors flex items-center gap-1.5 whitespace-nowrap ${\n                screen === \'3d-studio\' ? \'text-[#9e5461] font-semibold\' : \'\'\n              }`}\n            >\n              <Box className=\"w-4 h-4 text-[#9e5461]\" />\n              <span>3D Hamper Studio</span>\n            </button>\n            <button\n              onClick={() => setScreen(\'track-order\')}\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap ${\n                screen === \'track-order\' ? \'text-[#9e5461] font-semibold\' : \'\'\n              }`}\n            >\n              Track My Order\n            </button>\n          </nav>\n\n          {/* Right Action Cluster */}\n          <div className=\"flex items-center gap-2 sm:gap-3\">\n            <PWAInstallButton />\n\n            <button\n              onClick={() => setIsAiModalOpen(true)}\n              className=\"px-3 py-1.5 rounded-full bg-[#fdf2f4] hover:bg-[#f8e1e6] text-[#9e5461] border border-[#f0d5da] text-xs font-medium flex items-center gap-1.5 transition-colors whitespace-nowrap\"\n              title=\"Pretty Charm AI Styling Concierge\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">AI Stylist</span>\n            </button>\n\n            <button\n              onClick={() => setScreen(\'wishlist\')}\n              aria-label=\"Wishlist\"\n              className=\"relative p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors\"\n            >\n              <Heart className=\"w-5 h-5\" />\n              {wishlist.length > 0 && (\n                <span className=\"absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-[#9e5461] text-white text-[10px] font-tabular flex items-center justify-center\">\n                  {wishlist.length}\n                </span>\n              )}\n            </button>\n\n            <button\n              onClick={() => setScreen(\'cart\')}\n              data-testid=\"header-cart-btn\"\n              aria-label=\"Shopping Bag\"\n              className=\"relative p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors\"\n            >\n              <ShoppingBag className=\"w-5 h-5\" />\n              {hydratedCart.length > 0 && (\n                <span\n                  data-testid=\"cart-badge-count\"\n                  className=\"absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-[#9e5461] text-white text-[10px] font-tabular flex items-center justify-center\"\n                >\n                  {hydratedCart.reduce((s, i) => s + i.quantity, 0)}\n                </span>\n              )}\n            </button>\n\n            <button\n              onClick={() => setScreen(customerUser ? \'account\' : \'auth\')}\n              aria-label=\"Account\"\n              className=\"p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors\"\n            >\n              <User className=\"w-5 h-5\" />\n            </button>\n\n            <button\n              onClick={() => setScreen(\'admin\')}\n              data-testid=\"open-admin-btn\"\n              className=\"hidden sm:inline-flex px-2.5 py-1 rounded-lg border border-[#f0d5da] text-[11px] font-medium text-[#7c5c63] hover:text-[#9e5461] hover:border-[#9e5461] whitespace-nowrap\"\n            >\n              Admin\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Toast Notification */}\n      {toastMessage && (\n        <div className=\"fixed bottom-20 md:bottom-6 right-4 z-50 bg-[#2d1e21] text-white px-4 py-2.5 rounded-xl shadow-lg text-xs font-medium flex items-center gap-2 border border-[#9e5461]/40\">\n          <CheckCircle2 className=\"w-4 h-4 text-[#f5b8c3]\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6\">\n        {/* SCREEN 3: HOME PAGE */}\n        {screen === \'home\' && (\n          <div className=\"space-y-10\">\n            {/* Hero Banner */}\n            <section className=\"rounded-3xl bg-gradient-to-r from-[#fdf2f4] via-[#fff9fa] to-[#f9e5e9] border border-[#f0d5da] overflow-hidden shadow-sm\">\n              <div className=\"grid grid-cols-1 lg:grid-cols-12 items-center\">\n                <div className=\"lg:col-span-7 p-6 sm:p-10 lg:p-12 space-y-5\">\n                  <p className=\"text-xs uppercase tracking-[0.2em] text-[#9e5461] font-semibold\">\n                    Handcrafted in Gurugram \302\267 Pan-India Delivery\n                  </p>\n                  <h1 className=\"font-serif text-3xl sm:text-5xl text-[#2d1e21] font-semibold leading-[1.12]\">\n                    Thoughtful Luxury for Every Everyday Moment.\n                  </h1>\n                  <p className=\"text-sm sm:text-base text-[#5c3d42] max-w-xl leading-relaxed\">\n                    Explore satin hair accessories, 18K rose-gold plated anti-tarnish jewellery, and bespoke keepsake hampers curated with care.\n                  </p>\n                  <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n                    <button\n                      onClick={() => {\n                        setSelectedCategorySlug(\'all\');\n                        setScreen(\'shop\');\n                      }}\n                      data-testid=\"hero-shop-btn\"\n                      className=\"px-6 py-3 rounded-full bg-[#9e5461] hover:bg-[#85424e] text-white text-sm font-medium transition-colors flex items-center gap-2 whitespace-nowrap\"\n                    >\n                      <span>Explore Collection</span>\n                      <ChevronRight className=\"w-4 h-4\" />\n                    </button>\n                    <button\n                      onClick={() => setScreen(\'3d-studio\')}\n                      className=\"px-5 py-3 rounded-full bg-white hover:bg-[#fdf2f4] text-[#9e5461] border border-[#e5c2c9] text-sm font-medium transition-colors flex items-center gap-2 whitespace-nowrap\"\n                    >\n                      <Box className=\"w-4 h-4\" />\n                      <span>Inspect in 3D Studio</span>\n                    </button>\n                  </div>\n                </div>\n                <div className=\"lg:col-span-5 h-64 sm:h-80 lg:h-96 bg-white/60\">\n                  <img\n                    src={PRODUCT_ARTWORK.heroBanner}\n                    alt=\"Pretty Charm Signature Collection\"\n                    className=\"w-full h-full object-cover\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            {/* Quick Search Bar */}\n            <section className=\"max-w-2xl mx-auto\">\n              <div className=\"relative flex items-center\">\n                <Search className=\"w-4 h-4 text-[#7c5c63] absolute left-4 pointer-events-none\" />\n                <input\n                  type=\"search\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  onKeyDown={(e) => {\n                    if (e.key === \'Enter\') setScreen(\'shop\');\n                  }}\n                  placeholder=\"Search hair claws, silk scrunchies, pearl hoops, gift hampers...\"\n                  className=\"w-full pl-11 pr-28 py-3 rounded-full bg-white border border-[#f0d5da] text-sm focus:outline-none focus:border-[#9e5461] shadow-2xs\"\n                />\n                <button\n                  onClick={() => setScreen(\'shop\')}\n                  className=\"absolute right-1.5 px-4 py-1.5 rounded-full bg-[#9e5461] text-white text-xs font-medium whitespace-nowrap\"\n                >\n                  Search\n                </button>\n              </div>\n            </section>\n\n            {/* Category Showcase */}\n            <section className=\"space-y-4\">\n              <div className=\"flex items-end justify-between\">\n                <div>\n                  <p className=\"text-xs uppercase tracking-[0.16em] text-[#9e5461] font-semibold\">\n                    Curated Departments\n                  </p>\n                  <h2 className=\"font-serif text-2xl sm:text-3xl text-[#2d1e21] font-semibold\">\n                    Shop by Category\n                  </h2>\n                </div>\n                <button\n                  onClick={() => setScreen(\'categories\')}\n                  className=\"text-xs font-medium text-[#9e5461] hover:underline flex items-center gap-1 whitespace-nowrap\"\n                >\n                  <span>View All 5 Categories</span>\n                  <ChevronRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4\">\n                {categories.map((cat) => (\n                  <button\n                    key={cat.id}\n                    onClick={() => {\n                      setSelectedCategorySlug(cat.slug);\n                      setScreen(\'shop\');\n                    }}\n                    className=\"group text-left rounded-2xl bg-white border border-[#f0d5da] p-3.5 hover:border-[#9e5461] transition-all flex flex-col justify-between shadow-2xs\"\n                  >\n                    <div className=\"aspect-4/3 rounded-xl overflow-hidden bg-[#fdf2f4] mb-3\">\n                      <img\n                        src={cat.image_url || PRODUCT_ARTWORK.heroBanner}\n                        alt={cat.name}\n                        className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                      />\n                    </div>\n                    <div>\n                      <p className=\"text-[11px] text-[#9e5461] font-medium\">\n                        {cat.status === \'coming-soon\' ? \'Coming Soon\' : \'Available Now\'}\n                      </p>\n                      <h3 className=\"font-serif text-lg font-semibold text-[#2d1e21] leading-snug\">\n                        {cat.name}\n                      </h3>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </section>\n\n            {/* Ready-to-Ship Bestsellers (Hair Accessories & Jewellery) */}\n            <section className=\"space-y-4\">\n              <div className=\"flex items-end justify-between\">\n                <div>\n                  <p className=\"text-xs uppercase tracking-[0.16em] text-[#9e5461] font-semibold\">\n                    Verified Stock \302\267 Immediate Dispatch\n                  </p>\n                  <h2 className=\"font-serif text-2xl sm:text-3xl text-[#2d1e21] font-semibold\">\n                    Ready-to-Ship Hair Accessories &amp; Jewellery\n                  </h2>\n                </div>\n                <button\n                  onClick={() => {\n                    setSelectedCategorySlug(\'all\');\n                    setScreen(\'shop\');\n                  }}\n                  className=\"text-xs font-medium text-[#9e5461] hover:underline whitespace-nowrap\"\n                >\n                  Browse Full Catalogue \342\206\222\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n                {products\n                  .filter((p) => p.status === \'active\')\n                  .map((product) => (\n                    <ProductCard\n                      key={product.id}\n                      product={product}\n                      isWishlisted={wishlist.includes(product.id)}\n                      onToggleWishlist={() => toggleWishlist(product.id)}\n                      onSelect={() => navigateToProduct(product)}\n                      onAddToCart={() =>\n                        handleAddToCart(product, 1, product.variants?.[0]?.id || null)\n                      }\n                    />\n                  ))}\n              </div>\n            </section>\n\n            {/* Draft Hampers Preview (Non-purchasable until owner publishes in Admin) */}\n            <section className=\"rounded-3xl bg-[#fdf2f4]/70 border border-[#f0d5da] p-6 sm:p-8 space-y-5\">\n              <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-3\">\n                <div>\n                  <p className=\"text-xs uppercase tracking-[0.16em] text-[#9e5461] font-semibold\">\n                    Upcoming Signature Gift Boxes \302\267 Draft Catalogue Preview\n                  </p>\n                  <h2 className=\"font-serif text-2xl sm:text-3xl text-[#2d1e21] font-semibold\">\n                    Pretty Charm Curated Gift Hampers\n                  </h2>\n                  <p className=\"text-xs text-[#7c5c63] mt-1 max-w-2xl\">\n                    These 4 initial hamper configurations are currently in <strong>Draft</strong> status awaiting final owner confirmation of box contents, photography, and stock in the Admin Panel before ordering opens.\n                  </p>\n                </div>\n                <button\n                  onClick={() => setScreen(\'admin\')}\n                  className=\"px-4 py-2 rounded-full bg-white border border-[#e5c2c9] text-xs font-medium text-[#9e5461] hover:bg-[#fdf2f4] whitespace-nowrap self-start sm:self-auto\"\n                >\n                  Confirm &amp; Publish in Admin \342\206\222\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n                {products\n                  .filter((p) => p.category_slug === \'gift-hampers\')\n                  .map((product) => (\n                    <ProductCard\n                      key={product.id}\n                      product={product}\n                      isWishlisted={wishlist.includes(product.id)}\n                      onToggleWishlist={() => toggleWishlist(product.id)}\n                      onSelect={() => navigateToProduct(product)}\n                      onAddToCart={() =>\n                        handleAddToCart(product, 1, product.variants?.[0]?.id || null)\n                      }\n                    />\n                  ))}\n              </div>\n            </section>\n\n            {/* Recently Viewed Items */}\n            {recentlyViewed.length > 0 && (\n              <section className=\"space-y-4\">\n                <h2 className=\"font-serif text-2xl text-[#2d1e21] font-semibold\">\n                  Recently Viewed\n                </h2>\n                <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n                  {recentlyViewed\n                    .map((id) => products.find((p) => p.id === id))\n                    .filter(Boolean)\n                    .map((product: any) => (\n                      <button\n                        key={product.id}\n                        onClick={() => navigateToProduct(product)}\n                        className=\"text-left p-3 rounded-2xl bg-white border border-[#f0d5da] hover:border-[#9e5461] transition-all flex items-center gap-3\"\n                      >\n                        <img\n                          src={product.images?.[0] || PRODUCT_ARTWORK.heroBanner}\n                          alt={product.name}\n                          className=\"w-14 h-14 rounded-xl object-cover bg-[#fdf2f4] shrink-0\"\n                        />\n                        <div className=\"min-w-0\">\n                          <p className=\"text-xs font-semibold text-[#2d1e21] truncate\">\n                            {product.name}\n                          </p>\n                          <p className=\"text-xs text-[#9e5461] font-tabular mt-0.5\">\n                            {formatInrFromPaise(product.selling_price_paise)}\n                          </p>\n                        </div>\n                      </button>\n                    ))}\n                </div>\n              </section>\n            )}\n          </div>\n        )}\n\n        {/* SCREEN 4: SHOP / CATEGORIES */}\n        {screen === \'categories\' && (\n          <div className=\"space-y-6\">\n            <div>\n              <p className=\"text-xs uppercase tracking-[0.18em] text-[#9e5461] font-semibold\">\n                Pretty Charm Collections\n              </p>\n              <h1 className=\"font-serif text-3xl sm:text-4xl text-[#2d1e21] font-semibold\">\n                Browse Categories\n              </h1>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              {categories.map((cat) => {\n                const catProducts = products.filter((p) => p.category_slug === cat.slug && p.status !== \'archived\');\n                return (\n                  <div\n                    key={cat.id}\n                    className=\"rounded-3xl bg-white border border-[#f0d5da] overflow-hidden shadow-2xs flex flex-col sm:flex-row\"\n                  >\n                    <div className=\"sm:w-48 h-48 sm:h-auto bg-[#fdf2f4] shrink-0\">\n                      <img\n                        src={cat.image_url || PRODUCT_ARTWORK.heroBanner}\n                        alt={cat.name}\n                        className=\"w-full h-full object-cover\"\n                      />\n                    </div>\n                    <div className=\"p-6 flex flex-col justify-between flex-1\">\n                      <div className=\"space-y-2\">\n                        <p className=\"text-xs text-[#9e5461] font-medium\">\n                          {cat.status === \'coming-soon\'\n                            ? \'Coming Soon \302\267 Preview Only\'\n                            : `${catProducts.length} Catalogue Items`}\n                        </p>\n                        <h2 className=\"font-serif text-2xl font-semibold text-[#2d1e21]\">\n                          {cat.name}\n                        </h2>\n                        <p className=\"text-xs text-[#5c3d42] leading-relaxed\">\n                          {cat.description}\n                        </p>\n                      </div>\n                      <div className=\"pt-4\">\n                        <button\n                          onClick={() => {\n                            setSelectedCategorySlug(cat.slug);\n                            setScreen(\'shop\');\n                          }}\n                          className=\"px-4 py-2 rounded-full bg-[#fdf2f4] hover:bg-[#9e5461] text-[#9e5461] hover:text-white text-xs font-medium transition-colors whitespace-nowrap\"\n                        >\n                          {cat.status === \'coming-soon\' ? \'View Preview\' : `Explore ${cat.name}`}\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        )}\n\n        {/* SCREEN 5: PRODUCT LISTING AND FILTERING */}\n        {screen === \'shop\' && (\n          <div className=\"space-y-6\">\n            <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[#f0d5da] pb-5\">\n              <div>\n                <p className=\"text-xs uppercase tracking-[0.18em] text-[#9e5461] font-semibold\">\n                  Pretty Charm Catalogue\n                </p>\n                <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n                  {selectedCategorySlug === \'all\'\n                    ? \'All Collections\'\n                    : categories.find((c) => c.slug === selectedCategorySlug)?.name || \'Shop\'}\n                </h1>\n              </div>\n\n              {/* Filter & Sort Controls */}\n              <div className=\"flex flex-wrap items-center gap-3\">\n                <div className=\"relative\">\n                  <Search className=\"w-3.5 h-3.5 text-[#7c5c63] absolute left-3 top-1/2 -translate-y-1/2\" />\n                  <input\n                    type=\"search\"\n                    value={searchQuery}\n                    onChange={(e) => setSearchQuery(e.target.value)}\n                    placeholder=\"Filter by keyword...\"\n                    className=\"pl-8 pr-3 py-1.5 rounded-full bg-white border border-[#f0d5da] text-xs focus:outline-none focus:border-[#9e5461]\"\n                  />\n                </div>\n\n                <label className=\"flex items-center gap-1.5 text-xs text-[#5c3d42] cursor-pointer select-none\">\n                  <input\n                    type=\"checkbox\"\n                    checked={showInStockOnly}\n                    onChange={(e) => setShowInStockOnly(e.target.checked)}\n                    className=\"rounded accent-[#9e5461]\"\n                  />\n                  <span>Ready-to-Ship Only</span>\n                </label>\n\n                <select\n                  value={sortBy}\n                  onChange={(e) => setSortBy(e.target.value as any)}\n                  aria-label=\"Sort products\"\n                  className=\"px-3 py-1.5 rounded-full bg-white border border-[#f0d5da] text-xs text-[#2d1e21] focus:outline-none focus:border-[#9e5461]\"\n                >\n                  <option value=\"featured\">Sort: Featured</option>\n                  <option value=\"price-asc\">Price: Low to High</option>\n                  <option value=\"price-desc\">Price: High to Low</option>\n                  <option value=\"newest\">Newest Arrivals</option>\n                </select>\n              </div>\n            </div>\n\n            {/* Category Filter Tabs */}\n            <div className=\"flex items-center gap-2 overflow-x-auto pb-1\">\n              <button\n                onClick={() => setSelectedCategorySlug(\'all\')}\n                className={`px-4 py-1.5 rounded-full text-xs font-medium transition-colors whitespace-nowrap ${\n                  selectedCategorySlug === \'all\'\n                    ? \'bg-[#9e5461] text-white\'\n                    : \'bg-white border border-[#f0d5da] text-[#5c3d42] hover:border-[#9e5461]\'\n                }`}\n              >\n                All Items\n              </button>\n              {categories.map((cat) => (\n                <button\n                  key={cat.id}\n                  onClick={() => setSelectedCategorySlug(cat.slug)}\n                  className={`px-4 py-1.5 rounded-full text-xs font-medium transition-colors whitespace-nowrap ${\n                    selectedCategorySlug === cat.slug\n                      ? \'bg-[#9e5461] text-white\'\n                      : \'bg-white border border-[#f0d5da] text-[#5c3d42] hover:border-[#9e5461]\'\n                  }`}\n                >\n                  {cat.name}\n                  {cat.status === \'coming-soon\' ? \' \302\267 Coming Soon\' : \'\'}\n                </button>\n              ))}\n            </div>\n\n            {/* Coming Soon Category Banner */}\n            {categories.find((c) => c.slug === selectedCategorySlug)?.status === \'coming-soon\' && (\n              <div className=\"rounded-2xl bg-[#fdf2f4] border border-[#f0d5da] p-8 text-center space-y-2\">\n                <Sparkles className=\"w-7 h-7 text-[#9e5461] mx-auto\" />\n                <h3 className=\"font-serif text-2xl font-semibold text-[#2d1e21]\">\n                  {categories.find((c) => c.slug === selectedCategorySlug)?.name} \342\200\224 Launching Soon\n                </h3>\n                <p className=\"text-xs text-[#5c3d42] max-w-md mx-auto\">\n                  Our Gurugram studio is curating and quality-testing this collection. Purchases are disabled for Coming Soon categories until official release.\n                </p>\n              </div>\n            )}\n\n            {loadingCatalogue ? (\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n                {[1, 2, 3, 4].map((n) => (\n                  <div\n                    key={n}\n                    className=\"h-80 rounded-2xl bg-[#fdf2f4]/60 animate-pulse border border-[#f0d5da]\"\n                  />\n                ))}\n              </div>\n            ) : filteredProducts.length === 0 ? (\n              <div className=\"rounded-2xl bg-white border border-[#f0d5da] p-12 text-center space-y-3\">\n                <p className=\"font-serif text-xl text-[#2d1e21]\">\n                  No products match your current filter.\n                </p>\n                <button\n                  onClick={() => {\n                    setSelectedCategorySlug(\'all\');\n                    setSearchQuery(\'\');\n                    setShowInStockOnly(false);\n                  }}\n                  className=\"px-4 py-2 rounded-full bg-[#9e5461] text-white text-xs font-medium\"\n                >\n                  Reset Filters\n                </button>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n                {filteredProducts.map((product) => (\n                  <ProductCard\n                    key={product.id}\n                    product={product}\n                    isWishlisted={wishlist.includes(product.id)}\n                    onToggleWishlist={() => toggleWishlist(product.id)}\n                    onSelect={() => navigateToProduct(product)}\n                    onAddToCart={() =>\n                      handleAddToCart(product, 1, product.variants?.[0]?.id || null)\n                    }\n                  />\n                ))}\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* SCREEN 6: PRODUCT DETAILS */}\n        {screen === \'product-details\' && currentProduct && (\n          <div className=\"space-y-8\">\n            <button\n              onClick={() => setScreen(\'shop\')}\n              className=\"text-xs text-[#7c5c63] hover:text-[#9e5461] flex items-center gap-1\"\n            >\n              <ArrowLeft className=\"w-3.5 h-3.5\" />\n              <span>Back to Catalogue</span>\n            </button>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 bg-white rounded-3xl border border-[#f0d5da] p-5 sm:p-8 shadow-2xs\">\n              {/* Image Gallery */}\n              <div className=\"lg:col-span-6 space-y-3\">\n                <div className=\"aspect-4/3 rounded-2xl overflow-hidden bg-[#fdf2f4] border border-[#f0d5da]\">\n                  <img\n                    src={\n                      currentProduct.images?.[activeImageIdx] ||\n                      currentProduct.images?.[0] ||\n                      PRODUCT_ARTWORK.heroBanner\n                    }\n                    alt={currentProduct.name}\n                    className=\"w-full h-full object-cover\"\n                  />\n                </div>\n                {currentProduct.images?.length > 1 && (\n                  <div className=\"flex items-center gap-2\">\n                    {currentProduct.images.map((imgUrl: string, idx: number) => (\n                      <button\n                        key={idx}\n                        onClick={() => setActiveImageIdx(idx)}\n                        className={`w-16 h-16 rounded-xl overflow-hidden border-2 ${\n                          activeImageIdx === idx ? \'border-[#9e5461]\' : \'border-transparent\'\n                        }`}\n                      >\n                        <img src={imgUrl} alt=\"\" className=\"w-full h-full object-cover\" />\n                      </button>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Product Details & Controls */}\n              <div className=\"lg:col-span-6 space-y-5\">\n                <div className=\"space-y-1.5\">\n                  <p className=\"text-xs text-[#9e5461] font-medium\">\n                    {currentProduct.category_name} \302\267 SKU: {currentProduct.sku}\n                  </p>\n                  <h1 className=\"font-serif text-3xl sm:text-4xl font-semibold text-[#2d1e21]\">\n                    {currentProduct.name}\n                  </h1>\n                  <div className=\"flex items-baseline gap-3 pt-1\">\n                    <span className=\"text-2xl font-semibold text-[#2d1e21] font-tabular\">\n                      {formatInrFromPaise(\n                        currentProduct.selling_price_paise +\n                          (currentProduct.variants?.find((v: any) => v.id === selectedVariantId)\n                            ?.price_delta_paise || 0)\n                      )}\n                    </span>\n                    <span className=\"text-xs text-[#7c5c63]\">\n                      Inclusive of all taxes\n                    </span>\n                  </div>\n                </div>\n\n                {/* Availability Status */}\n                <div className=\"text-xs text-[#5c3d42]\">\n                  {currentProduct.status === \'active\' && currentProduct.stock_quantity > 0 ? (\n                    <span className=\"text-emerald-800 font-medium\">\n                      In Stock ({currentProduct.stock_quantity} units ready in Gurugram warehouse)\n                    </span>\n                  ) : currentProduct.status === \'draft\' ? (\n                    <span className=\"text-amber-800 font-medium\">\n                      Draft Catalogue Entry \342\200\224 Proposed Price {formatInrFromPaise(currentProduct.selling_price_paise)}. Awaiting admin confirmation before orders open.\n                    </span>\n                  ) : currentProduct.status === \'coming-soon\' ? (\n                    <span className=\"text-[#9e5461] font-medium\">\n                      Coming Soon \342\200\224 Not yet open for purchase\n                    </span>\n                  ) : (\n                    <span className=\"text-rose-700 font-medium\">Currently Out of Stock</span>\n                  )}\n                </div>\n\n                <p className=\"text-sm text-[#5c3d42] leading-relaxed\">\n                  {currentProduct.description}\n                </p>\n\n                {/* Variant Selection */}\n                {currentProduct.variants?.length > 0 && (\n                  <div className=\"space-y-2\">\n                    <label className=\"text-xs font-semibold uppercase tracking-wider text-[#7c5c63] block\">\n                      Select Option\n                    </label>\n                    <div className=\"flex flex-wrap gap-2\">\n                      {currentProduct.variants.map((v: any) => (\n                        <button\n                          key={v.id}\n                          onClick={() => setSelectedVariantId(v.id)}\n                          className={`px-3.5 py-2 rounded-xl text-xs font-medium border transition-colors ${\n                            selectedVariantId === v.id\n                              ? \'bg-[#9e5461] text-white border-[#9e5461]\'\n                              : \'bg-white text-[#2d1e21] border-[#f0d5da] hover:border-[#9e5461]\'\n                          }`}\n                        >\n                          {v.variant_name}: {v.variant_value}\n                          {v.price_delta_paise > 0\n                            ? ` (+${formatInrFromPaise(v.price_delta_paise)})`\n                            : \'\'}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n                )}\n\n                {/* Quantity & Add to Cart */}\n                {currentProduct.status === \'active\' && currentProduct.stock_quantity > 0 ? (\n                  <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n                    <div className=\"flex items-center border border-[#f0d5da] rounded-full bg-[#fffdfb]\">\n                      <button\n                        onClick={() => setDetailQty((q) => Math.max(1, q - 1))}\n                        aria-label=\"Decrease quantity\"\n                        className=\"p-2.5 text-[#5c3d42] hover:text-[#9e5461]\"\n                      >\n                        <Minus className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <span className=\"px-4 text-sm font-medium font-tabular\">{detailQty}</span>\n                      <button\n                        onClick={() =>\n                          setDetailQty((q) => Math.min(currentProduct.stock_quantity, q + 1))\n                        }\n                        aria-label=\"Increase quantity\"\n                        className=\"p-2.5 text-[#5c3d42] hover:text-[#9e5461]\"\n                      >\n                        <Plus className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n\n                    <button\n                      onClick={() =>\n                        handleAddToCart(currentProduct, detailQty, selectedVariantId)\n                      }\n                      data-testid=\"detail-add-to-cart\"\n                      className=\"flex-1 py-3 px-6 rounded-full bg-[#9e5461] hover:bg-[#84414d] text-white text-sm font-medium transition-colors flex items-center justify-center gap-2 whitespace-nowrap\"\n                    >\n                      <ShoppingBag className=\"w-4 h-4\" />\n                      <span>Add to Shopping Bag</span>\n                    </button>\n\n                    <button\n                      onClick={() => toggleWishlist(currentProduct.id)}\n                      aria-label=\"Toggle Wishlist\"\n                      className={`p-3 rounded-full border ${\n                        wishlist.includes(currentProduct.id)\n                          ? \'bg-[#fdf2f4] border-[#9e5461] text-[#9e5461]\'\n                          : \'border-[#f0d5da] text-[#5c3d42]\'\n                      }`}\n                    >\n                      <Heart className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"p-4 rounded-2xl bg-[#fdf2f4] border border-[#f0d5da] text-xs text-[#5c3d42]\">\n                    Ordering is locked while this item is in{\' \'}\n                    <strong className=\"uppercase\">{currentProduct.status}</strong> status.\n                  </div>\n                )}\n\n                {/* Indian PIN Code Serviceability Check */}\n                <div className=\"pt-4 border-t border-[#f0d5da] space-y-2\">\n                  <label className=\"text-xs font-semibold text-[#2d1e21] flex items-center gap-1.5\">\n                    <Truck className=\"w-4 h-4 text-[#9e5461]\" />\n                    <span>Check Delivery Serviceability (Dispatched from Gurugram 122001)</span>\n                  </label>\n                  <div className=\"flex items-center gap-2 max-w-sm\">\n                    <input\n                      type=\"text\"\n                      maxLength={6}\n                      value={pinCheckInput}\n                      onChange={(e) => setPinCheckInput(e.target.value.replace(/\\D/g, \'\'))}\n                      placeholder=\"Enter 6-digit PIN code\"\n                      className=\"flex-1 px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular focus:outline-none focus:border-[#9e5461]\"\n                    />\n                    <button\n                      onClick={handleCheckPinServiceability}\n                      className=\"px-4 py-2 rounded-xl bg-[#fdf2f4] hover:bg-[#9e5461] text-[#9e5461] hover:text-white text-xs font-medium transition-colors whitespace-nowrap\"\n                    >\n                      Check PIN\n                    </button>\n                  </div>\n                  {pinCheckResult && (\n                    <p\n                      className={`text-xs ${\n                        pinCheckResult.serviceable ? \'text-emerald-800\' : \'text-rose-700\'\n                      }`}\n                    >\n                      {pinCheckResult.serviceable\n                        ? `Serviceable to ${pinCheckResult.city}, ${pinCheckResult.state} (${pinCheckResult.pinCode}) \302\267 ${pinCheckResult.note}`\n                        : pinCheckResult.message}\n                    </p>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* SCREEN 7: WISHLIST */}\n        {screen === \'wishlist\' && (\n          <div className=\"space-y-6\">\n            <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n              My Saved Wishlist ({wishlist.length})\n            </h1>\n            {wishlist.length === 0 ? (\n              <div className=\"rounded-3xl bg-white border border-[#f0d5da] p-12 text-center space-y-3\">\n                <Heart className=\"w-8 h-8 text-[#9e5461] mx-auto\" />\n                <p className=\"font-serif text-xl text-[#2d1e21]\">\n                  Your Pretty Charm wishlist is empty.\n                </p>\n                <button\n                  onClick={() => setScreen(\'shop\')}\n                  className=\"px-5 py-2.5 rounded-full bg-[#9e5461] text-white text-xs font-medium\"\n                >\n                  Explore Accessories &amp; Jewellery\n                </button>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n                {products\n                  .filter((p) => wishlist.includes(p.id))\n                  .map((product) => (\n                    <ProductCard\n                      key={product.id}\n                      product={product}\n                      isWishlisted={true}\n                      onToggleWishlist={() => toggleWishlist(product.id)}\n                      onSelect={() => navigateToProduct(product)}\n                      onAddToCart={() =>\n                        handleAddToCart(product, 1, product.variants?.[0]?.id || null)\n                      }\n                    />\n                  ))}\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* SCREEN 8: CART */}\n        {screen === \'cart\' && (\n          <div className=\"space-y-6\">\n            <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n              Your Shopping Bag\n            </h1>\n\n            {hydratedCart.length === 0 ? (\n              <div className=\"rounded-3xl bg-white border border-[#f0d5da] p-12 text-center space-y-3\">\n                <ShoppingBag className=\"w-8 h-8 text-[#9e5461] mx-auto\" />\n                <p className=\"font-serif text-xl text-[#2d1e21]\">\n                  Your shopping bag is currently empty.\n                </p>\n                <p className=\"text-xs text-[#7c5c63]\">\n                  Add satin hair claws, mulberry scrunchies or rose-gold jewellery to begin.\n                </p>\n                <button\n                  onClick={() => setScreen(\'shop\')}\n                  className=\"px-5 py-2.5 rounded-full bg-[#9e5461] text-white text-xs font-medium\"\n                >\n                  Shop Collection\n                </button>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n                <div className=\"lg:col-span-8 space-y-4\">\n                  {hydratedCart.map((item) => (\n                    <div\n                      key={`${item.productId}-${item.variantId || \'default\'}`}\n                      className=\"rounded-2xl bg-white border border-[#f0d5da] p-4 flex items-center gap-4\"\n                    >\n                      <img\n                        src={item.product.images?.[0] || PRODUCT_ARTWORK.heroBanner}\n                        alt={item.product.name}\n                        className=\"w-20 h-20 rounded-xl object-cover bg-[#fdf2f4] shrink-0\"\n                      />\n                      <div className=\"flex-1 min-w-0\">\n                        <h3 className=\"font-serif text-lg font-semibold text-[#2d1e21] truncate\">\n                          {item.product.name}\n                        </h3>\n                        {item.variantName && (\n                          <p className=\"text-xs text-[#7c5c63]\">{item.variantName}</p>\n                        )}\n                        <p className=\"text-xs text-[#9e5461] font-tabular mt-1\">\n                          {formatInrFromPaise(item.unitPricePaise)} each\n                        </p>\n                      </div>\n\n                      <div className=\"flex items-center border border-[#f0d5da] rounded-full\">\n                        <button\n                          onClick={() => updateCartItemQty(item.productId, item.variantId, -1)}\n                          aria-label=\"Decrease quantity\"\n                          className=\"p-2 text-[#5c3d42] hover:text-[#9e5461]\"\n                        >\n                          <Minus className=\"w-3 h-3\" />\n                        </button>\n                        <span className=\"px-3 text-xs font-medium font-tabular\">\n                          {item.quantity}\n                        </span>\n                        <button\n                          onClick={() => updateCartItemQty(item.productId, item.variantId, 1)}\n                          aria-label=\"Increase quantity\"\n                          className=\"p-2 text-[#5c3d42] hover:text-[#9e5461]\"\n                        >\n                          <Plus className=\"w-3 h-3\" />\n                        </button>\n                      </div>\n\n                      <div className=\"text-right\">\n                        <p className=\"text-sm font-semibold text-[#2d1e21] font-tabular\">\n                          {formatInrFromPaise(item.lineTotalPaise)}\n                        </p>\n                        <button\n                          onClick={() =>\n                            updateCartItemQty(item.productId, item.variantId, -item.quantity)\n                          }\n                          className=\"text-[11px] text-rose-700 hover:underline mt-1\"\n                        >\n                          Remove\n                        </button>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n\n                {/* Order Summary Box */}\n                <div className=\"lg:col-span-4\">\n                  <div className=\"rounded-3xl bg-white border border-[#f0d5da] p-6 space-y-4\">\n                    <h2 className=\"font-serif text-2xl font-semibold text-[#2d1e21]\">\n                      Order Summary\n                    </h2>\n\n                    {/* Coupon Input */}\n                    <div className=\"space-y-1.5\">\n                      <div className=\"flex gap-2\">\n                        <input\n                          type=\"text\"\n                          value={couponInput}\n                          onChange={(e) => setCouponInput(e.target.value.toUpperCase())}\n                          placeholder=\"Promo code (e.g. PRETTY10)\"\n                          className=\"flex-1 px-3 py-2 rounded-xl border border-[#f0d5da] text-xs uppercase\"\n                        />\n                        <button\n                          onClick={handleApplyCoupon}\n                          className=\"px-3.5 py-2 rounded-xl bg-[#fdf2f4] text-[#9e5461] text-xs font-medium whitespace-nowrap\"\n                        >\n                          Apply\n                        </button>\n                      </div>\n                      {couponError && <p className=\"text-[11px] text-rose-700\">{couponError}</p>}\n                      {appliedCoupon && (\n                        <p className=\"text-[11px] text-emerald-800\">\n                          Code {appliedCoupon.code} applied (-\n                          {formatInrFromPaise(appliedCoupon.discountPaise)})\n                        </p>\n                      )}\n                    </div>\n\n                    <div className=\"space-y-2 text-xs border-t border-[#f0d5da] pt-3\">\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-[#7c5c63]\">Subtotal</span>\n                        <span className=\"font-medium font-tabular\">\n                          {formatInrFromPaise(cartSubtotalPaise)}\n                        </span>\n                      </div>\n                      {discountPaise > 0 && (\n                        <div className=\"flex justify-between text-emerald-800\">\n                          <span>Discount ({appliedCoupon?.code})</span>\n                          <span className=\"font-tabular\">-{formatInrFromPaise(discountPaise)}</span>\n                        </div>\n                      )}\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-[#7c5c63]\">\n                          Pan-India Shipping (from Gurugram)\n                        </span>\n                        <span className=\"font-medium font-tabular\">\n                          {shippingPaise === 0 ? \'FREE\' : formatInrFromPaise(shippingPaise)}\n                        </span>\n                      </div>\n                      <div className=\"flex justify-between text-sm font-semibold text-[#2d1e21] border-t border-[#f0d5da] pt-2.5\">\n                        <span>Total Payable (INR)</span>\n                        <span data-testid=\"cart-grand-total\" className=\"font-tabular\">\n                          {formatInrFromPaise(grandTotalPaise)}\n                        </span>\n                      </div>\n                    </div>\n\n                    <p className=\"text-[11px] text-[#7c5c63]\">\n                      {discountedSubtotalPaise < 49900\n                        ? `Add ${formatInrFromPaise(49900 - discountedSubtotalPaise)} more to reduce shipping to \342\202\27139, or ${formatInrFromPaise(99900 - discountedSubtotalPaise)} for FREE shipping.`\n                        : discountedSubtotalPaise < 99900\n                        ? `Add ${formatInrFromPaise(99900 - discountedSubtotalPaise)} more for FREE shipping!`\n                        : \'Your order qualifies for FREE Pan-India shipping!\'}\n                    </p>\n\n                    <button\n                      onClick={() => setScreen(\'checkout\')}\n                      data-testid=\"proceed-to-checkout-btn\"\n                      className=\"w-full py-3.5 rounded-full bg-[#9e5461] hover:bg-[#84414d] text-white text-sm font-medium transition-colors whitespace-nowrap\"\n                    >\n                      Proceed to Checkout (Guest or Account)\n                    </button>\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* SCREEN 9: CHECKOUT AND ADDRESS ENTRY */}\n        {screen === \'checkout\' && (\n          <div className=\"max-w-4xl mx-auto space-y-6\">\n            <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n              Secure Checkout \302\267 Indian Delivery Address\n            </h1>\n\n            {customerAddresses.length > 0 && (\n              <div className=\"rounded-2xl bg-[#fdf2f4] border border-[#f0d5da] p-4 space-y-2\">\n                <p className=\"text-xs font-semibold text-[#9e5461]\">\n                  Use a Saved Address from Your Account:\n                </p>\n                <div className=\"flex flex-wrap gap-2\">\n                  {customerAddresses.map((addr: any) => (\n                    <button\n                      key={addr.id}\n                      type=\"button\"\n                      onClick={() =>\n                        setCheckoutForm((prev) => ({\n                          ...prev,\n                          fullName: addr.full_name,\n                          phone: addr.phone,\n                          houseLine1: addr.house_line1,\n                          streetLine2: addr.street_line2 || \'\',\n                          landmark: addr.landmark || \'\',\n                          city: addr.city,\n                          state: addr.state,\n                          pinCode: addr.pin_code\n                        }))\n                      }\n                      className=\"px-3 py-1.5 rounded-xl bg-white border border-[#e5c2c9] text-xs text-[#2d1e21] hover:border-[#9e5461]\"\n                    >\n                      {addr.label}: {addr.full_name} ({addr.pin_code})\n                    </button>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            <form\n              onSubmit={handlePlaceOrder}\n              className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\"\n            >\n              <div className=\"lg:col-span-7 rounded-3xl bg-white border border-[#f0d5da] p-6 space-y-4\">\n                <h2 className=\"font-serif text-xl font-semibold text-[#2d1e21]\">\n                  1. Recipient &amp; Shipping Address\n                </h2>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"text-xs text-[#5c3d42] block mb-1\">Full Name *</label>\n                    <input\n                      required\n                      name=\"fullName\"\n                      value={checkoutForm.fullName}\n                      onChange={(e) =>\n                        setCheckoutForm({ ...checkoutForm, fullName: e.target.value })\n                      }\n                      placeholder=\"Ananya Sharma\"\n                      className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-xs text-[#5c3d42] block mb-1\">\n                      10-Digit Indian Mobile *\n                    </label>\n                    <input\n                      required\n                      name=\"phone\"\n                      maxLength={10}\n                      value={checkoutForm.phone}\n                      onChange={(e) =>\n                        setCheckoutForm({\n                          ...checkoutForm,\n                          phone: e.target.value.replace(/\\D/g, \'\')\n                        })\n                      }\n                      placeholder=\"9876543210\"\n                      className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"text-xs text-[#5c3d42] block mb-1\">\n                    Email Address (Optional for order updates)\n                  </label>\n                  <input\n                    type=\"email\"\n                    name=\"email\"\n                    value={checkoutForm.email}\n                    onChange={(e) =>\n                      setCheckoutForm({ ...checkoutForm, email: e.target.value })\n                    }\n                    placeholder=\"ananya@example.com\"\n                    className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs text-[#5c3d42] block mb-1\">\n                    House / Flat / Building No. *\n                  </label>\n                  <input\n                    required\n                    name=\"houseLine1\"\n                    value={checkoutForm.houseLine1}\n                    onChange={(e) =>\n                      setCheckoutForm({ ...checkoutForm, houseLine1: e.target.value })\n                    }\n                    placeholder=\"Flat 402, Tower B, DLF Phase 4\"\n                    className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                  />\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"text-xs text-[#5c3d42] block mb-1\">\n                      Street / Sector / Locality\n                    </label>\n                    <input\n                      name=\"streetLine2\"\n                      value={checkoutForm.streetLine2}\n                      onChange={(e) =>\n                        setCheckoutForm({ ...checkoutForm, streetLine2: e.target.value })\n                      }\n                      placeholder=\"Sector 28, Galleria Market Road\"\n                      className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-xs text-[#5c3d42] block mb-1\">Landmark</label>\n                    <input\n                      name=\"landmark\"\n                      value={checkoutForm.landmark}\n                      onChange={(e) =>\n                        setCheckoutForm({ ...checkoutForm, landmark: e.target.value })\n                      }\n                      placeholder=\"Near Hamilton Court\"\n                      className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                    />\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div>\n                    <label className=\"text-xs text-[#5c3d42] block mb-1\">City *</label>\n                    <input\n                      required\n                      name=\"city\"\n                      value={checkoutForm.city}\n                      onChange={(e) =>\n                        setCheckoutForm({ ...checkoutForm, city: e.target.value })\n                      }\n                      className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-xs text-[#5c3d42] block mb-1\">State / UT *</label>\n                    <select\n                      value={checkoutForm.state}\n                      onChange={(e) =>\n                        setCheckoutForm({ ...checkoutForm, state: e.target.value })\n                      }\n                      className=\"w-full px-3 py-2 rounded-xl border border-[#f0d5da] text-xs bg-white\"\n                    >\n                      {INDIAN_STATES_AND_UTS.map((st) => (\n                        <option key={st} value={st}>\n                          {st}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n                  <div>\n                    <label className=\"text-xs text-[#5c3d42] block mb-1\">6-Digit PIN Code *</label>\n                    <input\n                      required\n                      name=\"pinCode\"\n                      maxLength={6}\n                      value={checkoutForm.pinCode}\n                      onChange={(e) =>\n                        setCheckoutForm({\n                          ...checkoutForm,\n                          pinCode: e.target.value.replace(/\\D/g, \'\')\n                        })\n                      }\n                      className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"text-xs text-[#5c3d42] block mb-1\">\n                    Gift Message / Delivery Instructions (Optional)\n                  </label>\n                  <textarea\n                    rows={2}\n                    value={checkoutForm.deliveryNotes}\n                    onChange={(e) =>\n                      setCheckoutForm({ ...checkoutForm, deliveryNotes: e.target.value })\n                    }\n                    placeholder=\"Add a handwritten gift card note or gate instructions...\"\n                    className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                  />\n                </div>\n              </div>\n\n              {/* Payment Method & Final Confirmation */}\n              <div className=\"lg:col-span-5 space-y-4\">\n                <div className=\"rounded-3xl bg-white border border-[#f0d5da] p-6 space-y-4\">\n                  <h2 className=\"font-serif text-xl font-semibold text-[#2d1e21]\">\n                    2. Payment Method\n                  </h2>\n\n                  <div className=\"space-y-2.5 text-xs\">\n                    <label className=\"flex items-start gap-2.5 p-3 rounded-2xl border border-[#f0d5da] cursor-pointer hover:border-[#9e5461]\">\n                      <input\n                        type=\"radio\"\n                        name=\"paymentMethod\"\n                        value=\"manual_upi\"\n                        checked={checkoutForm.paymentMethod === \'manual_upi\'}\n                        onChange={(e) =>\n                          setCheckoutForm({ ...checkoutForm, paymentMethod: e.target.value })\n                        }\n                        className=\"mt-0.5 accent-[#9e5461]\"\n                      />\n                      <div>\n                        <p className=\"font-semibold text-[#2d1e21]\">\n                          Manual UPI Transfer ({settings.manual_upi_id || \'prettycharm@upi\'})\n                        </p>\n                        <p className=\"text-[#7c5c63] mt-0.5\">\n                          Submit your 12-digit UTR after transfer. Order status remains Pending Verification until verified by Admin.\n                        </p>\n                      </div>\n                    </label>\n\n                    <label className=\"flex items-start gap-2.5 p-3 rounded-2xl border border-[#f0d5da] cursor-pointer hover:border-[#9e5461]\">\n                      <input\n                        type=\"radio\"\n                        name=\"paymentMethod\"\n                        value=\"cod\"\n                        checked={checkoutForm.paymentMethod === \'cod\'}\n                        onChange={(e) =>\n                          setCheckoutForm({ ...checkoutForm, paymentMethod: e.target.value })\n                        }\n                        className=\"mt-0.5 accent-[#9e5461]\"\n                      />\n                      <div>\n                        <p className=\"font-semibold text-[#2d1e21]\">\n                          Cash on Delivery (COD)\n                        </p>\n                        <p className=\"text-[#7c5c63] mt-0.5\">\n                          Pay in cash or UPI to the courier partner upon delivery at your doorstep.\n                        </p>\n                      </div>\n                    </label>\n                  </div>\n\n                  <div className=\"border-t border-[#f0d5da] pt-3 space-y-1.5 text-xs\">\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-[#7c5c63]\">Items Subtotal</span>\n                      <span className=\"font-tabular\">{formatInrFromPaise(cartSubtotalPaise)}</span>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-[#7c5c63]\">Shipping (from Gurugram)</span>\n                      <span className=\"font-tabular\">\n                        {shippingPaise === 0 ? \'FREE\' : formatInrFromPaise(shippingPaise)}\n                      </span>\n                    </div>\n                    <div className=\"flex justify-between text-sm font-semibold text-[#2d1e21] pt-1\">\n                      <span>Grand Total</span>\n                      <span className=\"font-tabular\">{formatInrFromPaise(grandTotalPaise)}</span>\n                    </div>\n                  </div>\n\n                  {checkoutError && (\n                    <div className=\"p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-800\">\n                      {checkoutError}\n                    </div>\n                  )}\n\n                  <button\n                    type=\"submit\"\n                    disabled={submittingOrder}\n                    data-testid=\"place-order-submit-btn\"\n                    className=\"w-full py-3.5 rounded-full bg-[#9e5461] hover:bg-[#84414d] text-white text-sm font-medium transition-colors disabled:opacity-50 whitespace-nowrap\"\n                  >\n                    {submittingOrder\n                      ? \'Reserving Stock & Creating Order...\'\n                      : `Place Order \302\267 ${formatInrFromPaise(grandTotalPaise)}`}\n                  </button>\n                </div>\n              </div>\n            </form>\n          </div>\n        )}\n\n        {/* SCREEN 10: PAYMENT INSTRUCTIONS / PAYMENT STATUS */}\n        {screen === \'payment-status\' && lastCreatedOrder && (\n          <div className=\"max-w-xl mx-auto rounded-3xl bg-white border border-[#f0d5da] p-6 sm:p-8 space-y-5\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs uppercase tracking-wider text-[#9e5461] font-semibold\">\n                Order #{lastCreatedOrder.orderNumber}\n              </span>\n              <span className=\"text-xs font-medium text-amber-800\">\n                Payment Status: {lastCreatedOrder.paymentStatus}\n              </span>\n            </div>\n\n            <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n              Complete Your Manual UPI Payment\n            </h1>\n\n            <p className=\"text-xs text-[#5c3d42] leading-relaxed\">\n              Your stock has been reserved. Please transfer{\' \'}\n              <strong className=\"font-tabular text-[#2d1e21]\">\n                {formatInrFromPaise(lastCreatedOrder.grandTotalPaise)}\n              </strong>{\' \'}\n              to our official UPI ID below and submit your 12-digit UPI Reference / UTR number.\n              In accordance with Pretty Charm financial controls, orders are never marked Paid until our Admin team verifies the credit in our bank statement.\n            </p>\n\n            <div className=\"p-4 rounded-2xl bg-[#fdf2f4] border border-[#f0d5da] space-y-1\">\n              <p className=\"text-xs text-[#7c5c63]\">Official Pretty Charm UPI Handle</p>\n              <p className=\"text-lg font-semibold text-[#9e5461] font-tabular\">\n                {settings.manual_upi_id || \'prettycharm@upi\'}\n              </p>\n              <p className=\"text-xs text-[#7c5c63]\">\n                Payee: {settings.manual_upi_payee_name || \'Pretty Charm Studio\'}\n              </p>\n            </div>\n\n            <form onSubmit={handleSubmitUtrReference} className=\"space-y-3\">\n              <label className=\"text-xs font-medium text-[#2d1e21] block\">\n                Enter 12-Digit UPI UTR / Transaction Reference Number\n              </label>\n              <div className=\"flex gap-2\">\n                <input\n                  required\n                  value={utrReferenceInput}\n                  onChange={(e) => setUtrReferenceInput(e.target.value)}\n                  placeholder=\"e.g. 412389012345\"\n                  className=\"flex-1 px-3.5 py-2.5 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                />\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2.5 rounded-xl bg-[#9e5461] text-white text-xs font-medium whitespace-nowrap\"\n                >\n                  Submit UTR\n                </button>\n              </div>\n              {utrSubmittedMsg && (\n                <p className=\"text-xs text-emerald-800\">{utrSubmittedMsg}</p>\n              )}\n            </form>\n\n            <div className=\"pt-3 border-t border-[#f0d5da] flex justify-end\">\n              <button\n                onClick={() => setScreen(\'order-success\')}\n                className=\"px-5 py-2.5 rounded-full bg-[#2d1e21] text-white text-xs font-medium whitespace-nowrap\"\n              >\n                View Order Confirmation Summary \342\206\222\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* SCREEN 11: ORDER SUCCESS AND ORDER DETAILS */}\n        {screen === \'order-success\' && lastCreatedOrder && (\n          <div className=\"max-w-xl mx-auto rounded-3xl bg-white border border-[#f0d5da] p-6 sm:p-8 space-y-5\">\n            <div className=\"w-12 h-12 rounded-full bg-[#fdf2f4] text-[#9e5461] flex items-center justify-center\">\n              <CheckCircle2 className=\"w-6 h-6\" />\n            </div>\n\n            <div className=\"space-y-1\">\n              <p className=\"text-xs uppercase tracking-[0.18em] text-[#9e5461] font-semibold\">\n                Order Recorded \302\267 Gurugram Fulfilment Queue\n              </p>\n              <h1\n                data-testid=\"order-success-heading\"\n                className=\"font-serif text-3xl text-[#2d1e21] font-semibold\"\n              >\n                Thank You for Your Order!\n              </h1>\n            </div>\n\n            <div className=\"rounded-2xl bg-[#fdf2f4]/60 border border-[#f0d5da] p-4 space-y-2 text-xs\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#7c5c63]\">Order Number</span>\n                <span\n                  data-testid=\"confirmed-order-number\"\n                  className=\"font-semibold text-[#2d1e21] font-tabular\"\n                >\n                  {lastCreatedOrder.orderNumber}\n                </span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#7c5c63]\">Order Status</span>\n                <span className=\"font-medium text-[#9e5461]\">\n                  {lastCreatedOrder.orderStatus}\n                </span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#7c5c63]\">Payment Status</span>\n                <span className=\"font-medium text-amber-800\">\n                  {lastCreatedOrder.paymentStatus}\n                </span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#7c5c63]\">Total Payable</span>\n                <span className=\"font-semibold font-tabular\">\n                  {formatInrFromPaise(lastCreatedOrder.grandTotalPaise)}\n                </span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#7c5c63]\">Delivery Estimate</span>\n                <span className=\"text-[#5c3d42]\">\n                  {formatHonestDeliveryEta(null)}\n                </span>\n              </div>\n            </div>\n\n            <div className=\"flex flex-wrap gap-3 pt-2\">\n              <button\n                onClick={() => {\n                  setTrackOrderForm({\n                    orderNumber: lastCreatedOrder.orderNumber,\n                    phone: lastCreatedOrder.customerPhone\n                  });\n                  setScreen(\'track-order\');\n                }}\n                data-testid=\"track-this-order-btn\"\n                className=\"px-5 py-2.5 rounded-full bg-[#9e5461] text-white text-xs font-medium whitespace-nowrap\"\n              >\n                Track This Order\n              </button>\n              <a\n                href={buildWhatsAppSupportUrl(\n                  settings.whatsapp_support_number || \'919876543210\',\n                  `Hello Pretty Charm, I placed Order ${lastCreatedOrder.orderNumber} and would like an update.`\n                )}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"px-5 py-2.5 rounded-full bg-emerald-700 text-white text-xs font-medium flex items-center gap-1.5 whitespace-nowrap\"\n              >\n                <MessageCircle className=\"w-3.5 h-3.5\" />\n                <span>WhatsApp Support</span>\n              </a>\n            </div>\n          </div>\n        )}\n\n        {/* SCREEN 12: TRACK MY ORDER */}\n        {screen === \'track-order\' && (\n          <div className=\"max-w-2xl mx-auto space-y-6\">\n            <div>\n              <p className=\"text-xs uppercase tracking-[0.18em] text-[#9e5461] font-semibold\">\n                Real-Time Shipment &amp; Fulfilment Status\n              </p>\n              <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n                Track My Pretty Charm Order\n              </h1>\n              <p className=\"text-xs text-[#7c5c63] mt-1\">\n                For customer privacy, both your Order ID and the 10-digit recipient mobile number used at checkout are required.\n              </p>\n            </div>\n\n            <form\n              onSubmit={handleTrackOrder}\n              className=\"rounded-3xl bg-white border border-[#f0d5da] p-6 grid grid-cols-1 sm:grid-cols-3 gap-3 items-end\"\n            >\n              <div>\n                <label className=\"text-xs text-[#5c3d42] block mb-1\">Order Number *</label>\n                <input\n                  required\n                  name=\"orderNumber\"\n                  value={trackOrderForm.orderNumber}\n                  onChange={(e) =>\n                    setTrackOrderForm({ ...trackOrderForm, orderNumber: e.target.value })\n                  }\n                  placeholder=\"PC-202505-1234\"\n                  className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                />\n              </div>\n              <div>\n                <label className=\"text-xs text-[#5c3d42] block mb-1\">\n                  10-Digit Mobile Number *\n                </label>\n                <input\n                  required\n                  name=\"phone\"\n                  value={trackOrderForm.phone}\n                  onChange={(e) =>\n                    setTrackOrderForm({ ...trackOrderForm, phone: e.target.value })\n                  }\n                  placeholder=\"9876543210\"\n                  className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                />\n              </div>\n              <button\n                type=\"submit\"\n                data-testid=\"track-order-submit-btn\"\n                className=\"py-2.5 px-5 rounded-xl bg-[#9e5461] text-white text-xs font-medium whitespace-nowrap\"\n              >\n                Verify &amp; Track\n              </button>\n            </form>\n\n            {trackOrderError && (\n              <div className=\"p-4 rounded-2xl bg-rose-50 border border-rose-200 text-xs text-rose-800\">\n                {trackOrderError}\n              </div>\n            )}\n\n            {trackedOrderResult && (\n              <div\n                data-testid=\"tracked-order-card\"\n                className=\"rounded-3xl bg-white border border-[#f0d5da] p-6 space-y-5\"\n              >\n                <div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#f0d5da] pb-4\">\n                  <div>\n                    <p className=\"text-xs text-[#7c5c63]\">Order ID</p>\n                    <p className=\"text-lg font-semibold text-[#2d1e21] font-tabular\">\n                      {trackedOrderResult.order.orderNumber}\n                    </p>\n                  </div>\n                  <div className=\"text-right\">\n                    <p className=\"text-xs text-[#9e5461] font-semibold\">\n                      Order Status: {trackedOrderResult.order.orderStatus}\n                    </p>\n                    <p className=\"text-xs text-[#7c5c63]\">\n                      Payment: {trackedOrderResult.order.paymentStatus}\n                    </p>\n                  </div>\n                </div>\n\n                {/* Honest Delivery Estimate */}\n                <div className=\"p-4 rounded-2xl bg-[#fdf2f4] border border-[#f0d5da] flex items-center justify-between\">\n                  <div>\n                    <p className=\"text-xs font-semibold text-[#2d1e21]\">\n                      Estimated Delivery\n                    </p>\n                    <p\n                      data-testid=\"tracked-order-eta\"\n                      className=\"text-xs text-[#5c3d42] mt-0.5\"\n                    >\n                      {trackedOrderResult.shipment?.estimatedDeliveryText ||\n                        \'Estimated delivery not available yet.\'}\n                    </p>\n                  </div>\n                  {trackedOrderResult.shipment?.awbCode && (\n                    <div className=\"text-right text-xs\">\n                      <p className=\"font-medium text-[#2d1e21]\">\n                        {trackedOrderResult.shipment.courierName}\n                      </p>\n                      <p className=\"font-tabular text-[#7c5c63]\">\n                        AWB: {trackedOrderResult.shipment.awbCode}\n                      </p>\n                    </div>\n                  )}\n                </div>\n\n                {/* Authentic Timeline Events */}\n                <div className=\"space-y-3\">\n                  <h3 className=\"font-serif text-lg font-semibold text-[#2d1e21]\">\n                    Verified Fulfilment Timeline\n                  </h3>\n                  <div className=\"space-y-2.5\">\n                    {trackedOrderResult.timeline.map((ev: any) => (\n                      <div\n                        key={ev.id}\n                        className=\"flex items-start justify-between text-xs border-b border-[#f0d5da]/60 pb-2\"\n                      >\n                        <div>\n                          <p className=\"font-semibold text-[#2d1e21]\">{ev.status_label}</p>\n                          {ev.details && <p className=\"text-[#7c5c63]\">{ev.details}</p>}\n                          {ev.location && <p className=\"text-[#9e5461]\">{ev.location}</p>}\n                        </div>\n                        <span className=\"text-[11px] text-[#7c5c63] font-tabular\">\n                          {new Date(ev.created_at).toLocaleString(\'en-IN\')}\n                        </span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* SCREEN 2: SIGN-UP / LOGIN SCREEN */}\n        {screen === \'auth\' && (\n          <div className=\"max-w-md mx-auto rounded-3xl bg-white border border-[#f0d5da] p-6 sm:p-8 space-y-5\">\n            <div className=\"text-center space-y-1\">\n              <p className=\"text-xs uppercase tracking-[0.2em] text-[#9e5461] font-semibold\">\n                Pretty Charm Member Club\n              </p>\n              <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n                {authMode === \'login\' ? \'Welcome Back\' : \'Create Your Account\'}\n              </h1>\n              <p className=\"text-xs text-[#7c5c63]\">\n                Accounts are optional \342\200\224 you can always check out as a guest.\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 rounded-full bg-[#fdf2f4] p-1 text-xs font-medium\">\n              <button\n                onClick={() => setAuthMode(\'login\')}\n                className={`py-2 rounded-full transition-colors ${\n                  authMode === \'login\' ? \'bg-[#9e5461] text-white\' : \'text-[#5c3d42]\'\n                }`}\n              >\n                Sign In\n              </button>\n              <button\n                onClick={() => setAuthMode(\'register\')}\n                className={`py-2 rounded-full transition-colors ${\n                  authMode === \'register\' ? \'bg-[#9e5461] text-white\' : \'text-[#5c3d42]\'\n                }`}\n              >\n                Create Account\n              </button>\n            </div>\n\n            <form onSubmit={handleCustomerAuth} className=\"space-y-3\">\n              {authMode === \'register\' && (\n                <div>\n                  <label className=\"text-xs text-[#5c3d42] block mb-1\">Full Name *</label>\n                  <input\n                    required\n                    value={authForm.name}\n                    onChange={(e) => setAuthForm({ ...authForm, name: e.target.value })}\n                    className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                  />\n                </div>\n              )}\n              <div>\n                <label className=\"text-xs text-[#5c3d42] block mb-1\">Email Address *</label>\n                <input\n                  required\n                  type=\"email\"\n                  value={authForm.email}\n                  onChange={(e) => setAuthForm({ ...authForm, email: e.target.value })}\n                  className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                />\n              </div>\n              {authMode === \'register\' && (\n                <div>\n                  <label className=\"text-xs text-[#5c3d42] block mb-1\">\n                    10-Digit Mobile Number *\n                  </label>\n                  <input\n                    required\n                    maxLength={10}\n                    value={authForm.phone}\n                    onChange={(e) =>\n                      setAuthForm({ ...authForm, phone: e.target.value.replace(/\\D/g, \'\') })\n                    }\n                    className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                  />\n                </div>\n              )}\n              <div>\n                <label className=\"text-xs text-[#5c3d42] block mb-1\">Password *</label>\n                <input\n                  required\n                  type=\"password\"\n                  value={authForm.password}\n                  onChange={(e) => setAuthForm({ ...authForm, password: e.target.value })}\n                  className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                />\n              </div>\n              {authError && <p className=\"text-xs text-rose-700\">{authError}</p>}\n              <button\n                type=\"submit\"\n                className=\"w-full py-3 rounded-full bg-[#9e5461] text-white text-xs font-medium\"\n              >\n                {authMode === \'login\' ? \'Sign In to Pretty Charm\' : \'Register Account\'}\n              </button>\n            </form>\n          </div>\n        )}\n\n        {/* SCREEN 16, 17, 18: MY ACCOUNT, MY ORDERS, SAVED ADDRESSES */}\n        {(screen === \'account\' || screen === \'my-orders\' || screen === \'saved-addresses\') && (\n          <div className=\"max-w-4xl mx-auto space-y-6\">\n            <div className=\"flex flex-wrap items-center justify-between gap-3\">\n              <div>\n                <p className=\"text-xs uppercase tracking-[0.18em] text-[#9e5461] font-semibold\">\n                  Customer Portal\n                </p>\n                <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n                  {customerUser ? `Hello, ${customerUser.name}` : \'My Account\'}\n                </h1>\n              </div>\n              {customerUser && (\n                <button\n                  onClick={() => {\n                    sessionStorage.removeItem(\'pc_customer_token\');\n                    setCustomerToken(\'\');\n                    setCustomerUser(null);\n                    setScreen(\'home\');\n                  }}\n                  className=\"px-4 py-1.5 rounded-full border border-[#f0d5da] text-xs text-rose-700\"\n                >\n                  Sign Out\n                </button>\n              )}\n            </div>\n\n            <div className=\"flex gap-2\">\n              <button\n                onClick={() => setScreen(\'account\')}\n                className={`px-4 py-2 rounded-full text-xs font-medium ${\n                  screen === \'account\'\n                    ? \'bg-[#9e5461] text-white\'\n                    : \'bg-white border border-[#f0d5da]\'\n                }`}\n              >\n                Overview\n              </button>\n              <button\n                onClick={() => setScreen(\'my-orders\')}\n                className={`px-4 py-2 rounded-full text-xs font-medium ${\n                  screen === \'my-orders\'\n                    ? \'bg-[#9e5461] text-white\'\n                    : \'bg-white border border-[#f0d5da]\'\n                }`}\n              >\n                My Orders ({customerOrders.length})\n              </button>\n              <button\n                onClick={() => setScreen(\'saved-addresses\')}\n                className={`px-4 py-2 rounded-full text-xs font-medium ${\n                  screen === \'saved-addresses\'\n                    ? \'bg-[#9e5461] text-white\'\n                    : \'bg-white border border-[#f0d5da]\'\n                }`}\n              >\n                Saved Addresses ({customerAddresses.length})\n              </button>\n            </div>\n\n            {screen === \'account\' && customerUser && (\n              <div className=\"rounded-3xl bg-white border border-[#f0d5da] p-6 space-y-2 text-xs\">\n                <p>\n                  <strong>Name:</strong> {customerUser.name}\n                </p>\n                <p>\n                  <strong>Email:</strong> {customerUser.email}\n                </p>\n                <p>\n                  <strong>Phone:</strong> {customerUser.phone}\n                </p>\n              </div>\n            )}\n\n            {screen === \'my-orders\' && (\n              <div className=\"space-y-3\">\n                {customerOrders.length === 0 ? (\n                  <div className=\"rounded-2xl bg-white border border-[#f0d5da] p-8 text-center text-xs text-[#7c5c63]\">\n                    No orders placed under this account yet.\n                  </div>\n                ) : (\n                  customerOrders.map((ord: any) => (\n                    <div\n                      key={ord.id}\n                      className=\"rounded-2xl bg-white border border-[#f0d5da] p-4 flex items-center justify-between text-xs\"\n                    >\n                      <div>\n                        <p className=\"font-semibold text-[#2d1e21] font-tabular\">\n                          {ord.order_number}\n                        </p>\n                        <p className=\"text-[#7c5c63]\">\n                          Status: {ord.order_status} \302\267 Payment: {ord.payment_status}\n                        </p>\n                      </div>\n                      <div className=\"text-right\">\n                        <p className=\"font-semibold font-tabular\">\n                          {formatInrFromPaise(ord.grand_total_paise)}\n                        </p>\n                        <button\n                          onClick={() => {\n                            setTrackOrderForm({\n                              orderNumber: ord.order_number,\n                              phone: ord.customer_phone\n                            });\n                            setScreen(\'track-order\');\n                          }}\n                          className=\"text-[#9e5461] underline mt-1\"\n                        >\n                          Track Shipment\n                        </button>\n                      </div>\n                    </div>\n                  ))\n                )}\n              </div>\n            )}\n\n            {screen === \'saved-addresses\' && (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div className=\"space-y-3\">\n                  {customerAddresses.map((addr: any) => (\n                    <div\n                      key={addr.id}\n                      className=\"rounded-2xl bg-white border border-[#f0d5da] p-4 text-xs space-y-1\"\n                    >\n                      <p className=\"font-semibold text-[#9e5461]\">{addr.label}</p>\n                      <p className=\"font-medium text-[#2d1e21]\">\n                        {addr.full_name} \302\267 {addr.phone}\n                      </p>\n                      <p className=\"text-[#5c3d42]\">\n                        {addr.house_line1}, {addr.street_line2}\n                      </p>\n                      <p className=\"text-[#5c3d42]\">\n                        {addr.city}, {addr.state} \342\200\224 {addr.pin_code}\n                      </p>\n                    </div>\n                  ))}\n                </div>\n\n                <form\n                  onSubmit={handleSaveAddress}\n                  className=\"rounded-2xl bg-white border border-[#f0d5da] p-5 space-y-3\"\n                >\n                  <h3 className=\"font-serif text-lg font-semibold\">Add New Address</h3>\n                  <input\n                    required\n                    placeholder=\"Recipient Full Name\"\n                    value={newAddressForm.fullName}\n                    onChange={(e) =>\n                      setNewAddressForm({ ...newAddressForm, fullName: e.target.value })\n                    }\n                    className=\"w-full px-3 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                  />\n                  <input\n                    required\n                    maxLength={10}\n                    placeholder=\"10-Digit Mobile\"\n                    value={newAddressForm.phone}\n                    onChange={(e) =>\n                      setNewAddressForm({\n                        ...newAddressForm,\n                        phone: e.target.value.replace(/\\D/g, \'\')\n                      })\n                    }\n                    className=\"w-full px-3 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                  />\n                  <input\n                    required\n                    placeholder=\"House / Flat / Building Line 1\"\n                    value={newAddressForm.houseLine1}\n                    onChange={(e) =>\n                      setNewAddressForm({ ...newAddressForm, houseLine1: e.target.value })\n                    }\n                    className=\"w-full px-3 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                  />\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <input\n                      required\n                      placeholder=\"City\"\n                      value={newAddressForm.city}\n                      onChange={(e) =>\n                        setNewAddressForm({ ...newAddressForm, city: e.target.value })\n                      }\n                      className=\"w-full px-3 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n                    />\n                    <input\n                      required\n                      maxLength={6}\n                      placeholder=\"6-Digit PIN Code\"\n                      value={newAddressForm.pinCode}\n                      onChange={(e) =>\n                        setNewAddressForm({\n                          ...newAddressForm,\n                          pinCode: e.target.value.replace(/\\D/g, \'\')\n                        })\n                      }\n                      className=\"w-full px-3 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n                    />\n                  </div>\n                  <button\n                    type=\"submit\"\n                    className=\"px-4 py-2 rounded-full bg-[#9e5461] text-white text-xs font-medium\"\n                  >\n                    Save Address\n                  </button>\n                </form>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* INTERACTIVE 3D STUDIO SCREEN */}\n        {screen === \'3d-studio\' && (\n          <div className=\"space-y-5\">\n            <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-2\">\n              <div>\n                <p className=\"text-xs uppercase tracking-[0.18em] text-[#9e5461] font-semibold\">\n                  Interactive Spatial Preview\n                </p>\n                <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n                  3D Keepsake Box &amp; Accessory Inspector\n                </h1>\n              </div>\n              <button\n                onClick={() => setScreen(\'shop\')}\n                className=\"text-xs text-[#9e5461] font-medium hover:underline\"\n              >\n                Return to Product Catalogue \342\206\222\n              </button>\n            </div>\n            <ThreeHamperViewer />\n          </div>\n        )}\n\n        {/* SCREEN 13: ABOUT US */}\n        {screen === \'about\' && (\n          <div className=\"max-w-3xl mx-auto rounded-3xl bg-white border border-[#f0d5da] p-8 space-y-4\">\n            <p className=\"text-xs uppercase tracking-[0.18em] text-[#9e5461] font-semibold\">\n              Our Story \302\267 Gurugram, Haryana\n            </p>\n            <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n              About Pretty Charm\n            </h1>\n            <p className=\"text-sm text-[#5c3d42] leading-relaxed\">\n              {policies.about_us?.body ||\n                \'Pretty Charm is an Indian online store based in Gurugram, Haryana (122001), dedicated to thoughtfully packaged gift hampers, hair accessories, and anti-tarnish demifine jewellery.\'}\n            </p>\n          </div>\n        )}\n\n        {/* SCREEN 14: CONTACT US */}\n        {screen === \'contact\' && (\n          <div className=\"max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div className=\"rounded-3xl bg-white border border-[#f0d5da] p-6 space-y-4\">\n              <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n                Contact Our Studio\n              </h1>\n              <p className=\"text-xs text-[#5c3d42] leading-relaxed\">\n                Dispatched &amp; managed from Gurugram, Haryana (122001). Reach out for hamper customisation, bulk gifting, or order assistance.\n              </p>\n              <div className=\"space-y-2 text-xs text-[#2d1e21]\">\n                <p className=\"flex items-center gap-2\">\n                  <MapPin className=\"w-4 h-4 text-[#9e5461]\" />\n                  <span>Gurugram, Haryana 122001, India</span>\n                </p>\n                <p className=\"flex items-center gap-2\">\n                  <Mail className=\"w-4 h-4 text-[#9e5461]\" />\n                  <span>{settings.support_email || \'care@prettycharm.in\'}</span>\n                </p>\n              </div>\n              <a\n                href={buildWhatsAppSupportUrl(\n                  settings.whatsapp_support_number || \'919876543210\',\n                  \'Hi Pretty Charm team, I have a question regarding your collection.\'\n                )}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-emerald-700 text-white text-xs font-medium\"\n              >\n                <MessageCircle className=\"w-4 h-4\" />\n                <span>Chat on WhatsApp</span>\n              </a>\n            </div>\n\n            <form\n              onSubmit={handleContactSubmit}\n              className=\"rounded-3xl bg-white border border-[#f0d5da] p-6 space-y-3\"\n            >\n              <h2 className=\"font-serif text-xl font-semibold\">Send an Inquiry</h2>\n              <input\n                required\n                placeholder=\"Your Name\"\n                value={contactForm.name}\n                onChange={(e) => setContactForm({ ...contactForm, name: e.target.value })}\n                className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n              />\n              <input\n                required\n                type=\"email\"\n                placeholder=\"Email Address\"\n                value={contactForm.email}\n                onChange={(e) => setContactForm({ ...contactForm, email: e.target.value })}\n                className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n              />\n              <input\n                placeholder=\"10-Digit Phone\"\n                value={contactForm.phone}\n                onChange={(e) => setContactForm({ ...contactForm, phone: e.target.value })}\n                className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs font-tabular\"\n              />\n              <textarea\n                required\n                rows={3}\n                placeholder=\"How can we help you?\"\n                value={contactForm.message}\n                onChange={(e) => setContactForm({ ...contactForm, message: e.target.value })}\n                className=\"w-full px-3.5 py-2 rounded-xl border border-[#f0d5da] text-xs\"\n              />\n              {contactSuccess && <p className=\"text-xs text-emerald-800\">{contactSuccess}</p>}\n              <button\n                type=\"submit\"\n                className=\"w-full py-2.5 rounded-full bg-[#9e5461] text-white text-xs font-medium\"\n              >\n                Submit Inquiry\n              </button>\n            </form>\n          </div>\n        )}\n\n        {/* SCREEN 15: FAQ */}\n        {screen === \'faq\' && (\n          <div className=\"max-w-3xl mx-auto space-y-4\">\n            <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n              Frequently Asked Questions\n            </h1>\n            <div className=\"space-y-3\">\n              {faqs.map((f: any) => (\n                <div\n                  key={f.id}\n                  className=\"rounded-2xl bg-white border border-[#f0d5da] p-5 space-y-1.5\"\n                >\n                  <h3 className=\"font-serif text-lg font-semibold text-[#2d1e21]\">\n                    {f.question}\n                  </h3>\n                  <p className=\"text-xs text-[#5c3d42] leading-relaxed\">{f.answer}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* SCREENS 19, 20, 21, 22: POLICIES */}\n        {(screen === \'shipping-policy\' ||\n          screen === \'return-policy\' ||\n          screen === \'privacy-policy\' ||\n          screen === \'terms\') && (\n          <div className=\"max-w-3xl mx-auto rounded-3xl bg-white border border-[#f0d5da] p-8 space-y-4\">\n            <h1 className=\"font-serif text-3xl text-[#2d1e21] font-semibold\">\n              {screen === \'shipping-policy\' && (policies.shipping_policy?.title || \'Shipping Policy\')}\n              {screen === \'return-policy\' && (policies.return_policy?.title || \'Return & Refund Policy\')}\n              {screen === \'privacy-policy\' && (policies.privacy_policy?.title || \'Privacy Policy\')}\n              {screen === \'terms\' && (policies.terms_conditions?.title || \'Terms & Conditions\')}\n            </h1>\n            <p className=\"text-sm text-[#5c3d42] leading-relaxed whitespace-pre-line\">\n              {screen === \'shipping-policy\' && policies.shipping_policy?.body}\n              {screen === \'return-policy\' && policies.return_policy?.body}\n              {screen === \'privacy-policy\' && policies.privacy_policy?.body}\n              {screen === \'terms\' && policies.terms_conditions?.body}\n            </p>\n          </div>\n        )}\n\n        {/* SCREEN 23: CUSTOM 404 PAGE */}\n        {screen === \'not-found\' && (\n          <div className=\"max-w-md mx-auto text-center py-16 space-y-4\">\n            <h1 className=\"font-serif text-4xl text-[#2d1e21] font-semibold\">\n              Page Not Found\n            </h1>\n            <p className=\"text-xs text-[#7c5c63]\">\n              The page or product you requested could not be found in the Pretty Charm store.\n            </p>\n            <button\n              onClick={() => setScreen(\'home\')}\n              className=\"px-5 py-2.5 rounded-full bg-[#9e5461] text-white text-xs font-medium\"\n            >\n              Back to Home\n            </button>\n          </div>\n        )}\n      </main>\n\n      {/* Footer with all 23 Required Customer Screens Accessible */}\n      <footer className=\"bg-[#fdf2f4] border-t border-[#f0d5da] mt-16 py-10 px-4 sm:px-6 text-xs text-[#5c3d42]\">\n        <div className=\"max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-8\">\n          <div className=\"col-span-2 sm:col-span-1 space-y-2\">\n            <span className=\"font-serif text-2xl font-semibold text-[#2d1e21]\">\n              Pretty Charm\n            </span>\n            <p className=\"text-[#7c5c63] leading-relaxed\">\n              Curated keepsake gift hampers, hair accessories &amp; demifine jewellery shipped pan-India from Gurugram, Haryana (122001).\n            </p>\n          </div>\n\n          <div className=\"space-y-2\">\n            <p className=\"font-semibold text-[#2d1e21] uppercase tracking-wider\">Shop</p>\n            <ul className=\"space-y-1.5\">\n              <li>\n                <button onClick={() => setScreen(\'shop\')} className=\"hover:text-[#9e5461]\">\n                  All Products\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setScreen(\'categories\')} className=\"hover:text-[#9e5461]\">\n                  Categories\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setScreen(\'3d-studio\')} className=\"hover:text-[#9e5461]\">\n                  3D Hamper Studio\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setScreen(\'splash\')} className=\"hover:text-[#9e5461]\">\n                  Brand Splash Screen\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          <div className=\"space-y-2\">\n            <p className=\"font-semibold text-[#2d1e21] uppercase tracking-wider\">\n              Customer Care\n            </p>\n            <ul className=\"space-y-1.5\">\n              <li>\n                <button onClick={() => setScreen(\'track-order\')} className=\"hover:text-[#9e5461]\">\n                  Track My Order\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setScreen(\'faq\')} className=\"hover:text-[#9e5461]\">\n                  FAQ\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setScreen(\'about\')} className=\"hover:text-[#9e5461]\">\n                  About Us\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setScreen(\'contact\')} className=\"hover:text-[#9e5461]\">\n                  Contact Us\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          <div className=\"space-y-2\">\n            <p className=\"font-semibold text-[#2d1e21] uppercase tracking-wider\">Policies</p>\n            <ul className=\"space-y-1.5\">\n              <li>\n                <button\n                  onClick={() => setScreen(\'shipping-policy\')}\n                  className=\"hover:text-[#9e5461]\"\n                >\n                  Shipping Policy\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => setScreen(\'return-policy\')}\n                  className=\"hover:text-[#9e5461]\"\n                >\n                  Return &amp; Refund Policy\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => setScreen(\'privacy-policy\')}\n                  className=\"hover:text-[#9e5461]\"\n                >\n                  Privacy Policy\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setScreen(\'terms\')} className=\"hover:text-[#9e5461]\">\n                  Terms &amp; Conditions\n                </button>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </footer>\n\n      {/* Mobile Bottom Navigation Bar (Preserving Reference Layout for 360px-430px screens) */}\n      <nav className=\"md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#f0d5da] h-16 grid grid-cols-5 items-center text-[10px] font-medium text-[#7c5c63]\">\n        <button\n          onClick={() => setScreen(\'home\')}\n          className={`flex flex-col items-center gap-1 ${\n            screen === \'home\' ? \'text-[#9e5461] font-semibold\' : \'\'\n          }`}\n        >\n          <Home className=\"w-4 h-4\" />\n          <span>Home</span>\n        </button>\n        <button\n          onClick={() => setScreen(\'categories\')}\n          className={`flex flex-col items-center gap-1 ${\n            screen === \'categories\' || screen === \'shop\' ? \'text-[#9e5461] font-semibold\' : \'\'\n          }`}\n        >\n          <Grid className=\"w-4 h-4\" />\n          <span>Shop</span>\n        </button>\n        <button\n          onClick={() => setScreen(\'cart\')}\n          className={`flex flex-col items-center gap-1 relative ${\n            screen === \'cart\' ? \'text-[#9e5461] font-semibold\' : \'\'\n          }`}\n        >\n          <ShoppingBag className=\"w-4 h-4\" />\n          <span>Bag ({hydratedCart.reduce((s, i) => s + i.quantity, 0)})</span>\n        </button>\n        <button\n          onClick={() => setScreen(\'track-order\')}\n          className={`flex flex-col items-center gap-1 ${\n            screen === \'track-order\' ? \'text-[#9e5461] font-semibold\' : \'\'\n          }`}\n        >\n          <Truck className=\"w-4 h-4\" />\n          <span>Track</span>\n        </button>\n        <button\n          onClick={() => setScreen(customerUser ? \'account\' : \'auth\')}\n          className={`flex flex-col items-center gap-1 ${\n            screen === \'account\' || screen === \'auth\' ? \'text-[#9e5461] font-semibold\' : \'\'\n          }`}\n        >\n          <User className=\"w-4 h-4\" />\n          <span>Account</span>\n        </button>\n      </nav>\n\n      {/* Gemini AI Styling Concierge Modal */}\n      <GeminiStudioModal isOpen={isAiModalOpen} onClose={() => setIsAiModalOpen(false)} />\n    </div>\n  );\n}\n\nfunction ProductCard({\n  product,\n  isWishlisted,\n  onToggleWishlist,\n  onSelect,\n  onAddToCart\n}: {\n  product: any;\n  isWishlisted: boolean;\n  onToggleWishlist: () => void;\n  onSelect: () => void;\n  onAddToCart: () => void;\n}) {\n  const isPurchasable = product.status === \'active\' && product.stock_quantity > 0;\n\n  return (\n    <div\n      data-testid={`product-card-${product.slug}`}\n      className=\"group rounded-2xl bg-white border border-[#f0d5da] hover:border-[#9e5461] overflow-hidden flex flex-col justify-between transition-all shadow-2xs\"\n    >\n      <div>\n        <div className=\"relative aspect-4/3 bg-[#fdf2f4] overflow-hidden\">\n          <img\n            src={product.images?.[0] || PRODUCT_ARTWORK.heroBanner}\n            alt={product.name}\n            onClick={onSelect}\n            className=\"w-full h-full object-cover cursor-pointer group-hover:scale-105 transition-transform duration-300\"\n          />\n          <button\n            onClick={onToggleWishlist}\n            aria-label=\"Save to Wishlist\"\n            className={`absolute top-2.5 right-2.5 p-2 rounded-full bg-white/90 shadow-2xs ${\n              isWishlisted ? \'text-[#9e5461]\' : \'text-[#7c5c63]\'\n            }`}\n          >\n            <Heart className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"p-4 space-y-1.5\">\n          {/* Plain typographical metadata with middot separator (Zero-Pill Discipline) */}\n          <p className=\"text-[11px] text-[#9e5461] font-medium\">\n            {product.category_name} \302\267{\' \'}\n            {product.status === \'active\'\n              ? `${product.stock_quantity} in stock`\n              : product.status === \'draft\'\n              ? \'Draft Preview\'\n              : product.status === \'coming-soon\'\n              ? \'Coming Soon\'\n              : \'Out of Stock\'}\n          </p>\n\n          <h3\n            onClick={onSelect}\n            className=\"font-serif text-lg font-semibold text-[#2d1e21] cursor-pointer hover:text-[#9e5461] leading-snug\"\n          >\n            {product.name}\n          </h3>\n\n          <p className=\"text-sm font-semibold text-[#2d1e21] font-tabular\">\n            {product.status === \'draft\' ? \'Proposed \' : \'\'}\n            {formatInrFromPaise(product.selling_price_paise)}\n          </p>\n        </div>\n      </div>\n\n      <div className=\"px-4 pb-4 pt-1\">\n        {isPurchasable ? (\n          <button\n            onClick={onAddToCart}\n            data-testid={`add-to-cart-${product.slug}`}\n            className=\"w-full py-2.5 px-4 rounded-full bg-[#9e5461] hover:bg-[#84414d] text-white text-xs font-medium transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap\"\n          >\n            <ShoppingBag className=\"w-3.5 h-3.5\" />\n            <span>Add to Bag</span>\n          </button>\n        ) : (\n          <button\n            onClick={onSelect}\n            disabled={false}\n            data-testid={`non-purchasable-${product.slug}`}\n            className=\"w-full py-2.5 px-4 rounded-full bg-[#fdf2f4] text-[#7c5c63] text-xs font-medium whitespace-nowrap\"\n          >\n            {product.status === \'draft\'\n              ? \'Draft \302\267 Awaiting Admin Confirmation\'\n              : product.status === \'coming-soon\'\n              ? \'Coming Soon\'\n              : \'Out of Stock\'}\n          </button>\n        )}\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }
