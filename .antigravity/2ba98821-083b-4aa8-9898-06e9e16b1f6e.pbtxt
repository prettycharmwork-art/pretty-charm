urce=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Scrunchie_is_back_foulchie_chignon_1024x1024@2x.jpg\",\"mime\":\"image/jpeg\",\"w\":1536,\"h\":2048,\"license\":\"CC BY-SA 4.0\"}{\"title\":\"File:Bi pride coaster and hair scrunchie.jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/Bi_pride_coaster_and_hair_scrunchie.jpg/960px-Bi_pride_coaster_and_hair_scrunchie.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Bi_pride_coaster_and_hair_scrunchie.jpg\",\"mime\":\"image/jpeg\",\"w\":2324,\"h\":3523,\"license\":\"CC0\"}=== prod-satin-bow-barrette ==={\"title\":\"File:Dress (AM 2003.48.1-13).jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Dress_%28AM_2003.48.1-13%29.jpg/960px-Dress_%28AM_2003.48.1-13%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Dress_(AM_2003.48.1-13).jpg\",\"mime\":\"image/jpeg\",\"w\":1329,\"h\":1693,\"license\":\"CC BY 4.0\"}{\"title\":\"File:Dress (AM 2003.48.1-24).jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Dress_%28AM_2003.48.1-24%29.jpg/960px-Dress_%28AM_2003.48.1-24%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Dress_(AM_2003.48.1-24).jpg\",\"mime\":\"image/jpeg\",\"w\":1433,\"h\":2009,\"license\":\"CC BY 4.0\"}{\"title\":\"File:Dress (AM 2003.48.1-34).jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Dress_%28AM_2003.48.1-34%29.jpg/960px-Dress_%28AM_2003.48.1-34%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Dress_(AM_2003.48.1-34).jpg\",\"mime\":\"image/jpeg\",\"w\":1593,\"h\":1325,\"license\":\"CC BY 4.0\"}{\"title\":\"File:Dress (AM 2003.48.1-35).jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Dress_%28AM_2003.48.1-35%29.jpg/960px-Dress_%28AM_2003.48.1-35%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Dress_(AM_2003.48.1-35).jpg\",\"mime\":\"image/jpeg\",\"w\":1777,\"h\":1483,\"license\":\"CC BY 4.0\"}{\"title\":\"File:Dress (AM 2003.48.1-32).jpg\",\"thumbUrl\":\"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Dress_%28AM_2003.48.1-32%29.jpg/960px-Dress_%28AM_2003.48.1-32%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail\",\"sourceUrl\":\"https://commons.wikimedia.org/wiki/File:Dress_(AM_2003.48.1-32).jpg\",\"mime\":\"image/jpeg\",\"w\":1569,\"h\":2089,\"license\":\"CC BY 4.0\"}"
    }
    command_line: "npx --yes tsx -e \"\n(async () => {\n  const queries = [\n    { id: \'prod-pearl-claw\', q: \'hair clip claw OR hair claw OR barrette pearl filetype:bitmap\' },\n    { id: \'prod-silk-scrunchie-trio\', q: \'hair scrunchie OR scrunchies filetype:bitmap\' },\n    { id: \'prod-satin-bow-barrette\', q: \'ribbon hair bow OR satin bow hair clip filetype:bitmap\' },\n  ];\n\n  for (const item of queries) {\n    const url = \'https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=\' + encodeURIComponent(item.q) + \'&gsrnamespace=6&gsrlimit=5&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n    const res = await fetch(url, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n    const data = await res.json();\n    const pages = Object.values(data?.query?.pages || {}) as any[];\n    console.log(\'=== \' + item.id + \' ===\');\n    for (const p of pages) {\n      const ii = p.imageinfo?.[0];\n      if (!ii) continue;\n      console.log(JSON.stringify({\n        title: p.title,\n        thumbUrl: ii.thumburl || ii.url,\n        sourceUrl: ii.descriptionurl,\n        mime: ii.mime,\n        w: ii.width,\n        h: ii.height,\n        license: ii.extmetadata?.LicenseShortName?.value\n      }));\n    }\n  }\n})();\n\""
    proposed_command_line: "npx --yes tsx -e \"\n(async () => {\n  const queries = [\n    { id: \'prod-pearl-claw\', q: \'hair clip claw OR hair claw OR barrette pearl filetype:bitmap\' },\n    { id: \'prod-silk-scrunchie-trio\', q: \'hair scrunchie OR scrunchies filetype:bitmap\' },\n    { id: \'prod-satin-bow-barrette\', q: \'ribbon hair bow OR satin bow hair clip filetype:bitmap\' },\n  ];\n\n  for (const item of queries) {\n    const url = \'https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=\' + encodeURIComponent(item.q) + \'&gsrnamespace=6&gsrlimit=5&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n    const res = await fetch(url, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n    const data = await res.json();\n    const pages = Object.values(data?.query?.pages || {}) as any[];\n    console.log(\'=== \' + item.id + \' ===\');\n    for (const p of pages) {\n      const ii = p.imageinfo?.[0];\n      if (!ii) continue;\n      console.log(JSON.stringify({\n        title: p.title,\n        thumbUrl: ii.thumburl || ii.url,\n        sourceUrl: ii.descriptionurl,\n        mime: ii.mime,\n        w: ii.width,\n        h: ii.height,\n        license: ii.extmetadata?.LicenseShortName?.value\n      }));\n    }\n  }\n})();\n\""
    shell_name: "bash"
  }
