            }
            lines {
              text: "): string {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const cleanPhone = String(storePhone || \'919000000000\').replace(/\\D/g, \'\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const safeOrderId = (context.orderId || \'\').replace(/[^a-zA-Z0-9\\-]/g, \'\').slice(0, 24);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const safeProduct = (context.productName || \'\').replace(/[^\\w\\s\\-\342\202\271&]/g, \'\').slice(0, 60);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
