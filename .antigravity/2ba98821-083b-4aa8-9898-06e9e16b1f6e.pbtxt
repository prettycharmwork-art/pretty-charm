  view_file {
    absolute_path_uri: "file:///src/shared/domainLogic.ts"
    start_line: 264
    end_line: 344
    content: "  return /^[1-9][0-9]{5}$/.test(cleaned);\n}\n\nexport function checkPinCodeServiceability(\n  pincode: string,\n  configuredPins: ServiceablePinCode[]\n): { validFormat: boolean; isServiceable: boolean; city?: string; state?: string; message: string } {\n  const cleaned = String(pincode || \'\').trim();\n  if (!validateIndianPinCodeFormat(cleaned)) {\n    return {\n      validFormat: false,\n      isServiceable: false,\n      message: \'Please enter a valid 6-digit Indian PIN code (e.g. 122001).\',\n    };\n  }\n\n  const match = configuredPins.find((p) => p.pincode === cleaned);\n  if (!match || !match.isServiceable) {\n    return {\n      validFormat: true,\n      isServiceable: false,\n      message: `Delivery to PIN code ${cleaned} is not enabled yet. Please contact support on WhatsApp for special dispatch from Gurugram.`,\n    };\n  }\n\n  return {\n    validFormat: true,\n    isServiceable: true,\n    city: match.city,\n    state: match.state,\n    message: `Ships from Gurugram to ${match.city}, ${match.state} (${cleaned}). Estimated delivery date will be shared once dispatched.`,\n  };\n}\n\n// ============================================================================\n// 4. SERVER-SIDE CART & CHECKOUT VALIDATION\n// ============================================================================\n\nexport function normalizeIndianMobile(mobile: string): string {\n  const digits = String(mobile || \'\').replace(/\\D/g, \'\');\n  if (digits.length === 12 && digits.startsWith(\'91\')) {\n    return digits.slice(2);\n  }\n  if (digits.length === 11 && digits.startsWith(\'0\')) {\n    return digits.slice(1);\n  }\n  return digits;\n}\n\nexport function validateIndianMobile(mobile: string): boolean {\n  const normalized = normalizeIndianMobile(mobile);\n  return /^[6-9][0-9]{9}$/.test(normalized);\n}\n\nexport function validateCheckoutAddress(\n  address: CheckoutAddressInput,\n  serviceablePins: ServiceablePinCode[]\n): { valid: boolean; errors: string[] } {\n  const errors: string[] = [];\n\n  if (!address.fullName || address.fullName.trim().length < 2) {\n    errors.push(\'Customer full name is required.\');\n  }\n  if (!validateIndianMobile(address.mobile)) {\n    errors.push(\'Valid 10-digit Indian mobile number starting with 6-9 is required.\');\n  }\n  if (!address.houseFlat || address.houseFlat.trim().length < 2) {\n    errors.push(\'House / Flat / Building number is required.\');\n  }\n  if (!address.streetLocality || address.streetLocality.trim().length < 3) {\n    errors.push(\'Street / Sector / Locality is required.\');\n  }\n  if (!address.city || address.city.trim().length < 2) {\n    errors.push(\'City is required.\');\n  }\n  if (!address.state || address.state.trim().length < 2) {\n    errors.push(\'State is required.\');\n  }\n\n  const pinCheck = checkPinCodeServiceability(address.pincode, serviceablePins);\n  if (!pinCheck.validFormat || !pinCheck.isServiceable) {"
    num_lines: 1491
