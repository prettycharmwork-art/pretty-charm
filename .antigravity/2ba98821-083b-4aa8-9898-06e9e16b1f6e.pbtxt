            }
            lines {
              text: "// 9. SPREADSHEET CELL ESCAPING & WHATSAPP CLICK-TO-CHAT SANITIZATION"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "// ============================================================================"
