      thinking_signature: "\022\305\022\n\302\022\001i\024}\023%/\205.+\307\270\377\361=\253\221\277\307\fC\272M}2\321\242\344\\\305\327\344\006\247V\316o\224W<C\v\256\367\231\215#k\v\224\370\022\036\026\202\343\277\342?\324q\267\355\254\372\330\b\240\325<m\2652\201D\360@N#\314%\021\317\375A95\275-t\2743CR\\\353\3711\302\217=\r%\370\027\001:\373\232\203kj}x\335G\264\203\235\223\201\326\327f\243\203>Bl\fO\206\017\377\326S>v\226\224\243\256\020\266\250xG\206\257\333\266<\340kuh5=\016\300\211\305\337\22650\022\337\327g&\245T\3442\231y\261\202\356\241Vz\277\204B\"HD\017\366\323\236SD\370\232\002(\342}\033IC\356p\362\031\333\004l\035\366\226\032\3415j\\\311\306\313`\345 \330\230\310X\366\215\346\301fkZ[\251\017\316\027\274\214JT@\337\244\264\201i\322\237\214x\346F\272Ja\206\251\003\033\357\233\021\324]\204\335\301\323\270\216\n\004U\265\274\307\373d\350$qWua\037m\357\322a\354\353\036\v\340\235\217n\203\324A=2\261\230Q\251\036\372\331G\334fC\000^\242\031/Gx\036R\031\376\266\201\360\304b\374~\321\337Ie\215\370\300\231\177},\301(\035I\250\277\331\377V\3041\267\374\336\004\305\n\302\221\245\'\275\213\227e\304(\324{D\325\361\032#\357\354w\253\344\362\336\305\240\027]w\334\020=\316|i\001\023\323S,>\260\303sA\360\323o\237H\0160\322y\2363\216\'\006\305x\323\371\030l\'\367:2\252\340\324\0038\312b\366\230\301\374\034\f\006\274\026\270\226\2114\023\177<\233\025\t\030\f\350\340\\\004\224\036\352\277)\353\373\375\223\202\314\232\253l\307\f`\003F\205\204\264\205i\252\320\230Q\033\352\346&\250O\374)I\257\335\367\331\331\214\036db\t\3531\253\'\322\250?\262\330\271\024\205\250S\v\320A\211r\271\241\022\371\322\254\337\3518\210\324\202\025/+\0034\377B\276\213\023\036YX\377\005\261\232\372G\241f0c5e|\227\242\360\275S\234\371H&\360\327\224\347\312]\347\237\v5\242\270\364\277p\301\247l3\303\313\301\243\312<\216\355\356\036\\\234\311[s\231lq\3615\337/\005\354\262\231\237\202\212:g8\f\025Gg\304i\253b\a)\3779\310-\312\001\221O\312\235\226GQ.\314\325\306\303\264\3413{\240& \274x\002\264\200\307\a