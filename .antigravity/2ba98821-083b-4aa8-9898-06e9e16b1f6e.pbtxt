            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "export function verifyOrderLookupPhone(storedMobile: string, submittedMobile: string): boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const normStored = normalizeIndianMobile(storedMobile);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const normSubmitted = normalizeIndianMobile(submittedMobile);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return normStored.length === 10 && normStored === normSubmitted;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
