        instruction: "Add handleFindAllAvailableImages, handleApproveBatchImages, and handleGenerateAiFallbackImage handlers in AdminDashboard.tsx"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/AdminDashboard.tsx"
