    content: "        .prepare(\'SELECT event_code, status_label, location, event_timestamp FROM shipment_events WHERE shipment_id = ? ORDER BY event_timestamp DESC\')\n        .all(shipment.id) as any[])\n    : [];\n\n  const parsedAddr = JSON.parse(order.shipping_address_json || \'{}\');\n  const settings = getStoreSettings();\n  const storeWhatsapp = settings.general.supportWhatsapp || \'919000000000\';\n  const mappedItems = items.map((i) => ({\n    productName: i.product_name,\n    variantName: i.variant_name,\n    quantity: i.quantity,\n    unitPricePaise: i.unit_price_paise,\n    lineTotalPaise: i.line_total_paise,\n  }));\n  const waPayload = {\n    orderNumber: order.order_number,\n    customerName: order.customer_name,\n    customerMobile: order.customer_mobile,\n    address: parsedAddr,\n    items: mappedItems,\n    subtotalPaise: order.subtotal_paise,\n    shippingFeePaise: order.shipping_fee_paise,\n    totalPaise: order.total_paise,\n  };\n\n  // Return saved order information and WhatsApp click-to-chat URL so returning customers can resume\n  res.json({\n    orderId: order.id,\n    orderNumber: order.order_number,\n    customerName: order.customer_name,\n    customerMobile: order.customer_mobile,\n    shippingAddress: parsedAddr,\n    orderStatus: order.order_status,\n    paymentMode: order.payment_mode,\n    paymentStatus: order.payment_status,\n    shipmentStatus: shipment?.shipment_status || order.shipment_status,\n    subtotalPaise: order.subtotal_paise,\n    shippingFeePaise: order.shipping_fee_paise,\n    totalPaise: order.total_paise,\n    createdAt: order.created_at,\n    deliveryCity: parsedAddr.city,\n    deliveryState: parsedAddr.state,\n    deliveryPincode: parsedAddr.pincode,\n    statusHistory: JSON.parse(order.status_history_json || \'[]\'),\n    items: mappedItems,\n    whatsappOrderUrl: buildCustomerOrderWhatsAppUrl(storeWhatsapp, waPayload),\n    whatsappOrderMessage: buildCustomerOrderWhatsAppMessage(waPayload),\n    shipment: {\n  