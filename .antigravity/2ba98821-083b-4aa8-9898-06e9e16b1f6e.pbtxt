gCostPaise,\n        p.stockQty,\n        0,\n        p.lowStockThreshold,\n        \'active\',\n        1,\n        p.featured,\n        now,\n        now\n      );\n\n      insertMovement.run(\n        `mov-open-${p.id}`,\n        p.id,\n        null,\n        \'opening\',\n        p.stockQty,\n        p.stockQty,\n        p.purchaseCostPaise,\n        \'OPENING-STOCK\',\n        \'Configured opening inventory balance (Weighted Average Cost initialized)\',\n        \'system@prettycharm.in\',\n        now\n      );\n\n      for (const v of p.variants) {\n        insertVariant.run(\n          v.id,\n          p.id,\n          v.name,\n          v.sku,\n          v.delta,\n          v.stock,\n          0,\n          now,\n          now\n        );\n      }\n    }"
