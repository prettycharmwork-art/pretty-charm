    combined_output {
      full: "### Browser `default` opened with pid 294.### Ran Playwright code```jsawait page.goto(\'http://localhost:3000\');```### Page- Page URL: http://localhost:3000/- Page Title: Pretty Charm \342\200\223 Gift Hampers, Jewellery & Hair Accessories### Snapshot- [Snapshot](.playwright-cli/page-2026-10-24T13-11-46-281Z.yml)### Events- New console entries: .playwright-cli/console-2026-10-24T13-11-44-918Z.log#L1### Ran Playwright code```jsawait page.setViewportSize({ width: 1440, height: 900 });```### Result- [Screenshot of viewport](.playwright-cli/homepage-desktop-1440.png)### Ran Playwright code```js// Screenshot viewport and save it as .playwright-cli/homepage-desktop-1440.pngawait page.screenshot({  path: \'.playwright-cli/homepage-desktop-1440.png\',  scale: \'css\',  type: \'png\'});```### ErrorTimeoutError: locator.click: Timeout 30000ms exceeded.Call log:  - waiting for getByTestId(\'hero-cta-hampers\')Browser \'default\' closed"
    }
    command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli && \\\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 1440 900 && \\\nplaywright-cli screenshot --filename=.playwright-cli/homepage-desktop-1440.png && \\\nplaywright-cli run-code \'async (page) => {\n  await page.screenshot({ path: \".playwright-cli/homepage-desktop-full.png\", fullPage: true, timeout: 20000 });\n\n  // 1. Check all homepage sections and image loading\n  const homepageReport = await page.evaluate(() => {\n    const sections = [\n      \"announcement-bar\",\n      \"homepage-hero-section\",\n      \"homepage-categories-section\",\n      \"homepage-featured-section\",\n      \"homepage-hampers-section\",\n      \"homepage-brand-story\",\n      \"homepage-why-shop-section\",\n      \"homepage-instagram-section\",\n      \"homepage-newsletter-section\",\n      \"site-footer\"\n    ];\n    const sectionStatus = Object.fromEntries(\n      sections.map(id => [id, Boolean(document.querySelector(`[data-testid=\"${id}\"]`))])\n    );\n    const imgs = Array.from(document.querySelectorAll(\"img\")).map(img => ({\n      alt: img.alt,\n      src: img.getAttribute(\"src\"),\n      loaded: img.complete && img.naturalWidth > 0,\n      w: img.naturalWidth,\n      h: img.naturalHeight\n    }));\n    const heroHeadline = document.querySelector(\"h1\")?.textContent?.trim();\n    return { sectionStatus, imgs, heroHeadline };\n  });\n\n  // 2. Check responsive viewports for zero horizontal overflow\n  const widths = [360, 375, 390, 430, 768, 1440];\n  const responsiveReport = [];\n  for (const w of widths) {\n    await page.setViewportSize({ width: w, height: 844 });\n    await page.waitForTimeout(100);\n    const metrics = await page.evaluate(() => ({\n      clientWidth: document.documentElement.clientWidth,\n      scrollWidth: document.documentElement.scrollWidth,\n      bodyScrollWidth: document.body.scrollWidth,\n      overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth\n    }));\n    responsiveReport.push({ width: w, ...metrics });\n    if (w === 360) {\n      await page.screenshot({ path: \".playwright-cli/homepage-mobile-360.png\", timeout: 20000 });\n    }\n    if (w === 390) {\n      await page.screenshot({ path: \".playwright-cli/homepage-mobile-390.png\", timeout: 20000 });\n    }\n  }\n\n  // 3. Test mobile menu drawer at 390px\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.getByTestId(\"mobile-menu-toggle\").click();\n  const mobileDrawerVisible = await page.getByTestId(\"mobile-nav-drawer\").isVisible();\n  await page.getByTestId(\"mobile-menu-toggle\").click();\n\n  // 4. Test Hero CTAs, Featured Add to Cart, and Footer links at 1440px\n  await page.setViewportSize({ width: 1440, height: 900 });\n  await page.getByTestId(\"hero-cta-hampers\").click();\n  const onHampersScreen = await page.locator(\"h1\", { hasText: \"Curated Gift Hampers\" }).isVisible();\n\n  await page.getByRole(\"button\", { name: \"Home\", exact: true }).first().click();\n  await page.getByTestId(\"hero-cta-accessories\").click();\n  const onAccessoriesScreen = await page.locator(\"h1\", { hasText: \"Hair Accessories\" }).isVisible();\n\n  await page.getByRole(\"button\", { name: \"Home\", exact: true }).first().click();\n  await page.getByTestId(\"featured-add-prod-pearl-claw\").click();\n  const cartBadgeText = await page.locator(\"header button[aria-label^=\\\"Shopping Cart\\\"]\").textContent();\n\n  await page.getByTestId(\"footer-link-shipping\").click();\n  const onShippingPolicy = await page.locator(\"h1\", { hasText: \"Shipping & Delivery Policy\" }).isVisible();\n\n  console.log(\"VERIFICATION_JSON:\" + JSON.stringify({\n    homepageReport,\n    responsiveReport,\n    journeys: {\n      mobileDrawerVisible,\n      onHampersScreen,\n      onAccessoriesScreen,\n      cartBadgeText: cartBadgeText?.trim(),\n      onShippingPolicy\n    }\n  }));\n}\' && \\\nplaywright-cli console"
