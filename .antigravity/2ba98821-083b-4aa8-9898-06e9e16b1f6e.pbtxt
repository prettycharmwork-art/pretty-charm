de```jsawait page.evaluate(\'() => {\\n  const cards = Array.from(document.querySelectorAll(\\\'[data-testid]\\\')).map(el => el.getAttribute(\\\'data-testid\\\'));\\n  return { cards: cards.filter(c => c.includes(\\\'order\\\') || c.includes(\\\'whatsapp\\\') || c.includes(\\\'mark\\\') || c.includes(\\\'confirm\\\')), bodySnippet: document.body.innerText.slice(0, 1500) };\\n}\');```"
