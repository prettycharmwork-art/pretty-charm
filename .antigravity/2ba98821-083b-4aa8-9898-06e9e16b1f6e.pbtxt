    tool_calls {
      id: "call_306529"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add unit tests for candidate photo validation, gallery preservation/replacement, and catalogue integrity verification\", \"Instruction\":\"Import new photo audit helpers and add test #13 in src/shared/domainLogic.test.ts\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":29, \"ReplacementContent\":\"  sortCatalogueProducts,\\n  PRODUCT_SORT_OPTIONS,\\n  validateCandidateProductImage,\\n  applyApprovedProductImageToGallery,\\n  verifyCatalogueIntegrityUnchanged,\\n  PRODUCT_IMAGE_AUDIT_STATUSES,\\n  DomainProduct,\\n  DomainVariant,\\n  ServiceablePinCode,\\n} from \'./domainLogic\';\", \"StartLine\":22, \"TargetContent\":\"  sortCatalogueProducts,\\n  PRODUCT_SORT_OPTIONS,\\n  DomainProduct,\\n  DomainVariant,\\n  ServiceablePinCode,\\n} from \'./domainLogic\';\"}, {\"AllowMultiple\":false, \"EndLine\":365, \"ReplacementContent\":\"  // Ensure original array was not mutated\\n  assert.equal(sampleCatalogue[0].id, \'prod-1\');\\n});\\n\\ntest(\'13. Original product photo validation, approval gallery update & catalogue integrity check\', () => {\\n  // Verify all 5 required Admin Image Report statuses exist\\n  assert.deepEqual(PRODUCT_IMAGE_AUDIT_STATUSES, [\\n    \'Original image found \342\200\224 awaiting approval\',\\n    \'Image successfully added\',\\n    \'Image Needed\',\\n    \'Source or reuse permission unverified\',\\n    \'Search failed\',\\n  ]);\\n\\n  // Reject AI-generated images\\n  const aiCheck = validateCandidateProductImage({\\n    urlOrDataUri: \'https://example.com/photo.jpg\',\\n    sourceUrl: \'https://example.com/product\',\\n    isAiGenerated: true,\\n    hasReusePermission: true,\\n    exactProductMatch: true,\\n  });\\n  assert.equal(aiCheck.valid, false);\\n  assert.equal(aiCheck.recommendedStatus, \'Image Needed\');\\n\\n  // Flag unverified third-party reuse permissions\\n  const unverifiedCheck = validateCandidateProductImage({\\n    urlOrDataUri: \'https://etsy.com/img/claw.jpg\',\\n    sourceUrl: \'https://etsy.com/listing/123\',\\n    isAiGenerated: false,\\n    hasReusePermission: false,\\n    exactProductMatch: true,\\n  });\\n  assert.equal(unverifiedCheck.valid, false);\\n  assert.equal(unverifiedCheck.recommendedStatus, \'Source or reuse permission unverified\');\\n\\n  // Accept valid authorized photo into awaiting approval state\\n  const validCheck = validateCandidateProductImage({\\n    urlOrDataUri: \'https://prettycharm.in/media/pc-hair-claw-01.jpg\',\\n    sourceUrl: \'https://prettycharm.in/catalogue/pc-hair-claw-01\',\\n    mimeType: \'image/jpeg\',\\n    byteLength: 45000,\\n    isAiGenerated: false,\\n    hasReusePermission: true,\\n    exactProductMatch: true,\\n  });\\n  assert.equal(validCheck.valid, true);\\n  assert.equal(validCheck.recommendedStatus, \'Original image found \342\200\224 awaiting approval\');\\n\\n  // Gallery update preserves existing images by default and sets primary image when confirmed\\n  const existingGallery = [\'data:image/svg+xml;utf8,existing1\', \'data:image/svg+xml;utf8,existing2\'];\\n  const preservedPrimary = applyApprovedProductImageToGallery(\\n    existingGallery,\\n    \'https://prettycharm.in/media/pc-hair-claw-01.jpg\',\\n    { replaceExisting: false, setAsPrimary: true }\\n  );\\n  assert.deepEqual(preservedPrimary, [\\n    \'https://prettycharm.in/media/pc-hair-claw-01.jpg\',\\n    \'data:image/svg+xml;utf8,existing1\',\\n    \'data:image/svg+xml;utf8,existing2\',\\n  ]);\\n\\n  // Catalogue integrity check detects any unauthorized mutation of product count, ID, price, or stock\\n  const snapshotBefore = [\\n    {\\n      id: \'prod-pearl-claw\',\\n      name: \'Rose Gold Pearl Hair Claw\',\\n      slug: \'rose-gold-pearl-hair-claw\',\\n      categorySlug: \'hair-accessories\',\\n      sku: \'PC-HAIR-CLAW-01\',\\n      sellingPricePaise: 24900,\\n      stockQty: 18,\\n      status: \'active\',\\n      variantSkus: [\'PC-HAIR-CLAW-01-CL\', \'PC-HAIR-CLAW-01-PT\'],\\n    },\\n  ];\\n  const integrityOk = verifyCatalogueIntegrityUnchanged(snapshotBefore, [...snapshotBefore]);\\n  assert.equal(integrityOk.unchanged, true);\\n  assert.equal(integrityOk.discrepancies.length, 0);\\n});\\n\", \"StartLine\":355, \"TargetContent\":\"  // Ensure original array was not mutated\\n  assert.equal(sampleCatalogue[0].id, \'prod-1\');\\n});\"}], \"TargetFile\":\"/src/shared/domainLogic.test.ts\", \"toolAction\":\"Adding photo verification unit tests to domainLogic.test.ts\", \"toolSummary\":\"Add photo verification unit tests\"}"
      original_name: "multi_replace_file_content"
    }
