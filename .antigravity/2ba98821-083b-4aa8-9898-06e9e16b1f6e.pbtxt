            }
            lines {
              text: "  if (!entry || entry.resetAt < now) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    loginRateLimit.set(key, { count: 1, resetAt: now + windowMs });"
