            }
            lines {
              text: "export function isDuplicateShipmentEvent("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  existingEvents: Array<{ eventCode: string; eventTimestamp: string; location: string }>,"
