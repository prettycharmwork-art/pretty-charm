          target_content: "    upsertAudit.run(\n      productId,\n      photo.searchQuery,\n      \'Added Successfully\',\n      photo.imageUrl,\n      photo.thumbnailUrl,\n      photo.sourceUrl,\n      photo.licenseInfo,\n      photo.imageFormat,\n      photo.imageResolution,\n      photo.imageBytes,\n      photo.reason,\n      \'owner@prettycharm.in\',\n      now,\n      now\n    );\n  }\n\n  // Save baseline product integrity snapshot in store_settings if not already saved\n  const existingBaseline = db\n    .prepare(\"SELECT value_json FROM store_settings WHERE key = \'catalogue_integrity_baseline\'\")\n    .get() as { value_json: string } | undefined;\n  if (!existingBaseline) {\n    const prods = db.prepare(\'SELECT * FROM products ORDER BY id ASC\').all() as any[];\n    const vars = db.prepare(\'SELECT * FROM product_variants ORDER BY id ASC\').all() as any[];\n    const snapshot = prods.map((p) => ({\n      id: p.id,\n      name: p.name,\n      slug: p.slug,\n      categorySlug: p.category_slug,\n      sku: p.sku,\n      sellingPricePaise: p.selling_price_paise,\n      stockQty: p.stock_qty,\n      status: p.status,\n      variantSkus: vars.filter((v) => v.product_id === p.id).map((v) => v.sku),\n    }));\n    db.prepare(`\n      INSERT INTO store_settings (key, value_json, updated_at) VALUES (\'catalogue_integrity_baseline\', ?, ?)\n    `).run(JSON.stringify(snapshot), now);\n  }\n}"
          replacement_content: "    upsertAudit.run(\n      productId,\n      photo.searchQuery,\n      \'Added Successfully\',\n      photo.imageUrl,\n      photo.thumbnailUrl,\n      photo.sourceUrl,\n      photo.licenseInfo,\n      photo.imageFormat,\n      photo.imageResolution,\n      photo.imageBytes,\n      photo.reason,\n      \'owner@prettycharm.in\',\n      now,\n      now\n    );\n  }\n\n  // 8. Ensure Gift Hampers are priced at \342\202\271299 and \342\202\271499 and active for browsing & WhatsApp-assisted ordering\n  const hamperConfigs = [\n    {\n      id: \'prod-mini-hamper\',\n      pricePaise: 29900,\n      costPaise: 12500,\n      packagingPaise: 2500,\n      description:\n        \'Curated Pretty Charm Mini Hamper (\342\202\271299) presented in a signature blush keepsake box with a mulberry satin scrunchie, pearl hair clip, and gift note card.\',\n      tags: [\'Hamper\', \'Gift Box\', \'\342\202\271299 Hamper\'],\n      imageUrl: ARTWORK.hamperMini,\n    },\n    {\n      id: \'prod-bestie-box\',\n      pricePaise: 29900,\n      costPaise: 12500,\n      packagingPaise: 2500,\n      description:\n        \'Thoughtful Pretty Charm Bestie Box (\342\202\271299) featuring a blush satin pearl bow barrette, pastel scrunchie duo, and keepsake rigid gift box.\',\n      tags: [\'Hamper\', \'Bestie Gift\', \'\342\202\271299 Hamper\'],\n      imageUrl: ARTWORK.hamperBestie,\n    },\n    {\n      id: \'prod-premium-box\',\n      pricePaise: 49900,\n      costPaise: 21000,\n      packagingPaise: 3500,\n      description:\n        \'Pretty Charm Premium Box (\342\202\271499) curated with a rose-gold pearl hair claw, mulberry silk scrunchie trio, dainty pendant necklace, and magnetic keepsake box.\',\n      tags: [\'Hamper\', \'Luxury Gift\', \'\342\202\271499 Hamper\'],\n      imageUrl: ARTWORK.hamperPremium,\n    },\n    {\n      id: \'prod-celebration-box\',\n      pricePaise: 49900,\n      costPaise: 21000,\n      packagingPaise: 3500,\n      description:\n        \'Pretty Charm Celebration Box (\342\202\271499) featuring crystal drop earrings, velvet pearl headband, satin bow clip, and festive rose-gold foiled gift box.\',\n      tags: [\'Hamper\', \'Celebration\', \'\342\202\271499 Hamper\'],\n      imageUrl: ARTWORK.hamperCelebration,\n    },\n  ];\n\n  const updateHamperStmt = db.prepare(`\n    UPDATE products\n    SET selling_price_paise = ?,\n        purchase_cost_paise = CASE WHEN purchase_cost_paise <= 0 THEN ? ELSE purchase_cost_paise END,\n        packaging_cost_paise = ?,\n        description = CASE WHEN description LIKE \'Draft catalogue entry%\' THEN ? ELSE description END,\n        tags_json = ?,\n        stock_qty = CASE WHEN stock_qty <= 0 THEN 12 ELSE stock_qty END,\n        status = \'active\',\n        confirmed_by_admin = 1,\n        updated_at = ?\n    WHERE id = ?\n  `);\n\n  for (const h of hamperConfigs) {\n    updateHamperStmt.run(\n      h.pricePaise,\n      h.costPaise,\n      h.packagingPaise,\n      h.description,\n      JSON.stringify(h.tags),\n      now,\n      h.id\n    );\n  }\n\n  // Ensure general store_settings defaults to WhatsApp-assisted payment workflow\n  const generalRow = db\n    .prepare(\"SELECT value_json FROM store_settings WHERE key = \'general\'\")\n    .get() as { value_json: string } | undefined;\n  if (generalRow) {\n    try {\n      const parsedGeneral = JSON.parse(generalRow.value_json);\n      let changed = false;\n      if (!parsedGeneral.paymentMode || parsedGeneral.paymentMode === \'demo\') {\n        parsedGeneral.paymentMode = (process.env.PAYMENT_MODE as any) || \'whatsapp\';\n        changed = true;\n      }\n      if (parsedGeneral.manualPaymentLink === undefined) {\n        parsedGeneral.manualPaymentLink = process.env.PAYMENT_MANUAL_LINK || \'\';\n        changed = true;\n      }\n      if (parsedGeneral.manualPaymentQrUrl === undefined) {\n        parsedGeneral.manualPaymentQrUrl = process.env.PAYMENT_MANUAL_QR_URL || \'\';\n        changed = true;\n      }\n      if (changed) {\n        db.prepare(\"UPDATE store_settings SET value_json = ?, updated_at = ? WHERE key = \'general\'\").run(\n          JSON.stringify(parsedGeneral),\n          now\n        );\n      }\n    } catch {\n      // ignore JSON parse error\n    }\n  }\n\n  // Save/refresh baseline product integrity snapshot in store_settings\n  const prods = db.prepare(\'SELECT * FROM products ORDER BY id ASC\').all() as any[];\n  const vars = db.prepare(\'SELECT * FROM product_variants ORDER BY id ASC\').all() as any[];\n  const snapshot = prods.map((p) => ({\n    id: p.id,\n    name: p.name,\n    slug: p.slug,\n    categorySlug: p.category_slug,\n    sku: p.sku,\n    sellingPricePaise: p.selling_price_paise,\n    stockQty: p.stock_qty,\n    status: p.status,\n    variantSkus: vars.filter((v) => v.product_id === p.id).map((v) => v.sku),\n  }));\n  db.prepare(`\n    INSERT INTO store_settings (key, value_json, updated_at) VALUES (\'catalogue_integrity_baseline\', ?, ?)\n    ON CONFLICT(key) DO UPDATE SET value_json = excluded.value_json, updated_at = excluded.updated_at\n  `).run(JSON.stringify(snapshot), now);\n}"
