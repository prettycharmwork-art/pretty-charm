            lines {
              text: "  if (digits.length === 11 && digits.startsWith(\'0\')) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return digits.slice(1);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return digits;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
