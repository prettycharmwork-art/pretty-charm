      arguments_json: "{\"CommandLine\":\"playwright-cli eval \\\"async () => {\\n  const res = await fetch(\'/api/storefront\');\\n  const data = await res.json();\\n  const hampers = data.products.filter(p => p.categorySlug === \'gift-hampers\' && p.status === \'active\');\\n  return hampers.map(h => ({ id: h.id, slug: h.slug, price: h.sellingPricePaise / 100 }));\\n}\\\" && \\\\\\nplaywright-cli click \\\"[data-testid=\'add-to-cart-blush-petite-charm-hamper\']\\\" && \\\\\\nplaywright-cli click \\\"[data-testid=\'header-cart-btn\']\\\" && \\\\\\nplaywright-cli click \\\"[data-testid=\'proceed-to-checkout-btn\']\\\" && \\\\\\nplaywright-cli fill \\\"input[name=\'fullName\']\\\" \\\"Aarohi Sharma\\\" && \\\\\\nplaywright-cli fill \\\"input[name=\'mobile\']\\\" \\\"9876543210\\\" && \\\\\\nplaywright-cli fill \\\"input[name=\'houseFlat\']\\\" \\\"Flat 402, Roseate Residency\\\" && \\\\\\nplaywright-cli fill \\\"input[name=\'streetLocality\']\\\" \\\"Bandra West, Carter Road\\\" && \\\\\\nplaywright-cli fill \\\"input[name=\'city\']\\\" \\\"Mumbai\\\" && \\\\\\nplaywright-cli fill \\\"input[name=\'pincode\']\\\" \\\"400050\\\" && \\\\\\nplaywright-cli fill \\\"textarea\\\" \\\"Please include a birthday ribbon\\\" && \\\\\\nplaywright-cli click \\\"[data-testid=\'place-order-submit-btn\']\\\" && \\\\\\nplaywright-cli screenshot --filename=.playwright-cli/order-whatsapp-handoff.png && \\\\\\nplaywright-cli eval \\\"() => {\\n  const btn = document.querySelector(\'[data-testid=\\\\\\\"order-via-whatsapp-btn\\\\\\\"]\');\\n  const notice = document.querySelector(\'[data-testid=\\\\\\\"whatsapp-press-send-notice\\\\\\\"]\');\\n  const preview = document.querySelector(\'[data-testid=\\\\\\\"whatsapp-order-message-preview\\\\\\\"]\');\\n  const orderNum = document.querySelector(\'[data-testid=\\\\\\\"confirmed-order-number\\\\\\\"]\');\\n  const orderStatus = document.querySelector(\'[data-testid=\\\\\\\"confirmed-order-status\\\\\\\"]\');\\n  const paymentStatus = document.querySelector(\'[data-testid=\\\\\\\"confirmed-payment-status\\\\\\\"]\');\\n  if (!btn || !notice || !preview) throw new Error(\'Missing WhatsApp handoff elements\');\\n  return {\\n    orderNumber: orderNum?.textContent?.trim(),\\n    orderStatus: orderStatus?.textContent?.trim(),\\n    paymentStatus: paymentStatus?.textContent?.trim(),\\n    href: btn.getAttribute(\'href\')?.slice(0, 120),\\n    noticeText: notice.textContent.trim().slice(0, 140),\\n    previewText: preview.textContent.trim()\\n  };\\n}\\\"\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Testing customer checkout and WhatsApp handoff\", \"toolSummary\":\"Test customer checkout and WhatsApp handoff\"}"
