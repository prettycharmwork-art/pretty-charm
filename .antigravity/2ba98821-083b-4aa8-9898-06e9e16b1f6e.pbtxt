      thinking_signature: "\022\223\024\n\220\024\001i\024}\023\352\354\217\357\263\'cC4\034i\354&\323mO\356T_\353EJ\272\367#\221\235\b\366.m\235\023u\000\254\036s\201\004\214\340\000<\245%\237\036^h\244\016\253\330\034r\315\254<\247L\244\037dOh\177\f\321G\237\250l\211E\237\371\020O\222c\315)m4\000~\253z .\353$T\'R\037\370|\2435H\215\315\203\304\201\343\337n\374\0359]\254\346)\3638\264\243\335\227%gU\321\216\357y\343W\312\307`\363\2677\020\205\235\255\260\357A\325=\023\316\254c?\035K\030%\"\273z\037\212^=\261\243\2218\332\027q8\257\243\2201g7\201\037e9,\025+\245S\260q\177\270\016\314~\340Fr%\227p.\0232 &G_\027+K\v\224{eTfJeC\352x\'9\301\314\221Z\267\362\323\266\f\027\340\f\342u~\322\232\351G\3514\033\310h\265\376\233\0368\'1\273\000\035/\351\371\362\350\255\262r5\307d\315\243,\374V\315\003\330\337\250\255\221\245\376g\361\016\2400\367b\'H\375\0238\036`W\003\252-+\212\363_.\227\362Am\221\265\327\347s\361\234\306\251\"\263l%j\303\000\024\323\2421~Q\r\027\030\276\317!\342/Ht\006\324\030\212\242\240\3363\n<,\241\255\251?\370\033C\\\365!\302Lp\256\017\307\307E\362\244b&+\004B{\017\316\016\330\254Y\234\364=\354P\267\200\226M\026(\316\242A\246\313_!d\006\000\035\357m\243(\215\332\251>\260\201\016LY\362E\210%`\346\373\360\3420y,yWl\252\030\3501\307\017\214\335\001|\301*f\370FEM\020/Tx \031\333\356\323\334\232\001\270Y\364\256\367\317\270\316\000\277\036_\251`KS\2119\374\354[|\b\004\300v4\353\036%l-\"\362*n\253%\367\317\366+\306\204\314\334\263\230\033s\327T:\005\314t\267\250r\247\2502Im#x\3541\255O\217H\235\321\320x\017\271*\031O\\s;\306U\243\221\375a\255\244\235U/$nS\031\363\253\023\273\316\210\322#\302X\016\361\0354\344\267Tf\240\333p\276\263\325\236\354@\032\353u\b\027\331\337\021n\2522\2454W\350\023\260\f\205)8\2640\374\306\235\315\017?\362\340\210\351\376\177\006\320\346\316Fy-I@r\3470\003\323\255\267\363K\314\001\306w6\2128y\fN\301\376mnz\316\275\332\344+\243\330K\026c\3643w\245(\245\235\350\317^\245_!\016\237\0251\034\256\237\215\215\227\200a\257\353\025@4\021\364\r\325\020\351d\037\277\244L\003n\023\234\206\274{\377\241\332\207\020\026\261\272\'\200\"\354pnFl\242_\325\036\234(\372\241f\245p\324\354\325(d\213\200`!_\334\230\315Z\201\344\214Q:\365\362\362\321\313\272\265\301\211?\203\213\353h\263\224\032f\273xb\272.\356\233\330`{\337\016\034[\337\224M\273c\025\311\361\2438\322D\022\215;\235\242_(\251A\277;3\317|\037\034Dy\035\331\025\262\322\210\004\"e\301\311\327\326\312\246,/\344\320\276m\t\357\001\020\305\v\0364{3hN\006\343\002\340%\322\a\227\271Z\021+ewU(\340^3G\375x\t\314\270\262NG\217/&\305\306-]<*\320\350\274\326\002\255A\313&_j\334l|\337 H\2734\325\000\341\375\325\341Z\034\3553\315\304q\342\"\342a\200\352\247\035t\003\330\211\f\323\246[\036\362\214M\326M\v\351\302&P\200\216\371\246z\220%}\021\345\352YC\341g\313\251\233C\344\262;\366\265\375\310\311\300%8::\345J\251ZGfj\222\276l\247\223\332\306\276\235\347\301\211\226w}\341#\200\020_\365\202\240A\272*qBS\316\0243\352\0339H\320\035\361\207\221*\227\034Y\001p\024\373*\247\235\034hJ\"\016\341\241>b\256\352\262r\267PP,\230\241\346\t\330\024[\207\324ptt\362b\267\357w\271\226\205\361|q8\3306\262\312\276\025\230z\2348\215$v\020K;\272Z5Xg\276\271\312\033I\342\037\325_$2 u\234z4\032\2076\021,I\373\245\356\343\036\372<\301J]oj\370en\324)\363\003Dk\020IUw\342m2\373-\256\373\262\376\317\320\f\220\364t\v\255\224\272\256\003N\034\342\252\274\035\302\005\362\253\262w\350\261J\351I\271\354w\272%]\253&\234\377\225xzK_\204\336\260wI]\305\036\215K\314\257b\345)\365UQ\3056\232u7\352\254\220j\"\001\364\017\334b\017\233V\264RV\264\270/N*\317\324\207\332\030\000\235\363G\260\204\326\300\016\254\263\346!\215c\355\242c\017\245\257|\351\2149A?\325\333\312u\031d\337\215\202\264(<\a\355\260\244v\201\020\266.\274\252DiM\364\241\005k\321\334\322\265\223\217\2675:\243\211\v$&\306\366\003\366b\202H\352nU\255\205dM\030\000\240t.\322\270\210\374\256\302t\342\316\226Kx}YD\370~\026\224\2747\020v0\231\256\373\252{\205cC\373/\265e\353\207\347\205k\266\354\032\306\0334l!\252\037\200)Q\214\214\372Z\f\b\377\262(