            }
            lines {
              text: "      e.eventTimestamp === incomingEvent.eventTimestamp &&"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      e.location === incomingEvent.location"
