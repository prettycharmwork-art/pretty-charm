            lines {
              text: "export function calculateCustomerShippingFeePaise("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  subtotalPaise: number,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
