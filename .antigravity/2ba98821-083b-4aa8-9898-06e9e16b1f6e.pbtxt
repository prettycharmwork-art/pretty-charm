    content: "import React, { useEffect, useState } from \'react\';\nimport {\n  LayoutDashboard,\n  Package,\n  FolderKanban,\n  Warehouse,\n  Truck,\n  ShoppingBag,\n  Users,\n  TrendingUp,\n  Calculator,\n  Receipt,\n  MapPin,\n  FileSpreadsheet,\n  MessageCircle,\n  Settings,\n  ShieldCheck,\n  LogOut,\n  Plus,\n  Download,\n  CheckCircle2,\n  AlertTriangle,\n  ArrowLeft,\n} from \'lucide-react\';\nimport { formatINR, rupeesToPaise, paiseToRupees } from \'../shared/domainLogic\';\nimport { ARTWORK } from \'../assets/productArtwork\';\n\ninterface AdminDashboardProps {\n  onBackToStorefront: () => void;\n  onCatalogueUpdated: () => void;\n}\n\ntype AdminTab =\n  | \'overview\'\n  | \'products\'\n  | \'categories\'\n  | \'inventory\'\n  | \'purchases\'\n  | \'orders\'\n  | \'customers\'\n  | \'sales\'\n  | \'profit\'\n  | \'expenses\'\n  | \'shipping\'\n  | \'exports\'\n  | \'integrations\'\n  | \'settings\'\n  | \'audit\';\n\nexport const AdminDashboard: React.FC<AdminDashboardProps> = ({\n  onBackToStorefront,\n  onCatalogueUpdated,\n}) => {\n  const [token, setToken] = useState<string | null>(null);\n  const [adminUser, setAdminUser] = useState<any | null>(null);\n  const [bootstrapped, setBootstrapped] = useState<boolean>(true);\n  const [authError, setAuthError] = useState<string | null>(null);\n  const [emailInput, setEmailInput] = useState(\'owner@prettycharm.in\');\n  const [passwordInput, setPasswordInput] = useState(\'\');\n  const [fullNameInput, setFullNameInput] = useState(\'Pretty Charm Owner\');"
