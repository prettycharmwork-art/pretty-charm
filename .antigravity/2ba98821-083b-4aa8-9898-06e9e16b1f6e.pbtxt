      thinking_signature: "\022\260\n\n\255\n\001i\024}\023\274\226\274\361\317\204\177b\023\315A\276\033\240u\022{l\216\234\304\305\250|\215\305\215\005\250y\262\232\343\251\254\361\331\260.\2461\342\341\022\213\237\226E-G\321\22699\320\216*F\023E\274\220\215|a\223\025\v\315\351\t\342\253\316\375\267\257\207\3732\325r\360\342\360i\350\325n5\236\365>PCe\304O\317){\206\306\357XL\017\265D\314\021,\334\345\346\244q\233|c\317\324q[,29\306\242;6(\265nl,\037\205\332Gf\361\271t\374\017H\215g\307\255\356\316\365O\213\020W\267\2272\323\241o\242z\nB\017\336\212\204=\\\000\r\037\357\335\242\337\220\016\321\305TN\344\221t\365\265\3002\230\177\'\232\311C\275\374v\243\375\327E9\342\vA\217\214\307\355\324\260m\217)fg\317NV\000\222\004\0273\272\212y\232K\273\355\320p\302\317\376\267\314\344\305\264\312?\003\271\274\020S\254\255\351e8\241\300\227R\221~d\270\203.\313y\252\a\371\235\231\206\017\177\3612+\267\337\025\001d\356d\235\033BO\206\2174\336\233\2102\2529\002\220>0!\223\005\240B\363\275#\221\256\204&\355\303\346@\313\"A\023<\v\t\312a7^\026\035\271\016\035\344\264q\324\245\224\236\302\323\nI\232\032\027x\357\205i\212Er\027Y|\306.b-o\232K3\002\263\177\377\315\271\322\225\361\266]\200yB\252yY9\351\255\374\345J\320\204#\t\321\037:\345\242\340\343\246\3011\357\336\rPy.\321\326m\'\310}\361\250\274\217\336\330y\332d\240\032\216z\030\340\305\340\213\346\300\365\026N\206f\370)$\302:H?\252\261\006\324\301\205i\347\215y?\371w\3456\242\017\354\236^\257?\024hb\177@Z\304\224\250\215\005\353\321j`\370\2708\017B\234\217\227EV\tr;sJ\377I\006|\v\277\200`\371\am\331\244?\356Y\350\263\000\241\r\032\200v\264\344\'\271~\376o\242\345_\332\364\351&\020\351:\233Y\340X\251\235l&\303\362f\340P\234q\224\b\303f;q\221\204\332\033&\363\271\'rn\331\233\245\315\033\021\341\334\321[\364\275\245\251S\024\207\250\272;Vj\21086C\261\314\341\2040]\357y\356\022\003I~\374\2674\025\023\323\317f\237\202\323k\001\0039\200\243\036\250\254\345\3728\222\334\262\200D\211\203U[f]\372s\247\331l\326\260\215\260\v\'\331c/\330Q\242Ox\v\315Rk\364x\275Re+\204\367L\223!\313phT\016\343\366-\26712W\353\031$\355\233\315\003+\331$\006\351[\037N(\267\345w\325j*\213\307D\271\331\"\035\216\3047\351\361\211\356]\0036\"\221\345;/4\2274\"\255]\337Q\360\361\3772j\367\265\n\204\221\002\274\253I\r\371O\370\376\026PT\323\346\341\335EL\351\233\342\002\236\371\265\377\263\360\203\314T\037\313\254\r\262\325HUm\\,\330\244#\031\016\320\237\336v\2352\234@\362\323SS\222\313\017\246+\364\037 \265\364\376cj\374\306\312M\271\375Z\362\214m\242r\367\273\333gO\363\220P\347\206@\273Co\203\234c\364TPh\004\377\243`\022V\310\274\341\371[\374(F\242oF\a\271\205\332\271:{\331\a\325\324\000\t\031\262\346$9\v\022\346\332\271+\216\356\250E\357e\267\311\025~\215XR\307\a\233{\304\002>\214\024\302\256\355\244$K\311\260Z\004\023O\272o/)R$a\3057\326\204Sg\277\016\a\304\202\345\350\036\247\a\262\266\022\032n\232$ *\215#}\004|\2270\303\370E\035\375\225\340\v\262\243\224\\\223u\371\332&\226\225\256\234^\373-\036P\225\307\2157\342\033\b}\327X\b\247\333\033\000\247hQ\223\321\340\317c\202\f2TLN\222\242\"\270\235\321z\351\361x\231\375\263\203@\320G\310Ae\331\241\016\213\227x\237\364/>%z7\033\226\255\343\220\3478%\036O\321\332\330\341M\211\"\330\242U\307)Zm\345\021\317\253\367\350\301\020C(\207\375K\tq\240\023\225\031S\235xdaZ+D\023L\314\267\256\re\0276\317\274d\346\232\254Xl\3737\313\366\213\037\177\262n\211`\035\f\006$M\333\027\224d56\302\371Y;\276\024e\320\301%\334\212@\026\233\302\346\350\027\271\252\336*\220\375i\327[s\037\314l)\037\374?olvV\2133\b\361\236\006\262\361\024\237\2003\366\260\267\305Z|z\005D7Y1\212\206\275\213t<+8\300 \304B\357\022!\323\341cs\355\364\327`?\223]\035e#k\352\005o\235\341\370\202\256\234\032\336\341\305\335\340\264\316\325\365<\352 \203\322\361\272A\t\226\311\211\334\356}g\314\360\360<\2723l[\234\005\333\345\006\"i\340\037\3208\212]F\n\311\002\354p\317\330\255(9\324\222\355\364>!"
