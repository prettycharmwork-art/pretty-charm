        replacement_chunks {
          target_content: "  const handleVerifyManualPayment = async (order: any) => {\n    if (!token) return;\n    try {\n      const res = await fetch(`/api/admin/orders/${order.id}/verify-payment`, {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`,\n        },\n        body: JSON.stringify({\n          bankReferenceUtr: utrInput || order.customerSubmittedRef,\n          verifiedAmountPaise: order.totalPaise,\n        }),\n      });\n      const json = await res.json();\n      if (!res.ok) throw new Error(json.error);\n      showNotice(`Verified payment for ${order.orderNumber}`);\n      setUtrInput(\'\');\n      await fetchOverview();\n    } catch (err: any) {\n      setErrorMsg(err.message);\n    }\n  };"
          replacement_content: "  const handleVerifyManualPayment = async (order: any) => {\n    if (!token) return;\n    try {\n      const refValue =\n        (selectedOrderId === order.id ? utrInput.trim() : \'\') ||\n        order.customerSubmittedRef ||\n        `BANK-VERIFIED-${order.orderNumber}`;\n      const res = await fetch(`/api/admin/orders/${order.id}/verify-payment`, {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`,\n        },\n        body: JSON.stringify({\n          bankReferenceUtr: refValue,\n          verifiedAmountPaise: order.totalPaise,\n        }),\n      });\n      const json = await res.json();\n      if (!res.ok) throw new Error(json.error);\n      showNotice(\n        `Payment marked received (paid) for ${order.orderNumber} by ${json.verifiedByAdminEmail}. You can now confirm the order.`\n      );\n      setUtrInput(\'\');\n      await fetchOverview();\n    } catch (err: any) {\n      setErrorMsg(err.message);\n    }\n  };\n\n  const handleConfirmOrder = async (order: any) => {\n    if (!token) return;\n    setConfirmingOrderId(order.id);\n    try {\n      const res = await fetch(`/api/admin/orders/${order.id}/confirm`, {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`,\n        },\n        body: JSON.stringify({\n          note: `Order confirmed after verified bank/UPI payment.`,\n        }),\n      });\n      const json = await res.json();\n      if (!res.ok) throw new Error(json.error);\n      showNotice(\n        `Order ${order.orderNumber} confirmed! Click \"Send Confirmation via WhatsApp\" to open the customer chat with the prefilled confirmation message.`\n      );\n      await fetchOverview();\n      onCatalogueUpdated();\n    } catch (err: any) {\n      setErrorMsg(err.message);\n    } finally {\n      setConfirmingOrderId(null);\n    }\n  };"
