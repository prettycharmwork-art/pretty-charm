      arguments_json: "{\"CommandLine\":\"playwright-cli open \\\"http://localhost:3000?autostart=1\\\" && \\\\\\nplaywright-cli resize 1440 900 && \\\\\\nplaywright-cli run-code \\\"async page => { await page.waitForSelector(\'[data-testid=\\\\\\\"hero-shop-btn\\\\\\\"]\', { timeout: 10000 }); }\\\" && \\\\\\nplaywright-cli screenshot --filename=/tmp/pc-desktop-home.png && \\\\\\nplaywright-cli run-code \\\"async page => {\\n  // Verify draft hamper button text\\n  const draftText = await page.locator(\'[data-testid^=\\\\\\\"non-purchasable-\\\\\\\"]\').first().textContent();\\n  console.log(\'Draft button text:\', draftText?.trim());\\n  // Add first active product to cart\\n  await page.locator(\'[data-testid^=\\\\\\\"add-to-cart-\\\\\\\"]\').first().click();\\n  await page.locator(\'[data-testid=\\\\\\\"header-cart-btn\\\\\\\"]\').click();\\n  await page.waitForSelector(\'[data-testid=\\\\\\\"proceed-to-checkout-btn\\\\\\\"]\');\\n  const totalText = await page.locator(\'[data-testid=\\\\\\\"cart-grand-total\\\\\\\"]\').textContent();\\n  console.log(\'Cart grand total:\', totalText?.trim());\\n  await page.locator(\'[data-testid=\\\\\\\"proceed-to-checkout-btn\\\\\\\"]\').click();\\n  await page.fill(\'input[name=\\\\\\\"fullName\\\\\\\"]\', \'Ananya Sharma\');\\n  await page.fill(\'input[name=\\\\\\\"mobile\\\\\\\"]\', \'9876543210\');\\n  await page.fill(\'input[name=\\\\\\\"houseFlat\\\\\\\"]\', \'Flat 402, DLF Phase 4\');\\n  await page.fill(\'input[name=\\\\\\\"streetLocality\\\\\\\"]\', \'Sector 28, Galleria Road\');\\n  await page.locator(\'[data-testid=\\\\\\\"place-order-submit-btn\\\\\\\"]\').click();\\n  await page.waitForSelector(\'[data-testid=\\\\\\\"confirmed-order-number\\\\\\\"]\');\\n  const orderNum = await page.locator(\'[data-testid=\\\\\\\"confirmed-order-number\\\\\\\"]\').textContent();\\n  console.log(\'Confirmed Order Number:\', orderNum?.trim());\\n  await page.locator(\'[data-testid=\\\\\\\"track-this-order-btn\\\\\\\"]\').click();\\n  await page.locator(\'[data-testid=\\\\\\\"track-order-submit-btn\\\\\\\"]\').click();\\n  await page.waitForSelector(\'[data-testid=\\\\\\\"tracked-order-eta\\\\\\\"]\');\\n  const etaText = await page.locator(\'[data-testid=\\\\\\\"tracked-order-eta\\\\\\\"]\').textContent();\\n  console.log(\'Tracked Order ETA:\', etaText?.trim());\\n}\\\" && \\\\\\nplaywright-cli screenshot --filename=/tmp/pc-order-tracked.png && \\\\\\nplaywright-cli run-code \\\"async page => {\\n  await page.locator(\'[data-testid=\\\\\\\"open-admin-btn\\\\\\\"]\').click();\\n  await page.waitForTimeout(600);\\n}\\\" && \\\\\\nplaywright-cli screenshot --filename=/tmp/pc-admin.png && \\\\\\nplaywright-cli resize 390 844 && \\\\\\nplaywright-cli goto \\\"http://localhost:3000?autostart=1\\\" && \\\\\\nplaywright-cli run-code \\\"async page => { await page.waitForSelector(\'[data-testid=\\\\\\\"hero-shop-btn\\\\\\\"]\'); }\\\" && \\\\\\nplaywright-cli screenshot --filename=/tmp/pc-mobile.png && \\\\\\nplaywright-cli console error && \\\\\\nplaywright-cli close\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Verifying Pretty Charm journeys in headless Chromium\", \"toolSummary\":\"Run Playwright verification journeys\"}"
