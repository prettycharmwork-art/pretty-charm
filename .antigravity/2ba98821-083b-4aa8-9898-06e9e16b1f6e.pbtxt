      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add vite-plugin-pwa/client and node types to tsconfig.json\", \"EndLine\":10, \"Instruction\":\"Update types array in tsconfig.json\", \"ReplacementContent\":\"    \\\"module\\\": \\\"ESNext\\\",\\n    \\\"types\\\": [\\\"vite/client\\\", \\\"vite-plugin-pwa/client\\\", \\\"node\\\"],\\n    \\\"lib\\\": [\", \"StartLine\":5, \"TargetContent\":\"    \\\"module\\\": \\\"ESNext\\\",\\n    \\\"types\\\": [\\\"vite/client\\\"],\\n    \\\"lib\\\": [\", \"TargetFile\":\"/tsconfig.json\", \"toolAction\":\"Updating tsconfig.json with PWA and Node types\", \"toolSummary\":\"Update tsconfig.json types\"}"
