            }
            lines {
              text: "      const diff = b.sellingPricePaise - a.sellingPricePaise;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (diff !== 0) return diff;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
