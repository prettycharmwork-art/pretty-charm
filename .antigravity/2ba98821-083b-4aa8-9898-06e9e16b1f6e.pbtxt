      thinking_signature: "\022\342\r\n\337\r\001i\024}\023,\225/\262l\253\031\306\206>\210\277\271\220bq\334,\036Y\235\375 \021@^+\2237\205\206\233\342\031\263\240\224\226\r\026\003\023:\204\\u\023\302\025GQ\273\312(H\023*\0328\327\372W\211\264p\330o\362\312|FMH\2777\242\235o:\f\271\303\263\371<\267d\252\177\361\335q4m\030V\316b^SCa\351\364\231\006x\275\252\224\220\323(\336\005\035r\253a\226\365\376\266@:\035\030\027\353\317\317\221\022-\216\372\212\213\253q`I\206\277\024\342\223,8\026\006\005H\250r\034x\237\233\030\361\b\303\375\313\027\200X\342z\344\221\337=\332\323\033\371\200[\302X\341A\301\030\2021\357,\337f\244(,%\vA0\217\277\274;;\243*\004\374\351#\362\273\025\0324\234\352\036\031\211$\003\252[\210\331(\221\261\250v\020\250&\245#\"\321\374(J\aXIb\366\236\314^k0\207`\001\2144\371J\212\252\232eC\346\253\224gS1 `X\352\275\324\216T\333&0k\001,\365\024]sX\301\247C\320\272_\236\324\016\314(o\347E.\035YW7\235-\366\362\232#\376*i&\305#\321AC\212W\3265\221@\327\362T\366\306\250\330TOy9\005M\016\375v\025\"\033Z\201Ad\275\036I\3562\257|T\n\234MB\306\206.\223\024\'\247\355\240\276\241O\250>k\022s\000\240Y\370\025\263\ff\235\236\313\212\273\372\024p\361_\246\305\342*m\365mN\204\371\274}\366\360Ja7\3357\376\206\330\314\341\261\277\310^3\200\363@\274\255\017\337\371\363\020\221\243~>2\2465\301\177N\221u\b\311U\000\346\203\274(X\241\350\200\212\361C\351`7}| K/fA\207O\362\233\330\034us\242z0\030\306\227\305u\217\317\254C\202g\036[\022\314\370J\b\017\206\333<k/pX\250\265f`Gn}\322\021\301\265\201$\']q\304\234u\364\250;%\310\320z\223\030\363\027\016\204x\201\247-\223\251\0045Jud9\345\r\3131\177\275U|\003Q\2436\"p\3425\211\215\033\262@mYq\363\017\267\271\347?\262co\273\311\346\371\016=\204\004\313\272\217\244F3\024\2234y\306*\364\365\275\026\331)7\313\205\321&\254\372\rtO\277\001\246\257wA\215\262\256/\273\004\326}\023\247\364\344rw\253\302]Mc}\246z%\345\362W\346F.\232\355!)\326\261\206\351\237\340\335\343\031\035\307\304\0211\224R0\261\216K1\265\212\333!5\242n\200\317\003^\215$