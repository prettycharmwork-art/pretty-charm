      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Configure package.json scripts to run full-stack Express server with tsx and unit test script\", \"EndLine\":13, \"Instruction\":\"Update scripts in package.json for server.ts and unit tests\", \"ReplacementContent\":\"  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"tsx server.ts\\\",\\n    \\\"build\\\": \\\"vite build\\\",\\n    \\\"start\\\": \\\"NODE_ENV=production tsx server.ts\\\",\\n    \\\"preview\\\": \\\"vite preview\\\",\\n    \\\"clean\\\": \\\"rm -rf dist server.js\\\",\\n    \\\"lint\\\": \\\"tsc --noEmit\\\",\\n    \\\"test\\\": \\\"tsx --test src/shared/domainLogic.test.ts\\\"\\n  },\", \"StartLine\":6, \"TargetContent\":\"  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"vite --port=3000 --host=0.0.0.0\\\",\\n    \\\"build\\\": \\\"vite build\\\",\\n    \\\"preview\\\": \\\"vite preview\\\",\\n    \\\"clean\\\": \\\"rm -rf dist server.js\\\",\\n    \\\"lint\\\": \\\"tsc --noEmit\\\"\\n  },\", \"TargetFile\":\"/package.json\", \"toolAction\":\"Updating package.json scripts for full-stack server and tests\", \"toolSummary\":\"Update package.json scripts\"}"
      thinking_signature: "\022\314\004\n\311\004\001i\024}\023{\351\335\264\366?\3643\a((Q\264G\302\203\241\006:\032XwBx\366<q;G\244\002\247\206\2534pT\372\301B|GO\370v\217\020\311\030\216\314\341\265\314S\217?\033\272I\331\004\265\227\"\004\001\240k8\225\364\372\360Gc2J\250\000\204\330-\223\202\237\347\366\017t\361$\330\034H\221\376G\260\037\210\327\036\315\201}\301\371riU\347\312\017\032\225\337TZaf\312\343\200&~;\021\361\r\213\224\021\343\244\237\325\2010%!0\352\022/\tG\246L\256\000\366\230\342}L\304\200\334\364J\210\307d\221\375<\231\2351\346\204\345\242N\204\215]8\304\214\304 &f\206\316\037:\234\306\250KB\002\215\r\333;\3702ML\364\361\025\254Y\326\a\351F\247%\347%\303.\355\231\222\f\037\350eX\263\321\226\303<\225\374\226\353Z~\303\307]d`\035X\223\022\242\375\032\336\340\372\000mDKs\361\277p\242\017\306\t\341O\031\272\211\375\320x{\332\215\215\234\a\a2\025\037KE\374\241\f\245|\312\321@\222\260xzJ\256&\032\252\002\207\330\'\202\331\254H\270\231\376)\202\252\b\365;t\263,\220\r\242\371p\372t\2544\342{\324\036<\250V\243\225oB\2345\n ] \216el:\036\017\236\242_\'\256]-y\372\243e\324\2712R\273\252\000\227\220\360<\3358\351\360\2365\232\030\372\0260;\234\277\344\2057=bM\276\337f\336\375\377\337\236\024\226\356\312\201\255\203\254\006\304\366\222\t\332\323\267\205\374\270\321\363\314\v\320\321\327\364G]\304\213\370\003\266_\332>\365<\276\363\220\306\375?\350g\271b\263\024\020\370\264\312r\302>MC\231\306\346p4>\330\227\330\311\371\261\272b\215bb\274f\245O<]`\260X\"\373\274\237MHfs_\256;\335\315*\002\242\315\034\336Q\375\r\362\220\3168US\0321\357:\222\016\305SI8\232\354rGY\250\005\371*\221h\275\006\354\300\257\203-\270\325\3013w\211\3719\250\032B\nz\366\233\321*\234[\272*\245\204\256\377a\360d\257\000\316\213\230\235`"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_228205"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * Pure domain logic for Pretty Charm E-Commerce Platform.\\n * Handles integer paise arithmetic, shipping calculation, PIN code validation,\\n * publication rules, Weighted Average Cost (WAC) inventory valuation,\\n * stock reservations/releases, payment verification safeguards, order tracking\\n * phone verification, courier webhook deduplication, and spreadsheet escaping.\\n */\\n\\nexport type ProductStatus = \'active\' | \'draft\' | \'coming-soon\' | \'out-of-stock\' | \'archived\';\\n\\nexport type OrderStatus =\\n  | \'Pending Confirmation\'\\n  | \'Confirmed\'\\n  | \'Processing\'\\n  | \'Packed\'\\n  | \'Shipped\'\\n  | \'Delivered\'\\n  | \'Cancelled\'\\n  | \'Return Requested\'\\n  | \'Returned\'\\n  | \'Refunded\';\\n\\nexport type PaymentStatus =\\n  | \'Demo Mode - Not Paid\'\\n  | \'Pending\'\\n  | \'Awaiting Verification\'\\n  | \'Paid\'\\n  | \'Failed\'\\n  | \'Refunded\';\\n\\nexport type ShipmentStatus =\\n  | \'Not Shipped\'\\n  | \'AWB Assigned\'\\n  | \'Picked Up\'\\n  | \'In Transit\'\\n  | \'Out for Delivery\'\\n  | \'Delivered\'\\n  | \'RTO / Returned\';\\n\\nexport type PaymentMode = \'demo\' | \'manual\' | \'razorpay\';\\n\\nexport interface ShippingRuleConfig {\\n  tier1MaxSubtotalPaise: number; // default 49900 (\342\202\271499)\\n  tier1FeePaise: number;         // default 5900 (\342\202\27159)\\n  tier2MaxSubtotalPaise: number; // default 99900 (\342\202\271999)\\n  tier2FeePaise: number;         // default 3900 (\342\202\27139)\\n  freeShippingThresholdPaise: number; // default 99900 (\342\202\271999)\\n}\\n\\nexport const DEFAULT_SHIPPING_RULES: ShippingRuleConfig = {\\n  tier1MaxSubtotalPaise: 49900,\\n  tier1FeePaise: 5900,\\n  tier2MaxSubtotalPaise: 99900,\\n  tier2FeePaise: 3900,\\n  freeShippingThresholdPaise: 99900,\\n};\\n\\nexport interface ServiceablePinCode {\\n  pincode: string;\\n  city: string;\\n  state: string;\\n  isServiceable: boolean;\\n  codAvailable: boolean;\\n}\\n\\nexport interface DomainProduct {\\n  id: string;\\n  name: string;\\n  slug: string;\\n  sku: string;\\n  categorySlug: string;\\n  status: ProductStatus;\\n  sellingPricePaise: number;\\n  purchaseCostPaise: number;\\n  packagingCostPaise: number;\\n  stockQty: number;\\n  reservedQty: number;\\n  lowStockThreshold: number;\\n}\\n\\nexport interface DomainVariant {\\n  id: string;\\n  productId: string;\\n  name: string;\\n  sku: string;\\n  priceDeltaPaise: number;\\n  stockQty: number;\\n  reservedQty: number;\\n}\\n\\nexport interface CheckoutCartItemInput {\\n  productId: string;\\n  variantId?: string;\\n  quantity: number;\\n  clientSubmittedPricePaise?: number; // Ignored by server calculation\\n}\\n\\nexport interface ValidatedOrderItemSnapshot {\\n  productId: string;\\n  variantId: string | null;\\n  productName: string;\\n  variantName: string | null;\\n  sku: string;\\n  quantity: number;\\n  unitPricePaise: number;\\n  lineTotalPaise: number;\\n  unitCostSnapshotPaise: number;\\n  packagingCostSnapshotPaise: number;\\n}\\n\\nexport interface CheckoutAddressInput {\\n  fullName: string;\\n  mobile: string;\\n  houseFlat: string;\\n  streetLocality: string;\\n  city: string;\\n  state: string;\\n  pincode: string;\\n  deliveryInstructions?: string;\\n}\\n\\n// ============================================================================\\n// 1. CURRENCY ARITHMETIC (INTEGER PAISE)\\n// ============================================================================\\n\\nexport function rupeesToPaise(rupees: number): number {\\n  if (!Number.isFinite(rupees) || rupees < 0) {\\n    throw new Error(\'Invalid INR rupee amount\');\\n  }\\n  return Math.round(rupees * 100);\\n}\\n\\nexport function paiseToRupees(paise: number): number {\\n  return Math.round(paise) / 100;\\n}\\n\\nexport function formatINR(paise: number, showDecimals = false): string {\\n  const rupees = paise / 100;\\n  return new Intl.NumberFormat(\'en-IN\', {\\n    style: \'currency\',\\n    currency: \'INR\',\\n    minimumFractionDigits: showDecimals ? 2 : 0,\\n    maximumFractionDigits: showDecimals ? 2 : 0,\\n  }).format(rupees);\\n}\\n\\n// ============================================================================\\n// 2. PRODUCT PUBLICATION & STOCK AVAILABILITY RULES\\n// ============================================================================\\n\\nexport function getAvailableStock(stockQty: number, reservedQty: number): number {\\n  return Math.max(0, Math.floor(stockQty) - Math.floor(reservedQty));\\n}\\n\\nexport function canCustomerPurchaseProduct(\\n  product: DomainProduct,\\n  requestedQty: number,\\n  categoryStatus: \'active\' | \'coming-soon\' = \'active\',\\n  variant?: DomainVariant | null\\n): { allowed: boolean; reason?: string } {\\n  if (!Number.isInteger(requestedQty) || requestedQty <= 0) {\\n    return { allowed: false, reason: \'Quantity must be a positive integer.\' };\\n  }\\n  if (categoryStatus === \'coming-soon\') {\\n    return { allowed: false, reason: \'This category is Coming Soon and not yet open for purchase.\' };\\n  }\\n  if (product.status === \'draft\') {\\n    return {\\n      allowed: false,\\n      reason: `\\\"${product.name}\\\" is currently an unconfirmed draft awaiting owner approval and cannot be purchased.`,\\n    };\\n  }\\n  if (product.status === \'coming-soon\') {\\n    return {\\n      allowed: false,\\n      reason: `\\\"${product.name}\\\" is Coming Soon and cannot be purchased yet.`,\\n    };\\n  }\\n  if (product.status === \'archived\') {\\n    return {\\n      allowed: false,\\n      reason: `\\\"${product.name}\\\" is archived and no longer available.`,\\n    };\\n  }\\n  if (product.status === \'out-of-stock\') {\\n    return {\\n      allowed: false,\\n      reason: `\\\"${product.name}\\\" is currently out of stock.`,\\n    };\\n  }\\n\\n  const available = variant\\n    ? getAvailableStock(variant.stockQty, variant.reservedQty)\\n    : getAvailableStock(product.stockQty, product.reservedQty);\\n\\n  if (available < requestedQty) {\\n    return {\\n      allowed: false,\\n      reason:\\n        available === 0\\n          ? `\\\"${product.name}\\\" is out of stock.`\\n          : `Only ${available} unit(s) of \\\"${product.name}\\\" available in stock.`,\\n    };\\n  }\\n\\n  return { allowed: true };\\n}\\n\\nexport function validateProductPublication(product: {\\n  name: string;\\n  sellingPricePaise: number;\\n  stockQty: number;\\n  description: string;\\n  confirmedByAdmin: boolean;\\n}): { valid: boolean; reason?: string } {\\n  if (!product.confirmedByAdmin) {\\n    return { valid: false, reason: \'Admin must confirm actual contents, stock, and selling price before publishing.\' };\\n  }\\n  if (!product.name || product.name.trim().length < 3) {\\n    return { valid: false, reason: \'Product name must be at least 3 characters.\' };\\n  }\\n  if (!Number.isInteger(product.sellingPricePaise) || product.sellingPricePaise <= 0) {\\n    return { valid: false, reason: \'Selling price must be greater than \342\202\2710.\' };\\n  }\\n  if (!Number.isInteger(product.stockQty) || product.stockQty < 0) {\\n    return { valid: false, reason: \'Stock quantity cannot be negative.\' };\\n  }\\n  if (!product.description || product.description.trim().length < 10) {\\n    return { valid: false, reason: \'Confirmed product description must be at least 10 characters.\' };\\n  }\\n  return { valid: true };\\n}\\n\\n// ============================================================================\\n// 3. SHIPPING FEE ENGINE & INDIAN PIN-CODE VALIDATION\\n// ============================================================================\\n\\nexport function calculateCustomerShippingFeePaise(\\n  subtotalPaise: number,\\n  rules: ShippingRuleConfig = DEFAULT_SHIPPING_RULES\\n): number {\\n  if (subtotalPaise <= 0) return 0;\\n  if (subtotalPaise >= rules.freeShippingThresholdPaise) {\\n    return 0;\\n  }\\n  if (subtotalPaise >= rules.tier1MaxSubtotalPaise) {\\n    return rules.tier2FeePaise;\\n  }\\n  return rules.tier1FeePaise;\\n}\\n\\nexport function validateIndianPinCodeFormat(pincode: string): boolean {\\n  const cleaned = String(pincode || \'\').trim();\\n  return /^[1-9][0-9]{5}$/.test(cleaned);\\n}\\n\\nexport function checkPinCodeServiceability(\\n  pincode: string,\\n  configuredPins: ServiceablePinCode[]\\n): { validFormat: boolean; isServiceable: boolean; city?: string; state?: string; message: string } {\\n  const cleaned = String(pincode || \'\').trim();\\n  if (!validateIndianPinCodeFormat(cleaned)) {\\n    return {\\n      validFormat: false,\\n      isServiceable: false,\\n      message: \'Please enter a valid 6-digit Indian PIN code (e.g. 122001).\',\\n    };\\n  }\\n\\n  const match = configuredPins.find((p) => p.pincode === cleaned);\\n  if (!match || !match.isServiceable) {\\n    return {\\n      validFormat: true,\\n      isServiceable: false,\\n      message: `Delivery to PIN code ${cleaned} is not enabled yet. Please contact support on WhatsApp for special dispatch from Gurugram.`,\\n    };\\n  }\\n\\n  return {\\n    validFormat: true,\\n    isServiceable: true,\\n    city: match.city,\\n    state: match.state,\\n    message: `Ships from Gurugram to ${match.city}, ${match.state} (${cleaned}). Estimated delivery date will be shared once dispatched.`,\\n  };\\n}\\n\\n// ============================================================================\\n// 4. SERVER-SIDE CART & CHECKOUT VALIDATION\\n// ============================================================================\\n\\nexport function normalizeIndianMobile(mobile: string): string {\\n  const digits = String(mobile || \'\').replace(/\\\\D/g, \'\');\\n  if (digits.length === 12 && digits.startsWith(\'91\')) {\\n    return digits.slice(2);\\n  }\\n  if (digits.length === 11 && digits.startsWith(\'0\')) {\\n    return digits.slice(1);\\n  }\\n  return digits;\\n}\\n\\nexport function validateIndianMobile(mobile: string): boolean {\\n  const normalized = normalizeIndianMobile(mobile);\\n  return /^[6-9][0-9]{9}$/.test(normalized);\\n}\\n\\nexport function validateCheckoutAddress(\\n  address: CheckoutAddressInput,\\n  serviceablePins: ServiceablePinCode[]\\n): { valid: boolean; errors: string[] } {\\n  const errors: string[] = [];\\n\\n  if (!address.fullName || address.fullName.trim().length < 2) {\\n    errors.push(\'Customer full name is required.\');\\n  }\\n  if (!validateIndianMobile(address.mobile)) {\\n    errors.push(\'Valid 10-digit Indian mobile number starting with 6-9 is required.\');\\n  }\\n  if (!address.houseFlat || address.houseFlat.trim().length < 2) {\\n    errors.push(\'House / Flat / Building number is required.\');\\n  }\\n  if (!address.streetLocality || address.streetLocality.trim().length < 3) {\\n    errors.push(\'Street / Sector / Locality is required.\');\\n  }\\n  if (!address.city || address.city.trim().length < 2) {\\n    errors.push(\'City is required.\');\\n  }\\n  if (!address.state || address.state.trim().length < 2) {\\n    errors.push(\'State is required.\');\\n  }\\n\\n  const pinCheck = checkPinCodeServiceability(address.pincode, serviceablePins);\\n  if (!pinCheck.validFormat || !pinCheck.isServiceable) {\\n    errors.push(pinCheck.message);\\n  }\\n\\n  return { valid: errors.length === 0, errors };\\n}\\n\\nexport function computeServerSideCheckoutTotals(\\n  cartItems: CheckoutCartItemInput[],\\n  catalogueProducts: Map<string, DomainProduct>,\\n  catalogueVariants: Map<string, DomainVariant>,\\n  categoryStatusMap: Map<string, \'active\' | \'coming-soon\'>,\\n  shippingRules: ShippingRuleConfig = DEFAULT_SHIPPING_RULES\\n): {\\n  valid: boolean;\\n  error?: string;\\n  items: ValidatedOrderItemSnapshot[];\\n  subtotalPaise: number;\\n  shippingFeePaise: number;\\n  totalPaise: number;\\n} {\\n  if (!Array.isArray(cartItems) || cartItems.length === 0) {\\n    return {\\n      valid: false,\\n      error: \'Your shopping bag is empty.\',\\n      items: [],\\n      subtotalPaise: 0,\\n      shippingFeePaise: 0,\\n      totalPaise: 0,\\n    };\\n  }\\n\\n  // Combine duplicate lines for the same product + variant so stock checks cannot be bypassed\\n  const aggregated = new Map<string, CheckoutCartItemInput>();\\n  for (const raw of cartItems) {\\n    const key = `${raw.productId}::${raw.variantId || \'\'}`;\\n    const existing = aggregated.get(key);\\n    if (existing) {\\n      existing.quantity += raw.quantity;\\n    } else {\\n      aggregated.set(key, { ...raw });\\n    }\\n  }\\n\\n  const validatedItems: ValidatedOrderItemSnapshot[] = [];\\n  let subtotalPaise = 0;\\n\\n  for (const item of aggregated.values()) {\\n    const product = catalogueProducts.get(item.productId);\\n    if (!product) {\\n      return {\\n        valid: false,\\n        error: `Product \\\"${item.productId}\\\" does not exist.`,\\n        items: [],\\n        subtotalPaise: 0,\\n        shippingFeePaise: 0,\\n        totalPaise: 0,\\n      };\\n    }\\n\\n    const variant = item.variantId ? catalogueVariants.get(item.variantId) || null : null;\\n    if (item.variantId && (!variant || variant.productId !== product.id)) {\\n      return {\\n        valid: false,\\n        error: `Selected variant for \\\"${product.name}\\\" is invalid.`,\\n        items: [],\\n        subtotalPaise: 0,\\n        shippingFeePaise: 0,\\n        totalPaise: 0,\\n      };\\n    }\\n\\n    const catStatus = categoryStatusMap.get(product.categorySlug) || \'active\';\\n    const check = canCustomerPurchaseProduct(product, item.quantity, catStatus, variant);\\n    if (!check.allowed) {\\n      return {\\n        valid: false,\\n        error: check.reason,\\n        items: [],\\n        subtotalPaise: 0,\\n        shippingFeePaise: 0,\\n        totalPaise: 0,\\n      };\\n    }\\n\\n    // Always use server-authoritative product & variant price (never clientSubmittedPricePaise)\\n    const unitPricePaise = product.sellingPricePaise + (variant ? variant.priceDeltaPaise : 0);\\n    const lineTotalPaise = unitPricePaise * item.quantity;\\n    subtotalPaise += lineTotalPaise;\\n\\n    validatedItems.push({\\n      productId: product.id,\\n      variantId: variant ? variant.id : null,\\n      productName: product.name,\\n      variantName: variant ? variant.name : null,\\n      sku: variant ? variant.sku : product.sku,\\n      quantity: item.quantity,\\n      unitPricePaise,\\n      lineTotalPaise,\\n      unitCostSnapshotPaise: product.purchaseCostPaise,\\n      packagingCostSnapshotPaise: product.packagingCostPaise,\\n    });\\n  }\\n\\n  const shippingFeePaise = calculateCustomerShippingFeePaise(subtotalPaise, shippingRules);\\n  const totalPaise = subtotalPaise + shippingFeePaise;\\n\\n  return {\\n    valid: true,\\n    items: validatedItems,\\n    subtotalPaise,\\n    shippingFeePaise,\\n    totalPaise,\\n  };\\n}\\n\\n// ============================================================================\\n// 5. WEIGHTED AVERAGE COST (WAC) & INVENTORY RESERVATION / RELEASE\\n// ============================================================================\\n\\nexport function calculateNewWeightedAverageCost(\\n  existingQty: number,\\n  existingUnitCostPaise: number,\\n  receivedQty: number,\\n  receivedUnitCostPaise: number\\n): number {\\n  if (receivedQty <= 0) return existingUnitCostPaise;\\n  const safeExistingQty = Math.max(0, existingQty);\\n  const totalValuePaise =\\n    safeExistingQty * existingUnitCostPaise + receivedQty * receivedUnitCostPaise;\\n  const newTotalQty = safeExistingQty + receivedQty;\\n  if (newTotalQty <= 0) return receivedUnitCostPaise;\\n  return Math.round(totalValuePaise / newTotalQty);\\n}\\n\\nexport function canReleaseReservationOnCancel(orderStatus: OrderStatus): boolean {\\n  const releasableStatuses: OrderStatus[] = [\\n    \'Pending Confirmation\',\\n    \'Confirmed\',\\n    \'Processing\',\\n    \'Packed\',\\n  ];\\n  return releasableStatuses.includes(orderStatus);\\n}\\n\\n// ============================================================================\\n// 6. PAYMENT SAFEGUARDS & VERIFICATION RULES\\n// ============================================================================\\n\\nexport function getInitialPaymentStatusForMode(mode: PaymentMode): PaymentStatus {\\n  if (mode === \'demo\') {\\n    return \'Demo Mode - Not Paid\';\\n  }\\n  if (mode === \'manual\') {\\n    return \'Awaiting Verification\';\\n  }\\n  return \'Pending\';\\n}\\n\\nexport function verifyManualPaymentByAdmin(params: {\\n  paymentMode: PaymentMode;\\n  adminUserId: string | null;\\n  adminRole: string | null;\\n  bankReferenceUtr: string;\\n  verifiedAmountPaise: number;\\n  expectedAmountPaise: number;\\n}): { allowed: boolean; newStatus?: PaymentStatus; reason?: string } {\\n  if (!params.adminUserId || !params.adminRole || ![\'owner\', \'admin\', \'finance\'].includes(params.adminRole)) {\\n    return { allowed: false, reason: \'Unauthorized: Only an authenticated Admin/Owner can verify payments.\' };\\n  }\\n  if (params.paymentMode === \'demo\') {\\n    return {\\n      allowed: false,\\n      reason: \'Demo mode orders cannot be marked as real Paid orders. Switch store payment mode to Manual or Gateway first.\',\\n    };\\n  }\\n  if (!params.bankReferenceUtr || params.bankReferenceUtr.trim().length < 6) {\\n    return {\\n      allowed: false,\\n      reason: \'A valid bank/UPI verification reference (min 6 chars) is required after checking the actual bank statement.\',\\n    };\\n  }\\n  if (params.verifiedAmountPaise !== params.expectedAmountPaise) {\\n    return {\\n      allowed: false,\\n      reason: `Verified amount (${formatINR(params.verifiedAmountPaise, true)}) does not match order total (${formatINR(params.expectedAmountPaise, true)}).`,\\n    };\\n  }\\n  return { allowed: true, newStatus: \'Paid\' };\\n}\\n\\n// ============================================================================\\n// 7. ORDER TRACKING, PHONE VERIFICATION, ETA & WEBHOOK DEDUPLICATION\\n// ============================================================================\\n\\nexport function verifyOrderLookupPhone(storedMobile: string, submittedMobile: string): boolean {\\n  const normStored = normalizeIndianMobile(storedMobile);\\n  const normSubmitted = normalizeIndianMobile(submittedMobile);\\n  return normStored.length === 10 && normStored === normSubmitted;\\n}\\n\\nexport function getHonestEtaDisplay(carrierTrustedEtaIso: string | null | undefined): string {\\n  if (!carrierTrustedEtaIso || !carrierTrustedEtaIso.trim()) {\\n    return \'Estimated delivery not available yet.\';\\n  }\\n  return carrierTrustedEtaIso.trim();\\n}\\n\\nexport function isDuplicateShipmentEvent(\\n  existingEvents: Array<{ eventCode: string; eventTimestamp: string; location: string }>,\\n  incomingEvent: { eventCode: string; eventTimestamp: string; location: string }\\n): boolean {\\n  return existingEvents.some(\\n    (e) =>\\n      e.eventCode === incomingEvent.eventCode &&\\n      e.eventTimestamp === incomingEvent.eventTimestamp &&\\n      e.location === incomingEvent.location\\n  );\\n}\\n\\n// ============================================================================\\n// 8. SALES, PROFIT, COGS & REFUND CALCULATIONS\\n// ============================================================================\\n\\nexport interface ProfitOrderRecord {\\n  orderId: string;\\n  orderStatus: OrderStatus;\\n  paymentStatus: PaymentStatus;\\n  subtotalPaise: number;\\n  shippingFeeCollectedPaise: number;\\n  totalPaise: number;\\n  refundedAmountPaise: number;\\n  actualCourierCostPaise: number | null;\\n  paymentGatewayFeePaise: number | null;\\n  items: Array<{\\n    quantity: number;\\n    unitPricePaise: number;\\n    unitCostSnapshotPaise: number | null;\\n    packagingCostSnapshotPaise: number | null;\\n  }>;\\n}\\n\\nexport interface ProfitReportSummary {\\n  totalOrdersCount: number;\\n  paidOrdersCount: number;\\n  grossSalesPaise: number;\\n  paidRevenuePaise: number;\\n  shippingFeesCollectedPaise: number;\\n  refundsTotalPaise: number;\\n  netPaidRevenuePaise: number;\\n  cogsPaise: number;\\n  packagingCostPaise: number;\\n  actualShippingCostPaise: number;\\n  paymentFeesPaise: number;\\n  operatingExpensesPaise: number;\\n  unsoldInventoryValuePaise: number;\\n  grossProfitPaise: number;\\n  contributionProfitPaise: number;\\n  estimatedNetProfitPaise: number;\\n  isEstimated: boolean;\\n  missingInputs: string[];\\n}\\n\\n/**\\n * Documented Financial Formulas:\\n * - Unpaid or Demo orders are NEVER counted in Paid Revenue or COGS.\\n * - Unsold inventory is NEVER counted in COGS; it is reported separately as Asset Value.\\n * - Net Paid Revenue = Paid Order Totals (including shipping fees collected) - Refunds.\\n * - COGS = Sum of (quantity * unitCostSnapshotPaise) for Paid, non-cancelled, non-returned orders.\\n * - Gross Profit = Net Paid Revenue - COGS - Packaging Cost.\\n * - Contribution Profit = Gross Profit - Actual Courier Shipping Cost - Payment Gateway Fees.\\n * - Estimated Net Profit = Contribution Profit - Operating/Marketing Expenses.\\n */\\nexport function calculateFinancialReport(\\n  orders: ProfitOrderRecord[],\\n  operatingExpensesPaise: number,\\n  unsoldInventoryValuePaise: number\\n): ProfitReportSummary {\\n  let totalOrdersCount = orders.length;\\n  let paidOrdersCount = 0;\\n  let grossSalesPaise = 0;\\n  let paidRevenuePaise = 0;\\n  let shippingFeesCollectedPaise = 0;\\n  let refundsTotalPaise = 0;\\n  let cogsPaise = 0;\\n  let packagingCostPaise = 0;\\n  let actualShippingCostPaise = 0;\\n  let paymentFeesPaise = 0;\\n\\n  const missingInputsSet = new Set<string>();\\n\\n  for (const order of orders) {\\n    if (order.orderStatus !== \'Cancelled\') {\\n      grossSalesPaise += order.totalPaise;\\n    }\\n\\n    if (order.refundedAmountPaise > 0) {\\n      refundsTotalPaise += order.refundedAmountPaise;\\n    }\\n\\n    const isPaidReal = order.paymentStatus === \'Paid\' || order.paymentStatus === \'Refunded\';\\n    if (!isPaidReal) {\\n      continue;\\n    }\\n\\n    paidOrdersCount += 1;\\n    paidRevenuePaise += order.totalPaise;\\n    shippingFeesCollectedPaise += order.shippingFeeCollectedPaise;\\n\\n    // Only count COGS and packaging if the order was not cancelled or returned to stock\\n    const isFulfilledSale = ![\'Cancelled\', \'Returned\'].includes(order.orderStatus);\\n    if (isFulfilledSale) {\\n      for (const item of order.items) {\\n        if (item.unitCostSnapshotPaise === null || item.unitCostSnapshotPaise <= 0) {\\n          missingInputsSet.add(`Missing purchase cost on order ${order.orderId}`);\\n        } else {\\n          cogsPaise += item.quantity * item.unitCostSnapshotPaise;\\n        }\\n\\n        if (item.packagingCostSnapshotPaise === null) {\\n          missingInputsSet.add(`Missing packaging cost on order ${order.orderId}`);\\n        } else {\\n          packagingCostPaise += item.quantity * item.packagingCostSnapshotPaise;\\n        }\\n      }\\n\\n      if ([\'Shipped\', \'Delivered\'].includes(order.orderStatus)) {\\n        if (order.actualCourierCostPaise === null) {\\n          missingInputsSet.add(`Missing actual courier cost on shipped order ${order.orderId}`);\\n        } else {\\n          actualShippingCostPaise += order.actualCourierCostPaise;\\n        }\\n      }\\n\\n      if (order.paymentGatewayFeePaise === null) {\\n        missingInputsSet.add(`Payment fee not recorded on order ${order.orderId}`);\\n      } else {\\n        paymentFeesPaise += order.paymentGatewayFeePaise;\\n      }\\n    }\\n  }\\n\\n  const netPaidRevenuePaise = Math.max(0, paidRevenuePaise - refundsTotalPaise);\\n  const grossProfitPaise = netPaidRevenuePaise - cogsPaise - packagingCostPaise;\\n  const contributionProfitPaise = grossProfitPaise - actualShippingCostPaise - paymentFeesPaise;\\n  const estimatedNetProfitPaise = contributionProfitPaise - operatingExpensesPaise;\\n\\n  const missingInputs = Array.from(missingInputsSet);\\n\\n  return {\\n    totalOrdersCount,\\n    paidOrdersCount,\\n    grossSalesPaise,\\n    paidRevenuePaise,\\n    shippingFeesCollectedPaise,\\n    refundsTotalPaise,\\n    netPaidRevenuePaise,\\n    cogsPaise,\\n    packagingCostPaise,\\n    actualShippingCostPaise,\\n    paymentFeesPaise,\\n    operatingExpensesPaise,\\n    unsoldInventoryValuePaise,\\n    grossProfitPaise,\\n    contributionProfitPaise,\\n    estimatedNetProfitPaise,\\n    isEstimated: missingInputs.length > 0,\\n    missingInputs,\\n  };\\n}\\n\\n// ============================================================================\\n// 9. SPREADSHEET CELL ESCAPING & WHATSAPP CLICK-TO-CHAT SANITIZATION\\n// ============================================================================\\n\\nexport function sanitizeSpreadsheetCell(value: unknown): string | number {\\n  if (typeof value === \'number\' && Number.isFinite(value)) {\\n    return value;\\n  }\\n  const str = String(value ?? \'\');\\n  // Prevent CSV/Excel formula injection (=, +, -, @, tab, CR)\\n  if (/^[=+\\\\-@\\\\t\\\\r]/.test(str)) {\\n    return `\'${str}`;\\n  }\\n  return str;\\n}\\n\\nexport function buildSafeWhatsAppUrl(\\n  storePhone: string,\\n  type: \'enquiry\' | \'confirmation\' | \'tracking\' | \'support\',\\n  context: { orderId?: string; productName?: string }\\n): string {\\n  const cleanPhone = String(storePhone || \'919000000000\').replace(/\\\\D/g, \'\');\\n  const safeOrderId = (context.orderId || \'\').replace(/[^a-zA-Z0-9\\\\-]/g, \'\').slice(0, 24);\\n  const safeProduct = (context.productName || \'\').replace(/[^\\\\w\\\\s\\\\-\342\202\271&]/g, \'\').slice(0, 60);\\n\\n  let message = \'Hello Pretty Charm team, I need assistance with my shopping experience.\';\\n  if (type === \'enquiry\' && safeProduct) {\\n    message = `Hello Pretty Charm! I would like to enquire about \\\"${safeProduct}\\\".`;\\n  } else if (type === \'confirmation\' && safeOrderId) {\\n    message = `Hello Pretty Charm! I just placed Order ${safeOrderId} and would like to follow up on confirmation.`;\\n  } else if (type === \'tracking\' && safeOrderId) {\\n    message = `Hello Pretty Charm! Could you please share the dispatch update for Order ${safeOrderId}?`;\\n  }\\n\\n  return `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;\\n}\\n\", \"Description\":\"Create pure domain logic module for Pretty Charm covering currency math, shipping rules, publication rules, WAC valuation, payment verification, tracking, profit formulas, and spreadsheet sanitization\", \"Overwrite\":true, \"TargetFile\":\"/src/shared/domainLogic.ts\", \"toolAction\":\"Creating domainLogic.ts with core business rules\", \"toolSummary\":\"Create src/shared/domainLogic.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_228399"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import test from \'node:test\';\\nimport assert from \'node:assert/strict\';\\nimport {\\n  rupeesToPaise,\\n  paiseToRupees,\\n  formatINR,\\n  canCustomerPurchaseProduct,\\n  validateProductPublication,\\n  calculateCustomerShippingFeePaise,\\n  checkPinCodeServiceability,\\n  validateCheckoutAddress,\\n  computeServerSideCheckoutTotals,\\n  calculateNewWeightedAverageCost,\\n  canReleaseReservationOnCancel,\\n  getInitialPaymentStatusForMode,\\n  verifyManualPaymentByAdmin,\\n  verifyOrderLookupPhone,\\n  getHonestEtaDisplay,\\n  isDuplicateShipmentEvent,\\n  calculateFinancialReport,\\n  sanitizeSpreadsheetCell,\\n  buildSafeWhatsAppUrl,\\n  DomainProduct,\\n  DomainVariant,\\n  ServiceablePinCode,\\n} from \'./domainLogic\';\\n\\nconst SAMPLE_PINS: ServiceablePinCode[] = [\\n  { pincode: \'122001\', city: \'Gurugram\', state: \'Haryana\', isServiceable: true, codAvailable: false },\\n  { pincode: \'110001\', city: \'New Delhi\', state: \'Delhi\', isServiceable: true, codAvailable: false },\\n  { pincode: \'400001\', city: \'Mumbai\', state: \'Maharashtra\', isServiceable: false, codAvailable: false },\\n];\\n\\nconst DRAFT_HAMPER: DomainProduct = {\\n  id: \'prod-mini-hamper\',\\n  name: \'Pretty Charm Mini Hamper\',\\n  slug: \'pretty-charm-mini-hamper\',\\n  sku: \'PC-HMP-MINI\',\\n  categorySlug: \'gift-hampers\',\\n  status: \'draft\',\\n  sellingPricePaise: 29900,\\n  purchaseCostPaise: 16000,\\n  packagingCostPaise: 2500,\\n  stockQty: 0,\\n  reservedQty: 0,\\n  lowStockThreshold: 5,\\n};\\n\\nconst ACTIVE_CLAW: DomainProduct = {\\n  id: \'prod-pearl-claw\',\\n  name: \'Rose Gold Pearl Hair Claw\',\\n  slug: \'rose-gold-pearl-hair-claw\',\\n  sku: \'PC-HAIR-001\',\\n  categorySlug: \'hair-accessories\',\\n  status: \'active\',\\n  sellingPricePaise: 24900,\\n  purchaseCostPaise: 9500,\\n  packagingCostPaise: 1500,\\n  stockQty: 10,\\n  reservedQty: 2,\\n  lowStockThreshold: 3,\\n};\\n\\ntest(\'1. Currency arithmetic in integer paise is exact\', () => {\\n  assert.equal(rupeesToPaise(299), 29900);\\n  assert.equal(rupeesToPaise(449.5), 44950);\\n  assert.equal(paiseToRupees(29900), 299);\\n  assert.ok(formatINR(29900).includes(\'299\'));\\n});\\n\\ntest(\'2. Product publication rules block unconfirmed drafts and coming-soon items\', () => {\\n  const draftAttempt = canCustomerPurchaseProduct(DRAFT_HAMPER, 1, \'active\');\\n  assert.equal(draftAttempt.allowed, false);\\n  assert.match(draftAttempt.reason || \'\', /draft/i);\\n\\n  const comingSoonCatAttempt = canCustomerPurchaseProduct(ACTIVE_CLAW, 1, \'coming-soon\');\\n  assert.equal(comingSoonCatAttempt.allowed, false);\\n  assert.match(comingSoonCatAttempt.reason || \'\', /Coming Soon/i);\\n\\n  const unconfirmedPublish = validateProductPublication({\\n    name: \'Pretty Charm Mini Hamper\',\\n    sellingPricePaise: 29900,\\n    stockQty: 10,\\n    description: \'Confirmed hamper contents with satin scrunchie and claw clip.\',\\n    confirmedByAdmin: false,\\n  });\\n  assert.equal(unconfirmedPublish.valid, false);\\n});\\n\\ntest(\'3. Stock availability and reservation math prevents overselling\', () => {\\n  // ACTIVE_CLAW has stockQty=10, reservedQty=2 => 8 available\\n  assert.equal(canCustomerPurchaseProduct(ACTIVE_CLAW, 8, \'active\').allowed, true);\\n  const oversell = canCustomerPurchaseProduct(ACTIVE_CLAW, 9, \'active\');\\n  assert.equal(oversell.allowed, false);\\n  assert.match(oversell.reason || \'\', /Only 8 unit/);\\n});\\n\\ntest(\'4. Configurable shipping rules engine calculates accurate tiers\', () => {\\n  // Subtotal below \342\202\271499 => \342\202\27159 (5900 paise)\\n  assert.equal(calculateCustomerShippingFeePaise(29900), 5900);\\n  assert.equal(calculateCustomerShippingFeePaise(49800), 5900);\\n  // Subtotal \342\202\271499 to below \342\202\271999 => \342\202\27139 (3900 paise)\\n  assert.equal(calculateCustomerShippingFeePaise(49900), 3900);\\n  assert.equal(calculateCustomerShippingFeePaise(89900), 3900);\\n  // Subtotal \342\202\271999 or above => \342\202\2710 free shipping\\n  assert.equal(calculateCustomerShippingFeePaise(99900), 0);\\n  assert.equal(calculateCustomerShippingFeePaise(149900), 0);\\n});\\n\\ntest(\'5. Server-side price validation ignores tampered client prices and aggregates duplicate lines\', () => {\\n  const products = new Map<string, DomainProduct>([[ACTIVE_CLAW.id, ACTIVE_CLAW]]);\\n  const variants = new Map<string, DomainVariant>();\\n  const categories = new Map<string, \'active\' | \'coming-soon\'>([[\'hair-accessories\', \'active\']]);\\n\\n  const result = computeServerSideCheckoutTotals(\\n    [\\n      { productId: ACTIVE_CLAW.id, quantity: 1, clientSubmittedPricePaise: 100 }, // Tampered \342\202\2711 price\\n      { productId: ACTIVE_CLAW.id, quantity: 1, clientSubmittedPricePaise: 100 },\\n    ],\\n    products,\\n    variants,\\n    categories\\n  );\\n\\n  assert.equal(result.valid, true);\\n  assert.equal(result.subtotalPaise, 49800); // 2 * \342\202\271249 = \342\202\271498\\n  assert.equal(result.shippingFeePaise, 5900); // < \342\202\271499 => \342\202\27159\\n  assert.equal(result.totalPaise, 55700); // \342\202\271557\\n});\\n\\ntest(\'6. Guest checkout address & Indian PIN code validation\', () => {\\n  const validAddr = validateCheckoutAddress(\\n    {\\n      fullName: \'Ananya Sharma\',\\n      mobile: \'+91 9876543210\',\\n      houseFlat: \'Flat 402, Tower B\',\\n      streetLocality: \'DLF Phase 4\',\\n      city: \'Gurugram\',\\n      state: \'Haryana\',\\n      pincode: \'122001\',\\n    },\\n    SAMPLE_PINS\\n  );\\n  assert.equal(validAddr.valid, true);\\n\\n  const unserviceableAddr = validateCheckoutAddress(\\n    {\\n      fullName: \'Ananya Sharma\',\\n      mobile: \'9876543210\',\\n      houseFlat: \'12A\',\\n      streetLocality: \'Marine Drive\',\\n      city: \'Mumbai\',\\n      state: \'Maharashtra\',\\n      pincode: \'400001\',\\n    },\\n    SAMPLE_PINS\\n  );\\n  assert.equal(unserviceableAddr.valid, false);\\n  assert.ok(unserviceableAddr.errors.some((e) => e.includes(\'400001\')));\\n});\\n\\ntest(\'7. Weighted Average Cost (WAC) and cancellation stock release rules\', () => {\\n  // 10 units @ \342\202\271100 (10000p) + 10 units @ \342\202\271140 (14000p) = \342\202\271120 (12000p)\\n  const newWac = calculateNewWeightedAverageCost(10, 10000, 10, 14000);\\n  assert.equal(newWac, 12000);\\n\\n  assert.equal(canReleaseReservationOnCancel(\'Pending Confirmation\'), true);\\n  assert.equal(canReleaseReservationOnCancel(\'Packed\'), true);\\n  assert.equal(canReleaseReservationOnCancel(\'Delivered\'), false);\\n});\\n\\ntest(\'8. Payment verification safeguards prevent demo payment spoofing and unauthorized approvals\', () => {\\n  assert.equal(getInitialPaymentStatusForMode(\'demo\'), \'Demo Mode - Not Paid\');\\n  assert.equal(getInitialPaymentStatusForMode(\'manual\'), \'Awaiting Verification\');\\n\\n  const demoVerifyAttempt = verifyManualPaymentByAdmin({\\n    paymentMode: \'demo\',\\n    adminUserId: \'admin-1\',\\n    adminRole: \'owner\',\\n    bankReferenceUtr: \'UTR123456789\',\\n    verifiedAmountPaise: 55700,\\n    expectedAmountPaise: 55700,\\n  });\\n  assert.equal(demoVerifyAttempt.allowed, false);\\n\\n  const unauthAttempt = verifyManualPaymentByAdmin({\\n    paymentMode: \'manual\',\\n    adminUserId: null,\\n    adminRole: null,\\n    bankReferenceUtr: \'UTR123456789\',\\n    verifiedAmountPaise: 55700,\\n    expectedAmountPaise: 55700,\\n  });\\n  assert.equal(unauthAttempt.allowed, false);\\n\\n  const validManualVerify = verifyManualPaymentByAdmin({\\n    paymentMode: \'manual\',\\n    adminUserId: \'admin-1\',\\n    adminRole: \'owner\',\\n    bankReferenceUtr: \'UTR9988776655\',\\n    verifiedAmountPaise: 55700,\\n    expectedAmountPaise: 55700,\\n  });\\n  assert.equal(validManualVerify.allowed, true);\\n  assert.equal(validManualVerify.newStatus, \'Paid\');\\n});\\n\\ntest(\'9. Shipment tracking phone verification, missing ETA, and duplicate webhook protection\', () => {\\n  assert.equal(verifyOrderLookupPhone(\'9876543210\', \'+91-9876543210\'), true);\\n  assert.equal(verifyOrderLookupPhone(\'9876543210\', \'9876500000\'), false);\\n\\n  assert.equal(getHonestEtaDisplay(null), \'Estimated delivery not available yet.\');\\n  assert.equal(getHonestEtaDisplay(\'\'), \'Estimated delivery not available yet.\');\\n  assert.equal(getHonestEtaDisplay(\'2026-10-28\'), \'2026-10-28\');\\n\\n  const existingEvents = [\\n    { eventCode: \'PICKED_UP\', eventTimestamp: \'2026-10-23T10:00:00Z\', location: \'Gurugram Hub\' },\\n  ];\\n  assert.equal(\\n    isDuplicateShipmentEvent(existingEvents, {\\n      eventCode: \'PICKED_UP\',\\n      eventTimestamp: \'2026-10-23T10:00:00Z\',\\n      location: \'Gurugram Hub\',\\n    }),\\n    true\\n  );\\n});\\n\\ntest(\'10. Profit reporting excludes unpaid/demo orders and never counts unsold inventory as COGS\', () => {\\n  const report = calculateFinancialReport(\\n    [\\n      {\\n        orderId: \'PC-1001\',\\n        orderStatus: \'Delivered\',\\n        paymentStatus: \'Paid\',\\n        subtotalPaise: 50000,\\n        shippingFeeCollectedPaise: 3900,\\n        totalPaise: 53900,\\n        refundedAmountPaise: 0,\\n        actualCourierCostPaise: 4500,\\n        paymentGatewayFeePaise: 1000,\\n        items: [\\n          {\\n            quantity: 2,\\n            unitPricePaise: 25000,\\n            unitCostSnapshotPaise: 10000,\\n            packagingCostSnapshotPaise: 1500,\\n          },\\n        ],\\n      },\\n      {\\n        orderId: \'PC-1002-DEMO\',\\n        orderStatus: \'Pending Confirmation\',\\n        paymentStatus: \'Demo Mode - Not Paid\',\\n        subtotalPaise: 29900,\\n        shippingFeeCollectedPaise: 5900,\\n        totalPaise: 35800,\\n        refundedAmountPaise: 0,\\n        actualCourierCostPaise: null,\\n        paymentGatewayFeePaise: null,\\n        items: [\\n          {\\n            quantity: 1,\\n            unitPricePaise: 29900,\\n            unitCostSnapshotPaise: 12000,\\n            packagingCostSnapshotPaise: 1500,\\n          },\\n        ],\\n      },\\n    ],\\n    5000, // \342\202\27150 operating expense\\n    250000 // \342\202\2712,500 unsold inventory value\\n  );\\n\\n  assert.equal(report.paidOrdersCount, 1);\\n  assert.equal(report.paidRevenuePaise, 53900);\\n  assert.equal(report.cogsPaise, 20000); // Only the 2 paid items (2 * \342\202\271100), never unsold inventory\\n  assert.equal(report.packagingCostPaise, 3000); // 2 * \342\202\27115\\n  assert.equal(report.grossProfitPaise, 30900); // 53900 - 20000 - 3000\\n  assert.equal(report.contributionProfitPaise, 25400); // 30900 - 4500 - 1000\\n  assert.equal(report.estimatedNetProfitPaise, 20400); // 25400 - 5000\\n  assert.equal(report.unsoldInventoryValuePaise, 250000);\\n});\\n\\ntest(\'11. Spreadsheet formula injection escaping & WhatsApp URL sanitization\', () => {\\n  assert.equal(sanitizeSpreadsheetCell(\'=SUM(A1:A10)\'), \\\"\'=SUM(A1:A10)\\\");\\n  assert.equal(sanitizeSpreadsheetCell(\'+cmd|\\\"/c calc\\\"!A0\'), \\\"\'+cmd|\\\\\\\"/c calc\\\\\\\"!A0\\\");\\n  assert.equal(sanitizeSpreadsheetCell(\'Normal Product Name\'), \'Normal Product Name\');\\n  assert.equal(sanitizeSpreadsheetCell(299), 299);\\n\\n  const waUrl = buildSafeWhatsAppUrl(\'+91 9876543210\', \'tracking\', { orderId: \'PC-2026-0001\' });\\n  assert.ok(waUrl.startsWith(\'https://wa.me/919876543210?text=\'));\\n  assert.ok(waUrl.includes(\'PC-2026-0001\'));\\n});\\n\", \"Description\":\"Create comprehensive unit test suite in src/shared/domainLogic.test.ts covering all core business rules\", \"Overwrite\":true, \"TargetFile\":\"/src/shared/domainLogic.test.ts\", \"toolAction\":\"Writing unit tests for domain logic\", \"toolSummary\":\"Create src/shared/domainLogic.test.ts\"}"
      original_name: "write_to_file"
    }
