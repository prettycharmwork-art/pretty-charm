ext();\n  const finalBadgeText = await page.getByTestId(\'catalogue-integrity-badge\').innerText();\n\n  return {\n    reportVisible,\n    badgeText,\n    initialClawStatus,\n    initialMiniStatus,\n    stagedMiniStatus,\n    approveBtnVisible,\n    rejectedMiniStatus,\n    finalBadgeText\n  };\n}\" && playwright-cli console error && playwright-cli close"
