            }
            lines {
              text: "    if (sortBy === \'newest\') {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const timeA = a.createdAt ? Date.parse(a.createdAt) : 0;"
