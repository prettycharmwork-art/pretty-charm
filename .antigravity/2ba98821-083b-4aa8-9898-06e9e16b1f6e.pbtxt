            }
            lines {
              text: "  confirmedByAdmin: boolean;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "}): { valid: boolean; reason?: string } {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (!product.confirmedByAdmin) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return { valid: false, reason: \'Admin must confirm actual contents, stock, and selling price before publishing.\' };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
