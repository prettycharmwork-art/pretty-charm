    command_line: "npx --yes tsx -e \"\nconst queries = [\n  { id: \'prod-pearl-claw\', q: \'hair claw clip OR pearl hair clip filetype:bitmap\' },\n  { id: \'prod-silk-scrunchie-trio\', q: \'scrunchie hair filetype:bitmap\' },\n  { id: \'prod-satin-bow-barrette\', q: \'pink hair bow OR ribbon barrette filetype:bitmap\' },\n  { id: \'prod-pearl-drop-huggies\', q: \'pearl drop earrings filetype:bitmap\' },\n  { id: \'prod-charm-bracelet\', q: \'charm bracelet gold filetype:bitmap\' },\n  { id: \'prod-quartz-necklace\', q: \'rose quartz necklace OR rose quartz pendant filetype:bitmap\' },\n];\n\nfor (const item of queries) {\n  const url = \'https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=\' + encodeURIComponent(item.q) + \'&gsrnamespace=6&gsrlimit=5&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n  const res = await fetch(url, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n  const data = await res.json();\n  const pages = Object.values(data?.query?.pages || {}) as any[];\n  console.log(\'=== \' + item.id + \' ===\');\n  for (const p of pages) {\n    const ii = p.imageinfo?.[0];\n    if (!ii) continue;\n    console.log({\n      title: p.title,\n      thumbUrl: ii.thumburl || ii.url,\n      fullUrl: ii.url,\n      sourceUrl: ii.descriptionurl,\n      mime: ii.mime,\n      width: ii.width,\n      height: ii.height,\n      license: ii.extmetadata?.LicenseShortName?.value\n    });\n  }\n}\n\""
    proposed_command_line: "npx --yes tsx -e \"\nconst queries = [\n  { id: \'prod-pearl-claw\', q: \'hair claw clip OR pearl hair clip filetype:bitmap\' },\n  { id: \'prod-silk-scrunchie-trio\', q: \'scrunchie hair filetype:bitmap\' },\n  { id: \'prod-satin-bow-barrette\', q: \'pink hair bow OR ribbon barrette filetype:bitmap\' },\n  { id: \'prod-pearl-drop-huggies\', q: \'pearl drop earrings filetype:bitmap\' },\n  { id: \'prod-charm-bracelet\', q: \'charm bracelet gold filetype:bitmap\' },\n  { id: \'prod-quartz-necklace\', q: \'rose quartz necklace OR rose quartz pendant filetype:bitmap\' },\n];\n\nfor (const item of queries) {\n  const url = \'https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=\' + encodeURIComponent(item.q) + \'&gsrnamespace=6&gsrlimit=5&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n  const res = await fetch(url, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n  const data = await res.json();\n  const pages = Object.values(data?.query?.pages || {}) as any[];\n  console.log(\'=== \' + item.id + \' ===\');\n  for (const p of pages) {\n    const ii = p.imageinfo?.[0];\n    if (!ii) continue;\n    console.log({\n      title: p.title,\n      thumbUrl: ii.thumburl || ii.url,\n      fullUrl: ii.url,\n      sourceUrl: ii.descriptionurl,\n      mime: ii.mime,\n      width: ii.width,\n      height: ii.height,\n      license: ii.extmetadata?.LicenseShortName?.value\n    });\n  }\n}\n\""
