      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Integrate PremiumHomepage, Admin-configurable Announcement Bar, Header with search and category navigation, mobile menu drawer, and complete Footer links in App.tsx\", \"Instruction\":\"Update imports, initial screen state, Header, Homepage section, and Footer in src/App.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":40, \"ReplacementContent\":\"  MapPin,\\n  Mail,\\n  CheckCircle2,\\n  MessageCircle,\\n  Menu,\\n  X\\n} from \'lucide-react\';\\nimport {\\n  formatINR,\\n  calculateCustomerShippingFeePaise,\\n  canCustomerPurchaseProduct,\\n  validateIndianPinCodeFormat,\\n  validateIndianMobile,\\n  getHonestEtaDisplay,\\n  buildSafeWhatsAppUrl,\\n  buildInstagramProfileUrl,\\n  sortCatalogueProducts,\\n  PRODUCT_SORT_OPTIONS,\\n  ProductSortOption,\\n  DEFAULT_SHIPPING_RULES,\\n  ShippingRuleConfig\\n} from \'./shared/domainLogic\';\\nimport { ARTWORK } from \'./assets/productArtwork\';\\nimport { PWAInstallButton, OfflineIndicator } from \'./components/PWAInstallBanner\';\\nimport { ThreeHamperViewer } from \'./components/ThreeHamperViewer\';\\nimport { GeminiStudioModal } from \'./components/GeminiStudioModal\';\\nimport { AdminDashboard } from \'./components/AdminDashboard\';\\nimport { PremiumHomepage } from \'./components/PremiumHomepage\';\", \"StartLine\":16, \"TargetContent\":\"  MapPin,\\n  Mail,\\n  CheckCircle2,\\n  MessageCircle\\n} from \'lucide-react\';\\nimport {\\n  formatINR,\\n  calculateCustomerShippingFeePaise,\\n  canCustomerPurchaseProduct,\\n  validateIndianPinCodeFormat,\\n  validateIndianMobile,\\n  getHonestEtaDisplay,\\n  buildSafeWhatsAppUrl,\\n  sortCatalogueProducts,\\n  PRODUCT_SORT_OPTIONS,\\n  ProductSortOption,\\n  DEFAULT_SHIPPING_RULES,\\n  ShippingRuleConfig\\n} from \'./shared/domainLogic\';\\nimport { ARTWORK } from \'./assets/productArtwork\';\\nimport { PWAInstallButton, OfflineIndicator } from \'./components/PWAInstallBanner\';\\nimport { ThreeHamperViewer } from \'./components/ThreeHamperViewer\';\\nimport { GeminiStudioModal } from \'./components/GeminiStudioModal\';\\nimport { AdminDashboard } from \'./components/AdminDashboard\';\"}, {\"AllowMultiple\":false, \"EndLine\":140, \"ReplacementContent\":\"  const [screen, setScreen] = useState<ScreenName>(\\n    initialScreenParam || \'home\'\\n  );\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState<boolean>(false);\\n  const [selectedProductSlug, setSelectedProductSlug] = useState<string | null>(null);\\n  const [selectedCategorySlug, setSelectedCategorySlug] = useState<string>(\'all\');\\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\\n  const [sortBy, setSortBy] = useState<ProductSortOption>(\'featured\');\\n  const [showInStockOnly, setShowInStockOnly] = useState<boolean>(false);\", \"StartLine\":131, \"TargetContent\":\"  const [screen, setScreen] = useState<ScreenName>(\\n    initialScreenParam || (isAutostart ? \'home\' : \'splash\')\\n  );\\n  const [selectedProductSlug, setSelectedProductSlug] = useState<string | null>(null);\\n  const [selectedCategorySlug, setSelectedCategorySlug] = useState<string>(\'all\');\\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\\n  const [sortBy, setSortBy] = useState<ProductSortOption>(\'featured\');\\n  const [showInStockOnly, setShowInStockOnly] = useState<boolean>(false);\"}, {\"AllowMultiple\":false, \"EndLine\":1138, \"ReplacementContent\":\"      {/* A. Slim, Elegant Admin-Configurable Announcement Bar */}\\n      <div\\n        data-testid=\\\"announcement-bar\\\"\\n        className=\\\"bg-[#f6e6ea] border-b border-[#ebd5dc] text-[#4a2c33] text-[11px] sm:text-xs py-2 px-4 text-center font-medium tracking-wide\\\"\\n      >\\n        <span>\\n          {generalSettings.announcementBanner ||\\n            `Ships from Gurugram across India \302\267 Shipping ${formatINR(\\n              shippingRules.tier1FeePaise\\n            )} (<${formatINR(shippingRules.tier1MaxSubtotalPaise)}) \302\267 ${formatINR(\\n              shippingRules.tier2FeePaise\\n            )} (${formatINR(shippingRules.tier1MaxSubtotalPaise)}\342\200\223${formatINR(\\n              shippingRules.freeShippingThresholdPaise - 100\\n            )}) \302\267 Free Shipping on ${formatINR(shippingRules.freeShippingThresholdPaise)}+`}\\n        </span>\\n      </div>\\n\\n      {/* B. Redesigned Header with Logo, Search Field, Category Navigation & Accessible Controls */}\\n      <header className=\\\"sticky top-0 z-30 bg-[#fffdfb]/95 backdrop-blur-md border-b border-[#ebd7dc]\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-5\\\">\\n          {/* Left: Mobile Menu Button + Pretty Charm Logo */}\\n          <div className=\\\"flex items-center gap-1.5 sm:gap-3 shrink-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setMobileMenuOpen((v) => !v)}\\n              aria-label={mobileMenuOpen ? \'Close navigation menu\' : \'Open navigation menu\'}\\n              aria-expanded={mobileMenuOpen}\\n              data-testid=\\\"mobile-menu-toggle\\\"\\n              className=\\\"lg:hidden p-2 rounded-full hover:bg-[#faf2f4] text-[#5c3d42] transition-colors\\\"\\n            >\\n              {mobileMenuOpen ? <X className=\\\"w-5 h-5\\\" /> : <Menu className=\\\"w-5 h-5\\\" />}\\n            </button>\\n\\n            {screen !== \'home\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setScreen(\'home\')}\\n                aria-label=\\\"Back to Home\\\"\\n                className=\\\"p-1.5 rounded-full hover:bg-[#fdf2f4] text-[#7c5c63]\\\"\\n              >\\n                <ArrowLeft className=\\\"w-4 h-4\\\" />\\n              </button>\\n            )}\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setMobileMenuOpen(false);\\n                setScreen(\'home\');\\n              }}\\n              className=\\\"text-left group focus:outline-none whitespace-nowrap cursor-pointer\\\"\\n            >\\n              <span className=\\\"font-serif text-xl sm:text-[26px] font-semibold text-[#2b1c20] tracking-tight block leading-none whitespace-nowrap\\\">\\n                Pretty Charm\\n              </span>\\n              <span className=\\\"text-[9px] sm:text-[10px] uppercase tracking-[0.18em] text-[#9e5461] block mt-0.5 whitespace-nowrap\\\">\\n                Gurugram Studio\\n              </span>\\n            </button>\\n          </div>\\n\\n          {/* Center: Clean Navigation for Home, Gift Hampers, Hair Accessories, Jewellery, Coming Soon */}\\n          <nav\\n            aria-label=\\\"Main navigation\\\"\\n            className=\\\"hidden lg:flex items-center gap-6 text-xs xl:text-sm font-medium text-[#5c3d42]\\\"\\n          >\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setScreen(\'home\')}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap cursor-pointer ${\\n                screen === \'home\' ? \'text-[#9e5461] font-semibold\' : \'\'\\n              }`}\\n            >\\n              Home\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setSelectedCategorySlug(\'gift-hampers\');\\n                setScreen(\'shop\');\\n              }}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap cursor-pointer ${\\n                screen === \'shop\' && selectedCategorySlug === \'gift-hampers\'\\n                  ? \'text-[#9e5461] font-semibold\'\\n                  : \'\'\\n              }`}\\n            >\\n              Gift Hampers\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setSelectedCategorySlug(\'hair-accessories\');\\n                setScreen(\'shop\');\\n              }}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap cursor-pointer ${\\n                screen === \'shop\' && selectedCategorySlug === \'hair-accessories\'\\n                  ? \'text-[#9e5461] font-semibold\'\\n                  : \'\'\\n              }`}\\n            >\\n              Hair Accessories\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setSelectedCategorySlug(\'jewellery\');\\n                setScreen(\'shop\');\\n              }}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap cursor-pointer ${\\n                screen === \'shop\' && selectedCategorySlug === \'jewellery\'\\n                  ? \'text-[#9e5461] font-semibold\'\\n                  : \'\'\\n              }`}\\n            >\\n              Jewellery\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setScreen(\'categories\')}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap cursor-pointer ${\\n                screen === \'categories\' ? \'text-[#9e5461] font-semibold\' : \'\'\\n              }`}\\n            >\\n              Coming Soon\\n            </button>\\n          </nav>\\n\\n          {/* Right: Search Products Field + Account, Wishlist, Cart & Admin Controls */}\\n          <div className=\\\"flex items-center gap-1 sm:gap-2.5 shrink-0\\\">\\n            <form\\n              onSubmit={(e) => {\\n                e.preventDefault();\\n                setScreen(\'shop\');\\n              }}\\n              className=\\\"hidden md:flex items-center relative\\\"\\n              role=\\\"search\\\"\\n            >\\n              <Search className=\\\"w-3.5 h-3.5 text-[#7c5c63] absolute left-3 pointer-events-none\\\" />\\n              <input\\n                type=\\\"search\\\"\\n                data-testid=\\\"header-search-input\\\"\\n                value={searchQuery}\\n                onChange={(e) => setSearchQuery(e.target.value)}\\n                placeholder=\\\"Search products...\\\"\\n                aria-label=\\\"Search products\\\"\\n                className=\\\"w-40 xl:w-52 pl-8 pr-3 py-1.5 rounded-full bg-[#faf5f6] border border-[#e8d2d8] text-xs text-[#2b1c20] placeholder:text-[#8c6c73] focus:outline-none focus:border-[#9e5461]\\\"\\n              />\\n            </form>\\n\\n            <PWAInstallButton />\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setScreen(customerUser ? \'account\' : \'auth\')}\\n              aria-label=\\\"Account\\\"\\n              data-testid=\\\"header-account-btn\\\"\\n              className=\\\"p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors cursor-pointer\\\"\\n            >\\n              <User className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setScreen(\'wishlist\')}\\n              aria-label=\\\"Wishlist\\\"\\n              data-testid=\\\"header-wishlist-btn\\\"\\n              className=\\\"relative p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors cursor-pointer\\\"\\n            >\\n              <Heart className=\\\"w-5 h-5\\\" />\\n              {wishlist.length > 0 && (\\n                <span className=\\\"absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-[#9e5461] text-white text-[10px] font-tabular flex items-center justify-center\\\">\\n                  {wishlist.length}\\n                </span>\\n              )}\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setScreen(\'cart\')}\\n              data-testid=\\\"header-cart-btn\\\"\\n              aria-label=\\\"Shopping Bag\\\"\\n              className=\\\"relative p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors cursor-pointer\\\"\\n            >\\n              <ShoppingBag className=\\\"w-5 h-5\\\" />\\n              {hydratedCart.length > 0 && (\\n                <span\\n                  data-testid=\\\"cart-badge-count\\\"\\n                  className=\\\"absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-[#9e5461] text-white text-[10px] font-tabular flex items-center justify-center\\\"\\n                >\\n                  {hydratedCart.reduce((s, i) => s + i.quantity, 0)}\\n                </span>\\n              )}\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setScreen(\'admin\')}\\n              data-testid=\\\"open-admin-btn\\\"\\n              className=\\\"px-2 sm:px-2.5 py-1 rounded-lg border border-[#ebd7dc] text-[11px] font-medium text-[#7c5c63] hover:text-[#9e5461] hover:border-[#9e5461] whitespace-nowrap cursor-pointer\\\"\\n            >\\n              Admin\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Mobile Search Bar (Always accessible on <768px without overflow) */}\\n        <div className=\\\"md:hidden px-3 pb-2.5\\\">\\n          <form\\n            onSubmit={(e) => {\\n              e.preventDefault();\\n              setMobileMenuOpen(false);\\n              setScreen(\'shop\');\\n            }}\\n            className=\\\"relative flex items-center\\\"\\n            role=\\\"search\\\"\\n          >\\n            <Search className=\\\"w-3.5 h-3.5 text-[#7c5c63] absolute left-3.5 pointer-events-none\\\" />\\n            <input\\n              type=\\\"search\\\"\\n              data-testid=\\\"mobile-search-input\\\"\\n              value={searchQuery}\\n              onChange={(e) => setSearchQuery(e.target.value)}\\n              placeholder=\\\"Search hair claws, jewellery, gift hampers...\\\"\\n              aria-label=\\\"Search products on mobile\\\"\\n              className=\\\"w-full pl-9 pr-16 py-2 rounded-full bg-[#faf5f6] border border-[#e8d2d8] text-xs text-[#2b1c20] placeholder:text-[#8c6c73] focus:outline-none focus:border-[#9e5461]\\\"\\n            />\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"absolute right-1.5 px-3 py-1 rounded-full bg-[#9e5461] text-white text-[11px] font-medium\\\"\\n            >\\n              Search\\n            </button>\\n          </form>\\n        </div>\\n\\n        {/* Mobile Navigation Drawer */}\\n        {mobileMenuOpen && (\\n          <nav\\n            aria-label=\\\"Mobile navigation\\\"\\n            data-testid=\\\"mobile-nav-drawer\\\"\\n            className=\\\"lg:hidden border-t border-[#ebd7dc] bg-[#fffdfb] px-4 py-4 space-y-2 shadow-md\\\"\\n          >\\n            {[\\n              {\\n                label: \'Home\',\\n                action: () => setScreen(\'home\'),\\n              },\\n              {\\n                label: \'Gift Hampers\',\\n                action: () => {\\n                  setSelectedCategorySlug(\'gift-hampers\');\\n                  setScreen(\'shop\');\\n                },\\n              },\\n              {\\n                label: \'Hair Accessories\',\\n                action: () => {\\n                  setSelectedCategorySlug(\'hair-accessories\');\\n                  setScreen(\'shop\');\\n                },\\n              },\\n              {\\n                label: \'Jewellery\',\\n                action: () => {\\n                  setSelectedCategorySlug(\'jewellery\');\\n                  setScreen(\'shop\');\\n                },\\n              },\\n              {\\n                label: \'Cosmetics & Beauty \342\200\224 Coming Soon\',\\n                action: () => setScreen(\'categories\'),\\n              },\\n              {\\n                label: \'Festive Collection \342\200\224 Coming Soon\',\\n                action: () => setScreen(\'categories\'),\\n              },\\n              {\\n                label: \'Track My Order\',\\n                action: () => setScreen(\'track-order\'),\\n              },\\n            ].map((item) => (\\n              <button\\n                key={item.label}\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  item.action();\\n                  setMobileMenuOpen(false);\\n                }}\\n                className=\\\"w-full text-left py-2 px-3 rounded-xl text-xs font-medium text-[#2b1c20] hover:bg-[#fdf2f4] flex items-center justify-between\\\"\\n              >\\n                <span>{item.label}</span>\\n                <ChevronRight className=\\\"w-3.5 h-3.5 text-[#9e5461]\\\" />\\n              </button>\\n            ))}\\n          </nav>\\n        )}\\n      </header>\\n\\n      {/* Toast Notification */}\\n      {toastMessage && (\\n        <div className=\\\"fixed bottom-20 md:bottom-6 right-4 z-50 bg-[#2d1e21] text-white px-4 py-2.5 rounded-xl shadow-lg text-xs font-medium flex items-center gap-2 border border-[#9e5461]/40\\\">\\n          <CheckCircle2 className=\\\"w-4 h-4 text-[#f5b8c3]\\\" />\\n          <span>{toastMessage}</span>\\n        </div>\\n      )}\\n\\n      {/* Main Content Area */}\\n      <main className=\\\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8\\\">\\n        {/* SCREEN 3: REDESIGNED PREMIUM HOMEPAGE */}\\n        {screen === \'home\' && (\\n          <PremiumHomepage\\n            categories={categories}\\n            products={products}\\n            wishlist={wishlist}\\n            recentlyViewed={recentlyViewed}\\n            generalSettings={generalSettings}\\n            shippingRules={shippingRules}\\n            categoryNameMap={categoryNameMap}\\n            onShopCategory={(slug) => {\\n              setSelectedCategorySlug(slug);\\n              setScreen(\'shop\');\\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\\n            }}\\n            onViewAllCategories={() => {\\n              setScreen(\'categories\');\\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\\n            }}\\n            onSelectProduct={(product) => navigateToProduct(product)}\\n            onAddToCart={(product) =>\\n              handleAddToCart(product, 1, product.variants?.[0]?.id || null)\\n            }\\n            onToggleWishlist={(productId) => toggleWishlist(productId)}\\n          />\\n        )}\", \"StartLine\":753, \"TargetContent\":\"      {/* Top Promotional Announcement Strip */}\\n      <div className=\\\"bg-[#9e5461] text-white text-[11px] sm:text-xs py-2 px-4 text-center font-medium tracking-wide\\\">\\n        <span>\\n          Pan-India Dispatch from Gurugram \302\267 Shipping \342\202\27159 (&lt;\342\202\271499) \302\267 \342\202\27139 (\342\202\271499\342\200\223\342\202\271998) \302\267{\' \'}\\n          <strong className=\\\"underline\\\">FREE on \342\202\271999+</strong>\\n        </span>\\n      </div>\\n\\n      {/* Top Navigation Bar (Follows Top Bar Contract: max 4 top-level groups, whitespace-nowrap, >=24px gap) */}\\n      <header className=\\\"sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#f0d5da]\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-6\\\">\\n          {/* Brand Logo */}\\n          <div className=\\\"flex items-center gap-2 sm:gap-3 shrink-0\\\">\\n            {screen !== \'home\' && (\\n              <button\\n                onClick={() => setScreen(\'home\')}\\n                aria-label=\\\"Back to Home\\\"\\n                className=\\\"p-1.5 rounded-full hover:bg-[#fdf2f4] text-[#7c5c63]\\\"\\n              >\\n                <ArrowLeft className=\\\"w-4 h-4\\\" />\\n              </button>\\n            )}\\n            <button\\n              onClick={() => setScreen(\'home\')}\\n              className=\\\"text-left group focus:outline-none whitespace-nowrap\\\"\\n            >\\n              <span className=\\\"font-serif text-xl sm:text-[26px] font-semibold text-[#2d1e21] tracking-tight block leading-none whitespace-nowrap\\\">\\n                Pretty Charm\\n              </span>\\n              <span className=\\\"text-[9px] sm:text-[10px] uppercase tracking-[0.18em] text-[#9e5461] block mt-0.5 whitespace-nowrap\\\">\\n                Gurugram Studio\\n              </span>\\n            </button>\\n          </div>\\n\\n          {/* Primary Desktop Navigation Links (4 top-level items) */}\\n          <nav className=\\\"hidden md:flex items-center gap-7 text-sm font-medium text-[#5c3d42]\\\">\\n            <button\\n              onClick={() => {\\n                setSelectedCategorySlug(\'all\');\\n                setScreen(\'shop\');\\n              }}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap ${\\n                screen === \'shop\' ? \'text-[#9e5461] font-semibold\' : \'\'\\n              }`}\\n            >\\n              Shop Collection\\n            </button>\\n            <button\\n              onClick={() => setScreen(\'categories\')}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap ${\\n                screen === \'categories\' ? \'text-[#9e5461] font-semibold\' : \'\'\\n              }`}\\n            >\\n              Categories\\n            </button>\\n            <button\\n              onClick={() => setScreen(\'3d-studio\')}\\n              className={`hover:text-[#9e5461] transition-colors flex items-center gap-1.5 whitespace-nowrap ${\\n                screen === \'3d-studio\' ? \'text-[#9e5461] font-semibold\' : \'\'\\n              }`}\\n            >\\n              <Box className=\\\"w-4 h-4 text-[#9e5461]\\\" />\\n              <span>3D Hamper Studio</span>\\n            </button>\\n            <button\\n              onClick={() => setScreen(\'track-order\')}\\n              className={`hover:text-[#9e5461] transition-colors whitespace-nowrap ${\\n                screen === \'track-order\' ? \'text-[#9e5461] font-semibold\' : \'\'\\n              }`}\\n            >\\n              Track My Order\\n            </button>\\n          </nav>\\n\\n          {/* Right Action Cluster */}\\n          <div className=\\\"flex items-center gap-1.5 sm:gap-3 shrink-0\\\">\\n            <PWAInstallButton />\\n\\n            <button\\n              onClick={() => setIsAiModalOpen(true)}\\n              className=\\\"px-2.5 sm:px-3 py-1.5 rounded-full bg-[#fdf2f4] hover:bg-[#f8e1e6] text-[#9e5461] border border-[#f0d5da] text-xs font-medium flex items-center gap-1.5 transition-colors whitespace-nowrap\\\"\\n              title=\\\"Pretty Charm AI Styling Concierge\\\"\\n            >\\n              <Sparkles className=\\\"w-3.5 h-3.5\\\" />\\n              <span className=\\\"hidden sm:inline\\\">AI Stylist</span>\\n            </button>\\n\\n            <button\\n              onClick={() => setScreen(\'wishlist\')}\\n              aria-label=\\\"Wishlist\\\"\\n              className=\\\"relative p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors\\\"\\n            >\\n              <Heart className=\\\"w-5 h-5\\\" />\\n              {wishlist.length > 0 && (\\n                <span className=\\\"absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-[#9e5461] text-white text-[10px] font-tabular flex items-center justify-center\\\">\\n                  {wishlist.length}\\n                </span>\\n              )}\\n            </button>\\n\\n            <button\\n              onClick={() => setScreen(\'cart\')}\\n              data-testid=\\\"header-cart-btn\\\"\\n              aria-label=\\\"Shopping Bag\\\"\\n              className=\\\"relative p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors\\\"\\n            >\\n              <ShoppingBag className=\\\"w-5 h-5\\\" />\\n              {hydratedCart.length > 0 && (\\n                <span\\n                  data-testid=\\\"cart-badge-count\\\"\\n                  className=\\\"absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-[#9e5461] text-white text-[10px] font-tabular flex items-center justify-center\\\"\\n                >\\n                  {hydratedCart.reduce((s, i) => s + i.quantity, 0)}\\n                </span>\\n              )}\\n            </button>\\n\\n            <button\\n              onClick={() => setScreen(customerUser ? \'account\' : \'auth\')}\\n              aria-label=\\\"Account\\\"\\n              className=\\\"hidden sm:inline-flex p-2 rounded-full hover:bg-[#fdf2f4] text-[#5c3d42] transition-colors\\\"\\n            >\\n              <User className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            <button\\n              onClick={() => setScreen(\'admin\')}\\n              data-testid=\\\"open-admin-btn\\\"\\n              className=\\\"px-2.5 py-1 rounded-lg border border-[#f0d5da] text-[11px] font-medium text-[#7c5c63] hover:text-[#9e5461] hover:border-[#9e5461] whitespace-nowrap\\\"\\n            >\\n              Admin\\n            </button>\\n          </div>\\n        </div>\\n      </header>\\n\\n      {/* Toast Notification */}\\n      {toastMessage && (\\n        <div className=\\\"fixed bottom-20 md:bottom-6 right-4 z-50 bg-[#2d1e21] text-white px-4 py-2.5 rounded-xl shadow-lg text-xs font-medium flex items-center gap-2 border border-[#9e5461]/40\\\">\\n          <CheckCircle2 className=\\\"w-4 h-4 text-[#f5b8c3]\\\" />\\n          <span>{toastMessage}</span>\\n        </div>\\n      )}\\n\\n      {/* Main Content Area */}\\n      <main className=\\\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6\\\">\\n        {/* SCREEN 3: HOME PAGE */}\\n        {screen === \'home\' && (\\n          <div className=\\\"space-y-10\\\">\\n            {/* Hero Banner */}\\n            <section className=\\\"rounded-3xl bg-gradient-to-r from-[#fdf2f4] via-[#fff9fa] to-[#f9e5e9] border border-[#f0d5da] overflow-hidden shadow-sm\\\">\\n              <div className=\\\"grid grid-cols-1 lg:grid-cols-12 items-center\\\">\\n                <div className=\\\"lg:col-span-7 p-6 sm:p-10 lg:p-12 space-y-5\\\">\\n                  <p className=\\\"text-xs uppercase tracking-[0.2em] text-[#9e5461] font-semibold\\\">\\n                    Handcrafted in Gurugram \302\267 Pan-India Delivery\\n                  </p>\\n                  <h1 className=\\\"font-serif text-3xl sm:text-5xl text-[#2d1e21] font-semibold leading-[1.12]\\\">\\n                    Thoughtful Luxury for Every Everyday Moment.\\n                  </h1>\\n                  <p className=\\\"text-sm sm:text-base text-[#5c3d42] max-w-xl leading-relaxed\\\">\\n                    Explore satin hair accessories, 18K rose-gold plated anti-tarnish jewellery, and bespoke keepsake hampers curated with care.\\n                  </p>\\n                  <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n                    <button\\n                      onClick={() => {\\n                        setSelectedCategorySlug(\'all\');\\n                        setScreen(\'shop\');\\n                      }}\\n                      data-testid=\\\"hero-shop-btn\\\"\\n                      className=\\\"px-6 py-3 rounded-full bg-[#9e5461] hover:bg-[#85424e] text-white text-sm font-medium transition-colors flex items-center gap-2 whitespace-nowrap\\\"\\n                    >\\n                      <span>Explore Collection</span>\\n                      <ChevronRight className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                    <button\\n                      onClick={() => setScreen(\'3d-studio\')}\\n                      className=\\\"px-5 py-3 rounded-full bg-white hover:bg-[#fdf2f4] text-[#9e5461] border border-[#e5c2c9] text-sm font-medium transition-colors flex items-center gap-2 whitespace-nowrap\\\"\\n                    >\\n                      <Box className=\\\"w-4 h-4\\\" />\\n                      <span>Inspect in 3D Studio</span>\\n                    </button>\\n                  </div>\\n                </div>\\n                <div className=\\\"lg:col-span-5 h-64 sm:h-80 lg:h-96 bg-white/60\\\">\\n                  <img\\n                    src={ARTWORK.heroBanner}\\n                    alt=\\\"Pretty Charm Signature Collection\\\"\\n                    className=\\\"w-full h-full object-cover\\\"\\n                  />\\n                </div>\\n              </div>\\n            </section>\\n\\n            {/* Quick Search Bar */}\\n            <section className=\\\"max-w-2xl mx-auto\\\">\\n              <div className=\\\"relative flex items-center\\\">\\n                <Search className=\\\"w-4 h-4 text-[#7c5c63] absolute left-4 pointer-events-none\\\" />\\n                <input\\n                  type=\\\"search\\\"\\n                  value={searchQuery}\\n                  onChange={(e) => setSearchQuery(e.target.value)}\\n                  onKeyDown={(e) => {\\n                    if (e.key === \'Enter\') setScreen(\'shop\');\\n                  }}\\n                  placeholder=\\\"Search hair claws, silk scrunchies, pearl hoops, gift hampers...\\\"\\n                  className=\\\"w-full pl-11 pr-28 py-3 rounded-full bg-white border border-[#f0d5da] text-sm focus:outline-none focus:border-[#9e5461] shadow-2xs\\\"\\n                />\\n                <button\\n                  onClick={() => setScreen(\'shop\')}\\n                  className=\\\"absolute right-1.5 px-4 py-1.5 rounded-full bg-[#9e5461] text-white text-xs font-medium whitespace-nowrap\\\"\\n                >\\n                  Search\\n                </button>\\n              </div>\\n            </section>\\n\\n            {/* Category Showcase */}\\n            <section className=\\\"space-y-4\\\">\\n              <div className=\\\"flex items-end justify-between\\\">\\n                <div>\\n                  <p className=\\\"text-xs uppercase tracking-[0.16em] text-[#9e5461] font-semibold\\\">\\n                    Curated Departments\\n                  </p>\\n                  <h2 className=\\\"font-serif text-2xl sm:text-3xl text-[#2d1e21] font-semibold\\\">\\n                    Shop by Category\\n                  </h2>\\n                </div>\\n                <button\\n                  onClick={() => setScreen(\'categories\')}\\n                  className=\\\"text-xs font-medium text-[#9e5461] hover:underline flex items-center gap-1 whitespace-nowrap\\\"\\n                >\\n                  <span>View All 5 Categories</span>\\n                  <ChevronRight className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4\\\">\\n                {categories.map((cat) => (\\n                  <button\\n                    key={cat.id}\\n                    onClick={() => {\\n                      setSelectedCategorySlug(cat.slug);\\n                      setScreen(\'shop\');\\n                    }}\\n                    className=\\\"group text-left rounded-2xl bg-white border border-[#f0d5da] p-3.5 hover:border-[#9e5461] transition-all flex flex-col justify-between shadow-2xs\\\"\\n                  >\\n                    <div className=\\\"aspect-4/3 rounded-xl overflow-hidden bg-[#fdf2f4] mb-3\\\">\\n                      <img\\n                        src={cat.imageUrl || ARTWORK.heroBanner}\\n                        alt={cat.name}\\n                        className=\\\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\\\"\\n                      />\\n                    </div>\\n                    <div>\\n                      <p className=\\\"text-[11px] text-[#9e5461] font-medium\\\">\\n                        {cat.status === \'coming-soon\' ? \'Coming Soon\' : \'Available Now\'}\\n                      </p>\\n                      <h3 className=\\\"font-serif text-lg font-semibold text-[#2d1e21] leading-snug\\\">\\n                        {cat.name}\\n                      </h3>\\n                    </div>\\n                  </button>\\n                ))}\\n              </div>\\n            </section>\\n\\n            {/* Ready-to-Ship Bestsellers (Hair Accessories & Jewellery) */}\\n            <section className=\\\"space-y-4\\\">\\n              <div className=\\\"flex items-end justify-between\\\">\\n                <div>\\n                  <p className=\\\"text-xs uppercase tracking-[0.16em] text-[#9e5461] font-semibold\\\">\\n                    Verified Stock \302\267 Immediate Dispatch\\n                  </p>\\n                  <h2 className=\\\"font-serif text-2xl sm:text-3xl text-[#2d1e21] font-semibold\\\">\\n                    Ready-to-Ship Hair Accessories &amp; Jewellery\\n                  </h2>\\n                </div>\\n                <button\\n                  onClick={() => {\\n                    setSelectedCategorySlug(\'all\');\\n                    setScreen(\'shop\');\\n                  }}\\n                  className=\\\"text-xs font-medium text-[#9e5461] hover:underline whitespace-nowrap\\\"\\n                >\\n                  Browse Full Catalogue \342\206\222\\n                </button>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\\\">\\n                {products\\n                  .filter((p) => p.status === \'active\')\\n                  .map((product) => (\\n                    <ProductCard\\n                      key={product.id}\\n                      product={product}\\n                      categoryName={categoryNameMap.get(product.categorySlug) || product.categorySlug}\\n                      isWishlisted={wishlist.includes(product.id)}\\n                      onToggleWishlist={() => toggleWishlist(product.id)}\\n                      onSelect={() => navigateToProduct(product)}\\n                      onAddToCart={() =>\\n                        handleAddToCart(product, 1, product.variants?.[0]?.id || null)\\n                      }\\n                    />\\n                  ))}\\n              </div>\\n            </section>\\n\\n            {/* Draft Hampers Preview (Non-purchasable until owner publishes in Admin) */}\\n            <section className=\\\"rounded-3xl bg-[#fdf2f4]/70 border border-[#f0d5da] p-6 sm:p-8 space-y-5\\\">\\n              <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-3\\\">\\n                <div>\\n                  <p className=\\\"text-xs uppercase tracking-[0.16em] text-[#9e5461] font-semibold\\\">\\n                    Upcoming Signature Gift Boxes \302\267 Draft Catalogue Preview\\n                  </p>\\n                  <h2 className=\\\"font-serif text-2xl sm:text-3xl text-[#2d1e21] font-semibold\\\">\\n                    Pretty Charm Curated Gift Hampers\\n                  </h2>\\n                  <p className=\\\"text-xs text-[#7c5c63] mt-1 max-w-2xl\\\">\\n                    These 4 initial hamper configurations are currently in <strong>Draft</strong> status awaiting final owner confirmation of box contents, photography, and stock in the Admin Panel before ordering opens.\\n                  </p>\\n                </div>\\n                <button\\n                  onClick={() => setScreen(\'admin\')}\\n                  className=\\\"px-4 py-2 rounded-full bg-white border border-[#e5c2c9] text-xs font-medium text-[#9e5461] hover:bg-[#fdf2f4] whitespace-nowrap self-start sm:self-auto\\\"\\n                >\\n                  Confirm &amp; Publish in Admin \342\206\222\\n                </button>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\\\">\\n                {products\\n                  .filter((p) => p.categorySlug === \'gift-hampers\')\\n                  .map((product) => (\\n                    <ProductCard\\n                      key={product.id}\\n                      product={product}\\n                      categoryName={categoryNameMap.get(product.categorySlug) || \'Gift Hampers\'}\\n                      isWishlisted={wishlist.includes(product.id)}\\n                      onToggleWishlist={() => toggleWishlist(product.id)}\\n                      onSelect={() => navigateToProduct(product)}\\n                      onAddToCart={() =>\\n                        handleAddToCart(product, 1, product.variants?.[0]?.id || null)\\n                      }\\n                    />\\n                  ))}\\n              </div>\\n            </section>\\n\\n            {/* Recently Viewed Items */}\\n            {recentlyViewed.length > 0 && (\\n              <section className=\\\"space-y-4\\\">\\n                <h2 className=\\\"font-serif text-2xl text-[#2d1e21] font-semibold\\\">\\n                  Recently Viewed\\n                </h2>\\n                <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-4\\\">\\n                  {recentlyViewed\\n                    .map((id) => products.find((p) => p.id === id))\\n                    .filter(Boolean)\\n                    .map((product: any) => (\\n                      <button\\n                        key={product.id}\\n                        onClick={() => navigateToProduct(product)}\\n                        className=\\\"text-left p-3 rounded-2xl bg-white border border-[#f0d5da] hover:border-[#9e5461] transition-all flex items-center gap-3\\\"\\n                      >\\n                        <img\\n                          src={product.images?.[0] || ARTWORK.heroBanner}\\n                          alt={product.name}\\n                          className=\\\"w-14 h-14 rounded-xl object-cover bg-[#fdf2f4] shrink-0\\\"\\n                        />\\n                        <div className=\\\"min-w-0\\\">\\n                          <p className=\\\"text-xs font-semibold text-[#2d1e21] truncate\\\">\\n                            {product.name}\\n                          </p>\\n                          <p className=\\\"text-xs text-[#9e5461] font-tabular mt-0.5\\\">\\n                            {formatINR(product.sellingPricePaise)}\\n                          </p>\\n                        </div>\\n                      </button>\\n                    ))}\\n                </div>\\n              </section>\\n            )}\\n          </div>\\n        )}\"}, {\"AllowMultiple\":false, \"EndLine\":2992, \"ReplacementContent\":\"      {/* K. Redesigned Footer with All Required Working Links */}\\n      <footer\\n        data-testid=\\\"site-footer\\\"\\n        className=\\\"bg-[#faf4f5] border-t border-[#ebd7dc] mt-16 py-12 px-4 sm:px-6 text-xs text-[#5c3d42]\\\"\\n      >\\n        <div className=\\\"max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-8\\\">\\n          <div className=\\\"col-span-2 sm:col-span-1 space-y-2.5\\\">\\n            <span className=\\\"font-serif text-2xl font-semibold text-[#2b1c20] block\\\">\\n              Pretty Charm\\n            </span>\\n            <p className=\\\"text-[#6f5057] leading-relaxed\\\">\\n              Curated gift hampers, satin hair accessories &amp; demifine jewellery dispatched pan-India from Gurugram, Haryana (122001).\\n            </p>\\n          </div>\\n\\n          <div className=\\\"space-y-2.5\\\">\\n            <p className=\\\"font-semibold text-[#2b1c20] uppercase tracking-wider\\\">\\n              Explore &amp; Care\\n            </p>\\n            <ul className=\\\"space-y-1.5\\\">\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'about\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  About Us\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'contact\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  Contact\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'faq\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  FAQ\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'track-order\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  Track My Order\\n                </button>\\n              </li>\\n            </ul>\\n          </div>\\n\\n          <div className=\\\"space-y-2.5\\\">\\n            <p className=\\\"font-semibold text-[#2b1c20] uppercase tracking-wider\\\">Policies</p>\\n            <ul className=\\\"space-y-1.5\\\">\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'shipping-policy\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  Shipping Policy\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'return-policy\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  Returns and Refunds\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'privacy-policy\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  Privacy Policy\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'terms\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  Terms and Conditions\\n                </button>\\n              </li>\\n            </ul>\\n          </div>\\n\\n          <div className=\\\"space-y-2.5\\\">\\n            <p className=\\\"font-semibold text-[#2b1c20] uppercase tracking-wider\\\">Connect</p>\\n            <ul className=\\\"space-y-1.5\\\">\\n              <li>\\n                <a\\n                  href={buildInstagramProfileUrl(generalSettings.instagramHandle).url}\\n                  target=\\\"_blank\\\"\\n                  rel=\\\"noreferrer\\\"\\n                  data-testid=\\\"footer-instagram-link\\\"\\n                  className=\\\"hover:text-[#9e5461]\\\"\\n                >\\n                  Instagram ({buildInstagramProfileUrl(generalSettings.instagramHandle).handle})\\n                </a>\\n              </li>\\n              {generalSettings.supportWhatsapp && (\\n                <li>\\n                  <a\\n                    href={buildSafeWhatsAppUrl(generalSettings.supportWhatsapp, \'support\', {})}\\n                    target=\\\"_blank\\\"\\n                    rel=\\\"noreferrer\\\"\\n                    data-testid=\\\"footer-whatsapp-link\\\"\\n                    className=\\\"hover:text-[#9e5461]\\\"\\n                  >\\n                    WhatsApp Support\\n                  </a>\\n                </li>\\n              )}\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'3d-studio\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  3D Hamper Studio\\n                </button>\\n              </li>\\n              <li>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setScreen(\'splash\')}\\n                  className=\\\"hover:text-[#9e5461] cursor-pointer\\\"\\n                >\\n                  Brand Welcome Screen\\n                </button>\\n              </li>\\n            </ul>\\n          </div>\\n        </div>\\n      </footer>\", \"StartLine\":2890, \"TargetContent\":\"      {/* Footer with all 23 Required Customer Screens Accessible */}\\n      <footer className=\\\"bg-[#fdf2f4] border-t border-[#f0d5da] mt-16 py-10 px-4 sm:px-6 text-xs text-[#5c3d42]\\\">\\n        <div className=\\\"max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-8\\\">\\n          <div className=\\\"col-span-2 sm:col-span-1 space-y-2\\\">\\n            <span className=\\\"font-serif text-2xl font-semibold text-[#2d1e21]\\\">\\n              Pretty Charm\\n            </span>\\n            <p className=\\\"text-[#7c5c63] leading-relaxed\\\">\\n              Curated keepsake gift hampers, hair accessories &amp; demifine jewellery shipped pan-India from Gurugram, Haryana (122001).\\n            </p>\\n          </div>\\n\\n          <div className=\\\"space-y-2\\\">\\n            <p className=\\\"font-semibold text-[#2d1e21] uppercase tracking-wider\\\">Shop</p>\\n            <ul className=\\\"space-y-1.5\\\">\\n              <li>\\n                <button onClick={() => setScreen(\'shop\')} className=\\\"hover:text-[#9e5461]\\\">\\n                  All Products\\n                </button>\\n              </li>\\n              <li>\\n                <button onClick={() => setScreen(\'categories\')} className=\\\"hover:text-[#9e5461]\\\">\\n                  Categories\\n                </button>\\n              </li>\\n              <li>\\n                <button onClick={() => setScreen(\'3d-studio\')} className=\\\"hover:text-[#9e5461]\\\">\\n                  3D Hamper Studio\\n                <