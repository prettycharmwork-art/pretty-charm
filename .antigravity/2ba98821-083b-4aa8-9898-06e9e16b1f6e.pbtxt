    content: "  });\n});\n\napp.post(\'/api/customer/addresses\', (req, res) => {\n  const session = getCustomerSession(req);\n  if (!session) {\n    res.status(401).json({ error: \'Please sign in to save addresses.\' });\n    return;\n  }\n  const { label, fullName, mobile, houseFlat, streetLocality, city, state, pincode, deliveryInstructions } =\n    req.body || {};\n  const pins = getAllServiceablePins();\n  const check = validateCheckoutAddress(\n    { fullName, mobile, houseFlat, streetLocality, city, state, pincode },\n    pins\n  );\n  if (!check.valid) {\n    res.status(400).json({ error: check.errors.join(\' \') });\n    return;\n  }\n  const id = `addr-${Date.now()}`;\n  db.prepare(`\n    INSERT INTO addresses (id, customer_id, label, full_name, mobile, house_flat, street_locality, city, state, pincode, delivery_instructions, is_default, created_at)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?)\n  `).run(\n    id,\n    session.customerId,\n    (label || \'Home\').trim(),\n    fullName.trim(),\n    normalizeIndianMobile(mobile),\n    houseFlat.trim(),\n    streetLocality.trim(),\n    city.trim(),\n    state.trim(),\n    pincode.trim(),\n    (deliveryInstructions || \'\').trim(),\n    new Date().toISOString()\n  );\n  res.status(201).json({ id });\n});\n\napp.delete(\'/api/customer/addresses/:id\', (req, res) => {\n  const session = getCustomerSession(req);\n  if (!session) {\n    res.status(401).json({ error: \'Unauthorized\' });\n    return;\n  }\n  db.prepare(\'DELETE FROM addresses WHERE id = ? AND customer_id = ?\').run(\n    req.params.id,\n    session.customerId\n  );\n  res.json({ deleted: true });\n});\n\n// ============================================================================\n// ADMIN AUTHENTICATION & BOOTSTRAP (SECTION 7)\n// ============================================================================\n\napp.get(\'/api/admin/status\', (_req, res) => {\n  const count = (db.prepare(\'SELECT COUNT(*) as c FROM admin_users\').get() as { c: number }).c;\n  res.json({"
