er\').click();\\n  await page.waitForTimeout(600);\\n\\n  const rejectedMiniStatus = await page.getByTestId(\'image-status-prod-mini-hamper\').innerText();\\n  const finalBadgeText = await page.getByTestId(\'catalogue-integrity-badge\').innerText();\\n\\n  return {\\n    reportVisible,\\n    badgeText,\\n    initialClawStatus,\\n    initialMiniStatus,\\n    stagedMiniStatus,\\n    approveBtnVisible,\\n    rejectedMiniStatus,\\n    finalBadgeText\\n  };\\n}\\\" && playwright-cli close\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Verifying Admin Image Report staging and rejection in Chromium\", \"toolSummary\":\"Verify Admin Image Report in Chromium\"}"
