  planner_response {
    thinking: "**Inspecting Server Code**\n\nI\'m now diving into lines 1-45 of `server.ts`. My aim is to import specific functions and constants. I\'m focusing on `validateCandidateProductImage`, `applyApprovedProductImageToGallery`, `verifyCatalogueIntegrityUnchanged`, `PRODUCT_IMAGE_AUDIT_STATUSES`, and `ProductImageAuditStatus` from `./src/shared/domainLogic`.\n\n\n"
    tool_calls {
      id: "call_269657"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add Original Product Photo Verification, Search, Candidate Validation, Admin Approval/Rejection, and Catalogue Integrity Report routes to server.ts\", \"Instruction\":\"Import photo audit helpers from domainLogic and add buildProductImageAuditReport and /api/admin/product-images/* routes\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":41, \"ReplacementContent\":\"  calculateFinancialReport,\\n  sanitizeSpreadsheetCell,\\n  normalizeIndianMobile,\\n  paiseToRupees,\\n  validateCandidateProductImage,\\n  applyApprovedProductImageToGallery,\\n  verifyCatalogueIntegrityUnchanged,\\n  PRODUCT_IMAGE_AUDIT_STATUSES,\\n  ProductImageAuditStatus,\\n  CatalogueIntegritySnapshot,\\n} from \'./src/shared/domainLogic\';\", \"StartLine\":35, \"TargetContent\":\"  calculateFinancialReport,\\n  sanitizeSpreadsheetCell,\\n  normalizeIndianMobile,\\n  paiseToRupees,\\n} from \'./src/shared/domainLogic\';\"}, {\"AllowMultiple\":false, \"EndLine\":1185, \"ReplacementContent\":\"    adminUsers: db\\n      .prepare(\'SELECT id, email, full_name, role, is_active, last_login_at, created_at FROM admin_users\')\\n      .all(),\\n    auditLogs: db.prepare(\'SELECT * FROM audit_logs ORDER BY created_at DESC LIMIT 80\').all(),\\n    imageAuditReport: buildProductImageAuditReport(),\\n  };\\n}\\n\\nfunction getCurrentCatalogueIntegritySnapshot(): CatalogueIntegritySnapshot[] {\\n  const prods = db.prepare(\'SELECT * FROM products ORDER BY id ASC\').all() as any[];\\n  const vars = db.prepare(\'SELECT * FROM product_variants ORDER BY id ASC\').all() as any[];\\n  return prods.map((p) => ({\\n    id: p.id,\\n    name: p.name,\\n    slug: p.slug,\\n    categorySlug: p.category_slug,\\n    sku: p.sku,\\n    sellingPricePaise: p.selling_price_paise,\\n    stockQty: p.stock_qty,\\n    status: p.status,\\n    variantSkus: vars.filter((v) => v.product_id === p.id).map((v) => v.sku),\\n  }));\\n}\\n\\nfunction buildProductImageAuditReport() {\\n  const { categories, products } = getFormattedCatalogue(true);\\n  const catMap = new Map(categories.map((c) => [c.slug, c.name]));\\n  const auditRows = db.prepare(\'SELECT * FROM product_image_audits\').all() as any[];\\n  const auditMap = new Map(auditRows.map((a) => [a.product_id, a]));\\n\\n  const baselineRow = db\\n    .prepare(\\\"SELECT value_json FROM store_settings WHERE key = \'catalogue_integrity_baseline\'\\\")\\n    .get() as { value_json: string } | undefined;\\n  const currentSnapshot = getCurrentCatalogueIntegritySnapshot();\\n  const baselineSnapshot: CatalogueIntegritySnapshot[] = baselineRow\\n    ? JSON.parse(baselineRow.value_json)\\n    : currentSnapshot;\\n\\n  const integrity = verifyCatalogueIntegrityUnchanged(baselineSnapshot, currentSnapshot);\\n\\n  const items = products.map((p) => {\\n    const audit = auditMap.get(p.id);\\n    const auditStatus: ProductImageAuditStatus =\\n      audit?.audit_status || \'Image Needed\';\\n    return {\\n      productId: p.id,\\n      productName: p.name,\\n      brand: audit?.brand || \'Pretty Charm\',\\n      categorySlug: p.categorySlug,\\n      categoryName: catMap.get(p.categorySlug) || p.categorySlug,\\n      sku: p.sku,\\n      sellingPricePaise: p.sellingPricePaise,\\n      stockQty: p.stockQty,\\n      productStatus: p.status,\\n      variants: p.variants.map((v: any) => ({ id: v.id, name: v.name, sku: v.sku })),\\n      existingImages: p.images,\\n      currentPrimaryImage: p.images?.[0] || null,\\n      searchQuery:\\n        audit?.search_query || `\\\"Pretty Charm\\\" \\\"${p.name}\\\" \\\"${p.sku}\\\"`,\\n      auditStatus,\\n      candidateImageUrl: audit?.candidate_image_url || null,\\n      sourceUrl: audit?.source_url || null,\\n      licenseInfo: audit?.license_info || null,\\n      reason:\\n        audit?.reason ||\\n        \'No exact manufacturer or authorized supplier photograph with verified reuse permission found yet.\',\\n      preserveExisting: audit ? Boolean(audit.preserve_existing) : true,\\n      setAsPrimary: audit ? Boolean(audit.set_as_primary) : true,\\n      approvedByEmail: audit?.approved_by_email || null,\\n      approvedAt: audit?.approved_at || null,\\n      updatedAt: audit?.updated_at || p.updatedAt,\\n    };\\n  });\\n\\n  const statusBreakdown: Record<ProductImageAuditStatus, number> = {\\n    \'Original image found \342\200\224 awaiting approval\': 0,\\n    \'Image successfully added\': 0,\\n    \'Image Needed\': 0,\\n    \'Source or reuse permission unverified\': 0,\\n    \'Search failed\': 0,\\n  };\\n\\n  for (const item of items) {\\n    if (statusBreakdown[item.auditStatus] !== undefined) {\\n      statusBreakdown[item.auditStatus] += 1;\\n    }\\n  }\\n\\n  return {\\n    totalExistingProducts: items.length,\\n    approvedOriginalImagesCount: statusBreakdown[\'Image successfully added\'],\\n    awaitingApprovalCount: statusBreakdown[\'Original image found \342\200\224 awaiting approval\'],\\n    stillNeedingImagesCount:\\n      statusBreakdown[\'Image Needed\'] +\\n      statusBreakdown[\'Source or reuse permission unverified\'] +\\n      statusBreakdown[\'Search failed\'],\\n    statusBreakdown,\\n    availableStatuses: PRODUCT_IMAGE_AUDIT_STATUSES,\\n    integrityVerification: {\\n      unchanged: integrity.unchanged,\\n      discrepancies: integrity.discrepancies,\\n      beforeCount: baselineSnapshot.length,\\n      afterCount: currentSnapshot.length,\\n    },\\n    items,\\n  };\\n}\\n\\napp.get(\'/api/product-image-report\', (_req, res) => {\\n  res.json(buildProductImageAuditReport());\\n});\\n\\napp.get(\'/api/admin/product-image-report\', requireAdmin, (_req, res) => {\\n  res.json(buildProductImageAuditReport());\\n});\\n\\n// Search permitted public repositories (Wikimedia Commons API) for exact product + brand + SKU match\\napp.post(\'/api/admin/product-images/search/:productId\', requireAdmin, async (req, res) => {\\n  const admin = (req as any).adminSession as AdminSession;\\n  const productId = req.params.productId;\\n  const prod = db.prepare(\'SELECT * FROM products WHERE id = ?\').get(productId) as any;\\n  if (!prod) {\\n    res.status(404).json({ error: \'Existing product not found.\' });\\n    return;\\n  }\\n\\n  const variants = db\\n    .prepare(\'SELECT name, sku FROM product_variants WHERE product_id = ?\')\\n    .all(productId) as Array<{ name: string; sku: string }>;\\n  const variantHint = variants.length > 0 ? ` \\\"${variants[0].name}\\\"` : \'\';\\n  const exactQuery = `\\\"Pretty Charm\\\" \\\"${prod.name}\\\" \\\"${prod.sku}\\\"${variantHint}`;\\n  const now = new Date().toISOString();\\n\\n  try {\\n    const commonsUrl = `https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=${encodeURIComponent(\\n      `Pretty Charm ${prod.name} ${prod.sku}`\\n    )}&gsrnamespace=6&prop=imageinfo&iiprop=url|extmetadata|mime&format=json&origin=*`;\\n\\n    const response = await fetch(commonsUrl, {\\n      headers: { \'User-Agent\': \'PrettyCharmCatalogAudit/1.0 (https://prettycharm.in)\' },\\n    });\\n\\n    if (!response.ok) {\\n      throw new Error(`Permitted search API returned HTTP ${response.status}`);\\n    }\\n\\n    const data = (await response.json()) as any;\\n    const pages = data?.query?.pages ? Object.values(data.query.pages) : [];\\n\\n    // Verify if any returned image actually matches the exact Pretty Charm SKU & brand\\n    const exactMatch: any = pages.find((pg: any) => {\\n      const title = String(pg?.title || \'\').toLowerCase();\\n      return title.includes(\'pretty charm\') && title.includes(String(prod.sku).toLowerCase());\\n    });\\n\\n    let newStatus: ProductImageAuditStatus = \'Image Needed\';\\n    let candidateUrl: string | null = null;\\n    let sourceUrl: string | null = null;\\n    let licenseInfo = \'Checked Wikimedia Commons & Permitted Brand Sources\';\\n    let reason = `Searched permitted repositories with exact query ${exactQuery}. No exact original photograph matching proprietary SKU ${prod.sku} was found; leaving existing image unchanged.`;\\n\\n    if (exactMatch && exactMatch.imageinfo?.[0]?.url) {\\n      const info = exactMatch.imageinfo[0];\\n      candidateUrl = info.url;\\n      sourceUrl = info.descriptionurl || \'https://commons.wikimedia.org\';\\n      licenseInfo =\\n        info.extmetadata?.LicenseShortName?.value || \'Verified Wikimedia Commons License\';\\n      newStatus = \'Original image found \342\200\224 awaiting approval\';\\n      reason = `Exact brand/SKU match found on permitted source (${licenseInfo}) \342\200\224 awaiting Admin approval.`;\\n    } else {\\n      // Preserve existing third-party unverified notice if one was already documented\\n      const existingAudit = db\\n        .prepare(\'SELECT * FROM product_image_audits WHERE product_id = ?\')\\n        .get(productId) as any;\\n      if (existingAudit?.audit_status === \'Source or reuse permission unverified\') {\\n        newStatus = \'Source or reuse permission unverified\';\\n        sourceUrl = existingAudit.source_url;\\n        licenseInfo = existingAudit.license_info;\\n        reason = existingAudit.reason;\\n      }\\n    }\\n\\n    db.prepare(`\\n      INSERT INTO product_image_audits (\\n        product_id, brand, search_query, audit_status, candidate_image_url, source_url, license_info, reason, preserve_existing, set_as_primary, updated_at\\n      ) VALUES (?, \'Pretty Charm\', ?, ?, ?, ?, ?, ?, 1, 1, ?)\\n      ON CONFLICT(product_id) DO UPDATE SET\\n        search_query = excluded.search_query,\\n        audit_status = excluded.audit_status,\\n        candidate_image_url = excluded.candidate_image_url,\\n        source_url = excluded.source_url,\\n        license_info = excluded.license_info,\\n        reason = excluded.reason,\\n        updated_at = excluded.updated_at\\n    `).run(productId, exactQuery, newStatus, candidateUrl, sourceUrl, licenseInfo, reason, now);\\n\\n    writeAuditLog({\\n      actorId: admin.userId,\\n      actorEmail: admin.email,\\n      actorRole: admin.role,\\n      action: \'PRODUCT_IMAGE_SEARCH_EXECUTED\',\\n      entityType: \'product_image_audits\',\\n      entityId: productId,\\n      details: { sku: prod.sku, query: exactQuery, resultStatus: newStatus },\\n    });\\n\\n    res.json({ report: buildProductImageAuditReport() });\\n  } catch (err: any) {\\n    const failReason = `Search request failed: ${err.message || \'Network error contacting permitted search API\'}. Existing product image left unchanged.`;\\n    db.prepare(`\\n      UPDATE product_image_audits\\n      SET audit_status = \'Search failed\', reason = ?, updated_at = ?\\n      WHERE product_id = ?\\n    `).run(failReason, now, productId);\\n\\n    res.json({ report: buildProductImageAuditReport() });\\n  }\\n});\\n\\n// Submit a candidate original photograph for an existing product (validates file/URL before staging for approval)\\napp.post(\'/api/admin/product-images/candidate/:productId\', requireAdmin, async (req, res) => {\\n  const admin = (req as any).adminSession as AdminSession;\\n  const productId = req.params.productId;\\n  const prod = db.prepare(\'SELECT * FROM products WHERE id = ?\').get(productId) as any;\\n  if (!prod) {\\n    res.status(404).json({ error: \'Existing product not found.\' });\\n    return;\\n  }\\n\\n  const {\\n    candidateImageUrl,\\n    sourceUrl,\\n    licenseInfo,\\n    isAiGenerated = false,\\n    hasReusePermission = true,\\n    exactProductMatch = true,\\n  } = req.body || {};\\n\\n  let detectedMime: string | undefined;\\n  let detectedBytes: number | undefined;\\n  const rawCandidate = String(candidateImageUrl || \'\').trim();\\n\\n  if (rawCandidate.startsWith(\'data:image/\')) {\\n    const match = rawCandidate.match(/^data:(image\\\\/[a-zA-Z0-9+.-]+);base64,(.+)$/);\\n    if (match) {\\n      detectedMime = match[1].toLowerCase();\\n      detectedBytes = Buffer.from(match[2], \'base64\').byteLength;\\n    }\\n  } else if (/^https:\\\\/\\\\//i.test(rawCandidate)) {\\n    try {\\n      const headRes = await fetch(rawCandidate, { method: \'HEAD\' });\\n      if (headRes.ok) {\\n        const ct = headRes.headers.get(\'content-type\');\\n        if (ct) detectedMime = ct.split(\';\')[0].trim().toLowerCase();\\n        const cl = headRes.headers.get(\'content-length\');\\n        if (cl && Number.isFinite(Number(cl))) detectedBytes = Number(cl);\\n      }\\n    } catch {\\n      // Allow validation to proceed based on URL & declaration if remote host blocks HEAD\\n    }\\n  }\\n\\n  const check = validateCandidateProductImage({\\n    urlOrDataUri: rawCandidate,\\n    sourceUrl: String(sourceUrl || \'\').trim(),\\n    mimeType: detectedMime,\\n    byteLength: detectedBytes,\\n    isAiGenerated: Boolean(isAiGenerated),\\n    hasReusePermission: Boolean(hasReusePermission),\\n    exactProductMatch: Boolean(exactProductMatch),\\n  });\\n\\n  const now = new Date().toISOString();\\n  db.prepare(`\\n    UPDATE product_image_audits\\n    SET audit_status = ?,\\n        candidate_image_url = ?,\\n        source_url = ?,\\n        license_info = ?,\\n        reason = ?,\\n        updated_at = ?\\n    WHERE product_id = ?\\n  `).run(\\n    check.recommendedStatus,\\n    check.valid ? rawCandidate : null,\\n    String(sourceUrl || \'\').trim() || null,\\n    String(licenseInfo || \'Authorized Original Product Photograph\').trim(),\\n    check.reason,\\n    now,\\n    productId\\n  );\\n\\n  writeAuditLog({\\n    actorId: admin.userId,\\n    actorEmail: admin.email,\\n    actorRole: admin.role,\\n    action: \'PRODUCT_IMAGE_CANDIDATE_EVALUATED\',\\n    entityType: \'product_image_audits\',\\n    entityId: productId,\\n    details: {\\n      sku: prod.sku,\\n      valid: check.valid,\\n      recommendedStatus: check.recommendedStatus,\\n      reason: check.reason,\\n    },\\n  });\\n\\n  if (!check.valid) {\\n    res.status(400).json({ error: check.reason, report: buildProductImageAuditReport() });\\n    return;\\n  }\\n\\n  res.json({ report: buildProductImageAuditReport() });\\n});\\n\\n// Admin Approves Candidate Original Photograph -> Updates ONLY images_json on that exact existing product\\napp.post(\'/api/admin/product-images/approve/:productId\', requireAdmin, (req, res) => {\\n  const admin = (req as any).adminSession as AdminSession;\\n  const productId = req.params.productId;\\n  const { replaceExisting = false, setAsPrimary = true } = req.body || {};\\n\\n  const prod = db.prepare(\'SELECT * FROM products WHERE id = ?\').get(productId) as any;\\n  if (!prod) {\\n    res.status(404).json({ error: \'Existing product not found.\' });\\n    return;\\n  }\\n\\n  const audit = db\\n    .prepare(\'SELECT * FROM product_image_audits WHERE product_id = ?\')\\n    .get(productId) as any;\\n  if (!audit || !audit.candidate_image_url) {\\n    res.status(400).json({\\n      error: \'No verified candidate original photograph is staged for approval on this product.\',\\n    });\\n    return;\\n  }\\n\\n  const existingImages: string[] = JSON.parse(prod.images_json || \'[]\');\\n  const updatedGallery = applyApprovedProductImageToGallery(\\n    existingImages,\\n    audit.candidate_image_url,\\n    {\\n      replaceExisting: Boolean(replaceExisting),\\n      setAsPrimary: Boolean(setAsPrimary),\\n    }\\n  );\\n\\n  const now = new Date().toISOString();\\n  runInTransaction(() => {\\n    // Update ONLY images_json and updated_at on the existing product record\\n    db.prepare(\'UPDATE products SET images_json = ?, updated_at = ? WHERE id = ?\').run(\\n      JSON.stringify(updatedGallery),\\n      now,\\n      productId\\n    );\\n\\n    db.prepare(`\\n      UPDATE product_image_audits\\n      SET audit_status = \'Image successfully added\',\\n          preserve_existing = ?,\\n          set_as_primary = ?,\\n          approved_by_email = ?,\\n          approved_at = ?,\\n          reason = ?,\\n          updated_at = ?\\n      WHERE product_id = ?\\n    `).run(\\n      replaceExisting ? 0 : 1,\\n      setAsPrimary ? 1 : 0,\\n      admin.email,\\n      now,\\n      `Approved by ${admin.email}. Gallery updated (${\\n        replaceExisting ? \'replaced existing\' : \'preserved existing images\'\\n      }, ${setAsPrimary ? \'set as primary image\' : \'appended to gallery\'}). All product IDs, prices, SKUs, variants, and stock remained unchanged.`,\\n      now,\\n      productId\\n    );\\n\\n    writeAuditLog({\\n      actorId: admin.userId,\\n      actorEmail: admin.email,\\n      actorRole: admin.role,\\n      action: \'PRODUCT_ORIGINAL_IMAGE_APPROVED\',\\n      entityType: \'products\',\\n      entityId: productId,\\n      details: {\\n        sku: prod.sku,\\n        sourceUrl: audit.source_url,\\n        replaceExisting: Boolean(replaceExisting),\\n        setAsPrimary: Boolean(setAsPrimary),\\n        galleryCount: updatedGallery.length,\\n      },\\n    });\\n  });\\n\\n  res.json({ report: buildProductImageAuditReport() });\\n});\\n\\n// Admin Rejects Candidate Image -> Leaves product gallery untouched and marks Image Needed\\napp.post(\'/api/admin/product-images/reject/:productId\', requireAdmin, (req, res) => {\\n  const admin = (req as any).adminSession as AdminSession;\\n  const productId = req.params.productId;\\n  const { status = \'Image Needed\', reason } = req.body || {};\\n\\n  const prod = db.prepare(\'SELECT * FROM products WHERE id = ?\').get(productId) as any;\\n  if (!prod) {\\n    res.status(404).json({ error: \'Existing product not found.\' });\\n    return;\\n  }\\n\\n  const finalStatus: ProductImageAuditStatus =\\n    status === \'Source or reuse permission unverified\'\\n      ? \'Source or reuse permission unverified\'\\n      : \'Image Needed\';\\n  const finalReason =\\n    String(reason || \'\').trim() ||\\n    `Candidate image rejected by Admin (${admin.email}). Existing product image preserved unchanged; marked ${finalStatus}.`;\\n  const now = new Date().toISOString();\\n\\n  db.prepare(`\\n    UPDATE product_image_audits\\n    SET audit_status = ?,\\n        candidate_image_url = NULL,\\n        reason = ?,\\n        updated_at = ?\\n    WHERE product_id = ?\\n  `).run(finalStatus, finalReason, now, productId);\\n\\n  writeAuditLog({\\n    actorId: admin.userId,\\n    actorEmail: admin.email,\\n    actorRole: admin.role,\\n    action: \'PRODUCT_ORIGINAL_IMAGE_REJECTED\',\\n    entityType: \'product_image_audits\',\\n    entityId: productId,\\n    details: { sku: prod.sku, finalStatus, reason: finalReason },\\n  });\\n\\n  res.json({ report: buildProductImageAuditReport() });\\n});\\n\\napp.get(\'/api/admin/overview\', requireAdmin, (req, res) => {\\n  const { startDate, endDate } = req.query as { startDate?: string; endDate?: string };\\n  res.json(computeFullAdminOverview(startDate, endDate));\\n});\", \"StartLine\":1173, \"TargetContent\":\"    adminUsers: db\\n      .prepare(\'SELECT id, email, full_name, role, is_active, last_login_at, created_at FROM admin_users\')\\n      .all(),\\n    auditLogs: db.prepare(\'SELECT * FROM audit_logs ORDER BY created_at DESC LIMIT 80\').all(),\\n  };\\n}\\n\\napp.get(\'/api/admin/overview\', requireAdmin, (req, res) => {\\n  const { startDate, endDate } = req.query as { startDate?: string; endDate?: string };\\n  res.json(computeFullAdminOverview(startDate, endDate));\\n});\"}], \"TargetFile\":\"/server.ts\", \"toolAction\":\"Adding product image audit and approval endpoints to server.ts\", \"toolSummary\":\"Add image audit endpoints to server.ts\"}"
      thinking_signature: "\022\362\a\n\357\a\001i\024}\023\022S}\336s\337m\222\017F\036\272\3102Z\373[kb\225\357\264\352\330\372E<\321\217\355}s\313\240\177\336\177\326\242\315j\312\344\253?K\345W\235\222\337\223\325%m\203\300\312I\303h\337\317K\033\245\265\327\213\345\373\217$y\234\206\f\333\222$\031\243|.\253!\325\003\270\344\257\a5\r\363\n\214\303\334\005\375h\252z\3050j#\312\374o\365,\001\367\257\371\203\004\314\247\200\200\005T\225\365\v\307XE\211\262Q\002\356\260`\225\271}\355\272\350 \f\365\002U\345\207\025\200iA\265X\213\2367\323\342\312\235G\322o\037H\201\242\005\"}syT\362\024\243?$<\214\303@[\333\274\f\260J\231\235\336:\366+\366\245mM\201\030UW\t\205\356_\025\3056\350Ta\323\370\237\3511O\314\274&\211_d\345\221\177\0032\241\355\346\325\373p\004\221\222\225\346\3207y\2512x\246K\277\275\266\264&\367\275\263+\265\310?\256\213B\371\342\247$\313\345\001\247\337\361\274\300v\274x\247\377ib\206\325\203\'\262w,\221\312\307\006S\n\264\320\023Y\370\235p\026RM\221\027\366\f\217n\274\313\r\357Z82\262\212\224\002\346\273P\361\272\333\344v\273\2011\306\264\233\242^|;\334O\201|\322\341+z\234\034W\314\034\345\036\332Q\230\001\177\bf`\245\310\a\306\347\036\037\224\017Zx\273\232\373\254\346|m\374(9\024?\271\vO\324r\bS%&\271\247\340\340\026\271\240Rm\213b\335\352_\020Y,\v\')\215\217LT\fZ\202\223\214\030>\200\307k\345c\310q\254b\026\311G_\270\201\266J-\353\370\330S\322\364\031Y\243L\366phE\033\343<\034\337\t\351\024\n5<\244#\262\203,\354\214V\2226\237\177S\252\367V\320\367<\363\251\200\215\273\370}\263\262\350\360\363\036\362\373\217Q\352{\202\004^\267\244\020\034\215\311\250\000\256\n\211\'\323\234\340\247\245\232M\220\346\335\212\216t\236\'\"\001\330C7\037?\223\nA\341,\247g\343\310\374UA\350\354\303\267\356\255\367\370\313\263{^\216\262\3162\360^s\254\203\342\0320\363a\355I(\241*1\373\353n\243*Q&=\372\244R\317\334\240Ju\360\207\v\237\2432\270.G\223\307\230\221\240\"lj;\023\177\366\335\026\231S9\261\004\333\310H\345\274\311\254\251M\214|\360f\037\357\216,\264\034m>\237\253Z@