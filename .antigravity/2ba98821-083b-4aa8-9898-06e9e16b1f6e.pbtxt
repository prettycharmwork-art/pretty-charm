      thinking_signature: "\022\240\005\n\235\005\001i\024}\023O\030I\273a\253C\275\374\214G\336G\250\222\034i\245\370\020\211x\367\362\036\337\354\256\375\275DZe\206\355h\r{e\260\272\235\215_\275\024P\357%\231\365L\021\206\211\242_7\364\004\365\311\003\273\277Zt\205\360\253\271\365\230p\313\274^\355\037\320\252\322d\322\3317e\321\223\210yn`\370\265\324\370\023\345B\321\212\226\220X\346\340\300L\242d\345\033mW\301\222s\na~\211f\251\216=\203\246\"\315\3336\001,\017\371z\262~\\i\246L\253\275.\232\0316\177\251\256MM\273\201\304\030+b\337[\275\212|\266\016<\370\301\326\033\321\335\335\331\262\31197d`\345\326-8wPZ\205\375\331,\003\nT\361\207\261\3462\021\341\362\020\351.\250s\t\037\235\024]\232\331\254\352<\305\336\3069\253\201\031\253\"\270h\315D\264\322:1&0\263C\360\023\222\250:\016\363\r\234=>\275\\b\207\236\271\262)\351\343\001Y\023\313\20690\225,\214\353\256tL\352&\330\205\t\231\277L\303\337\333\225\t\260\305\030\356\210\227\240\234*S\303\302\030\320\345w,\321\260Y\030\a\342N\312\177o\017\372\\\375\204A9B\240)\223\241\204R\216l\324j?k\311H\264s\331\a\200\361\226\274mU\242\215\001q\270\2008\253B\a\021\247|\213\2656l\334\305\343\262L\212\302\2235\036\023|[\323\364\312\021\320N\017/\205:(+\200C/E\326\a\275\244]\311\260\242h\240y\036\025\300\206P\321\316\323\307\272-!\357\327\031+O\3226\366\377\266\034\317-\222\242za\032\342\273=\325L\304\222\3227\201\210\253\003\375>\361\211\336h|\\\301\301\233\373/5\001\334\002x\235\264%\261\222\fq6\022\210\237\242\210\300\237$\316\201\264\374\213\342\303\351\024\253\212\364\201\274\270Dy\370K\036\035\223\362\aa\374H:{\351\215\217\331~dy>bV\223o\001\245\357#\236ueC\247\230\253\343\034k\026\207\207\225\376\265g+V\300\"c\374\303\376\017\212]\370\222\204s\227(\373\311=mX\020@<\335\3516\273\263|\343y6&tn\003\032kc\323uF\215\315X3>A\351\200cM\203\357bw\3523V7\021R\n\3051\024\273H5\177\243v:\226\034~MA\275R\317\250r\231\303\226\221%\002\003\204S\034\302\202OJ}\314\220\350^\345N\372\271Jk\241\365\'\016\362\"*p\241\034\260"
