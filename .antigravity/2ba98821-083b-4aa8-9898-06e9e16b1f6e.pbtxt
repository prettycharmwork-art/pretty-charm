    command_line: "npx --yes tsx -e \"\nimport fs from \'node:fs\';\nimport path from \'node:path\';\n\nconst items = [\n  {\n    productId: \'prod-pearl-claw\',\n    fileTitle: \'File:White_Pearl_hair_catch.jpg\',\n    filename: \'prod-pearl-claw.jpg\'\n  },\n  {\n    productId: \'prod-silk-scrunchie-trio\',\n    fileTitle: \'File:Scrunchie_(386494891).jpg\',\n    filename: \'prod-silk-scrunchie-trio.jpg\'\n  },\n  {\n    productId: \'prod-satin-bow-barrette\',\n    fileTitle: \'File:Pink_bow_for_wrapping,_2026-02-08_(side_view).jpg\',\n    filename: \'prod-satin-bow-barrette.jpg\'\n  },\n  {\n    productId: \'prod-pearl-drop-huggies\',\n    fileTitle: \'File:Ian_Rosenberg_Jeweller_-_Silver_and_pearl_drop_earrings.JPG\',\n    filename: \'prod-pearl-drop-huggies.jpg\'\n  },\n  {\n    productId: \'prod-charm-bracelet\',\n    fileTitle: \'File:Juicy_Couture_charm_bracelet_close_up.jpg\',\n    filename: \'prod-charm-bracelet.jpg\'\n  },\n  {\n    productId: \'prod-quartz-necklace\',\n    fileTitle: \'File:Rose_quartz_pendant_necklace.jpg\',\n    filename: \'prod-quartz-necklace.jpg\'\n  }\n];\n\n(async () => {\n  const outDir = path.resolve(\'./public/uploads/products\');\n  fs.mkdirSync(outDir, { recursive: true });\n\n  for (const item of items) {\n    const apiUrl = \'https://commons.wikimedia.org/w/api.php?action=query&titles=\' + encodeURIComponent(item.fileTitle) + \'&prop=imageinfo&iiprop=url|extmetadata|mime|size&iiurlwidth=800&format=json\';\n    const metaRes = await fetch(apiUrl, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n    const metaJson = await metaRes.json();\n    const page: any = Object.values(metaJson.query.pages)[0];\n    const ii = page.imageinfo[0];\n    const downloadUrl = ii.thumburl || ii.url;\n\n    const imgRes = await fetch(downloadUrl, { headers: { \'User-Agent\': \'PrettyCharmCatalog/1.0 (https://prettycharm.in)\' } });\n    if (!imgRes.ok) {\n      console.error(\'Failed to download\', item.productId, imgRes.status);\n      continue;\n    }\n    const buf = Buffer.from(await imgRes.arrayBuffer());\n    const dest = path.join(outDir, item.filename);\n    fs.writeFileSync(dest, buf);\n    const isJpeg = buf[0] === 0xff && buf[1] === 0xd8 && buf[2] === 0xff;\n    console.log(item.productId, \'-> saved\', dest, \'bytes:\', buf.length, \'isJpeg:\', isJpeg, \'dim:\', ii.thumbwidth || ii.width, \'x\', ii.thumbheight || ii.height, \'license:\', ii.extmetadata?.LicenseShortName?.value, \'source:\', ii.descriptionurl);\n  }\n})();\n\""
