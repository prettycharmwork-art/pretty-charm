        instruction: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Pretty Charm \342\200\223 Gift Hampers, Jewellery &amp; Hair Accessories</title>\n    <meta name=\"description\" content=\"Shop curated gift hampers, hair accessories, and elegant jewellery from Pretty Charm in Gurugram, India with transparent INR pricing and order tracking.\" />\n    <meta property=\"og:title\" content=\"Pretty Charm \342\200\223 Gift Hampers, Jewellery &amp; Hair Accessories\" />\n    <meta property=\"og:description\" content=\"Shop curated gift hampers, hair accessories, and elegant jewellery from Pretty Charm in Gurugram, India with transparent INR pricing and order tracking.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"Pretty Charm\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Pretty Charm \342\200\223 Gift Hampers, Jewellery &amp; Hair Accessories\" />\n    <meta name=\"twitter:description\" content=\"Shop curated gift hampers, hair accessories, and elegant jewellery from Pretty Charm in Gurugram, India with transparent INR pricing and order tracking.\" />\n    <meta name=\"theme-color\" content=\"#fdf2f4\" />\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"PrettyCharm\" />\n    <link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/icon.svg\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" />\n    <script type=\"application/ld+json\">\n      {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"OnlineStore\",\n        \"name\": \"Pretty Charm\",\n        \"description\": \"Online store for gift hampers, hair accessories, and dainty jewellery shipping from Gurugram, Haryana, India.\",\n        \"currenciesAccepted\": \"INR\",\n        \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"addressLocality\": \"Gurugram\",\n          \"addressRegion\": \"Haryana\",\n          \"postalCode\": \"122001\",\n          \"addressCountry\": \"IN\"\n        }\n      }\n    </script>\n  </head>\n  <body class=\"bg-[#fffdfb] text-[#2d1e22] antialiased selection:bg-[#f6d5dc] selection:text-[#592531]\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n"
