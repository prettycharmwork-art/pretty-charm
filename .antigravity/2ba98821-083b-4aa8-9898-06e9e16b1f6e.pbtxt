      thinking_signature: "\022\210\031\n\205\031\001i\024}\023\225\215\316\212\027\270\0336\262K\304\247qsU\003\346A\222\374y\215\277\377\276_\244S\t\356.\364\306\2377\370$C\236\250=\276\2555\207\026\330\217aT\233\245\266i\204\233\306\263i\3323K\273\271K\255\361\363\275\3674\003\310\364\3765+\236\223\3463\376\231q\354\323i&\211\345\'s\270\265*(\261c_Nj\254\000\332\373\301\270\a\323\353\331&\')j\n\370\025\272\241\223Z\260\2476+\356D\017\343R!a\261D\235\361\216\236PR\261\335\375\355I\\u\035\325\314\331\037\253\255rBD\344x\364\267\a\021\247\200\245\207C\031[\336M\354\n\214N\371\033\347`p\a\205\314zo\a\355\021C\344\"w,\324\307\004\003\233qWD\372k\362KQ\376\310Np`E\274K\n`\033\2001\037\233Im\265 \253m(\307\254eo\034\205\030Z*\031=\272\025%;]\234\311\203\255\177\361eV4\020\331$\256\204\223r\f\305\nI\305\232\332\b\034&~\331\336\263\ve\352\017sD\231\022\f\364\276-\262&\320E\257\"\036\023\302\366{\255c\031\251\346\232\006W\370^a\026_zSO\316\230\177\260E=1\211\317\300\264Mh\fR\032\001Z\362\332\2522\270G\223\324F\211\330^\224\307rK\350\252Q\006,\321/\031\215\206\321z\026\217\331\234\v^\346n\203\331\332\027d\230\017;\263\3660\202\027\237\a\031\3635\232ijas4g\212\r\275\255O4\265\206d\323\v\307\305I\021&\325\375:u\221\022\346\346\301\327i\321\242\310\375p\177\326\226\033pp\033?\021\267\n\305\351M\360\344\364\317)\326i\241\263#_:\265)\245\246\035J\207\204\355\241\226\035\313\021^\336\201\216\242\020\210\3019\244\240B\306\343\335y^R\bq\030\314\240\230|\323\231\340\245\233\371uQq\005\232\263\367\217`rKXN\310\316K\365\361iF\346\351\363\302\246^\226b\020\363\325\355\350E\276!\003[s\304\352x\370\3445\024\304(y\271\334C\256\241+\333\262\247\rW\220i\367\3054\351k~\304\034\345\024RY\025\351\2063\235\362\2766\306K\377\215\330\2765\207\345\t>\213VS\225\331\301z/x\261[S7q`c\003\026\371\306,b\341\\\200\354\201xh\211\323\242\035\v\226\212\366\al\336\030\277\266\227\376\367 c\230\227{\305m\360T\274\376\245\252\207\334\335\234\350\260b\205\257\006\023\276\027\302G\233\034\346a\r6\367\3573W,t1\3