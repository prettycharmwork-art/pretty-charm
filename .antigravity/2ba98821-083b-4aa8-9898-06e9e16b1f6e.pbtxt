      thinking_signature: "\022\263\024\n\260\024\001i\024}\023\210\270T\231\032?B\370\v\263P\313\"n\001:$\231\232\365O\202\235\024\307\336Z\373\247\253\245\017+\236x\264\0063\313\243\t\a\246\a\344t\3428\022fD\312\360\\\225\\\aJ\242\351\341\035\272\326\236(\2632\221B\362\\\334\334+\001\332\377\234\343=i\235\366\303L!\305\025?\276^\372\240J\365\201D\205|\335\303\243$\021\0277\310h)\fi\264s5e\203\260\337s\314v\322\234-\020\023P\357i4\213p\247\212j\373\207D\363\254[\310_s\244\351&k.\264b\021\322\342\355\035t\303\207\221\323w,\'sd*\255N\020\317\204,bd&\027\335\377\366\025\335R\211\240\022<d\212m\025\256\377(p\205\016]k\340\321\271(\262J\t=\036\'\330\323\023\177-H\324\023\\\267p\250lnA1\350\341\232\347[\315\"\274\fW\353>\215\212Qj\353\254\226\207\236\300\2208\304\3021\334\001\">7\216\205\330H\247\317\376\317\253\210\214\016kR2\024\215}:\277\250@\376\000\2103\352\342\203\340\221&\035\327*jdZ\300\"G\"u\f\023?\374\273@\nw\344\1778>N\261\201\361\233\031\304\340\r\bFWM1-\327-V\351b\272\327\362U\0365j\315\001\276>\362\3656z<\252.\211v|\255RVYX{\201W.J\034\301\221\261x\357\251v\fB\002\006\\\364\245\311\260\232\251V\341\2025$dy\226\305\256\276\263\312+\327,\177\3238*b(\363\a\337\225(\324>\035\002\214\201\'\026m\370V>:\376\226\202Z.\372G\371\344\336\213>\231[\357\203\027\r\262\305aV\2636\334\260\205\217\036OQ3PY\006f>\020\313m&G\021\221\300\a\272\315^X\300\024\3748\375\222\250\2051Hk\274\362\375(\026\036\\\'\266\270\215\251\200\2412E\363\263\363\255\343\'\345\263\235\345\216\221y\336\345\003k\022,E:\267\017\320I\376\215\004\321=\240\234]\034K\027%s=/F\230\031e6J\317\000_\266\341+\332;\353<%s.M\206\311\231\333@\364\235\217\ax\212N\326\354\212\346\342h\001j\316\026\333\037\343\357V\t\243\365.\257\031\336\377\322\241\3619w\254\214\315\270\004x\223\217\211\372\324\267\021\004\300\253\241\241d\372\n\310\001\350?\2754H[\214\177wNa\037!\217Y>\307Y1N\256\307\024\373\311\004\200\006(\354\347\337\351\311\021T\311\303*\260\000\222\251\342z\250\325\227,\347s\335\275\367\027\322\bu\360\205\23