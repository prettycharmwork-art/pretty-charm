    content: "        license: \'Awaiting authorized supplier or studio photo\',\n        reason:\n          \'No exact official manufacturer or authorized distributor photograph with verified reuse permission found for SKU PC-JWL-NCK-03. Current image preserved unchanged.\',\n      },\n    ];\n\n    for (const item of initialAudits) {\n      insertAudit.run(\n        item.productId,\n        item.query,\n        item.status,\n        item.candidateUrl,\n        item.sourceUrl,\n        item.license,\n        item.reason,\n        now\n      );\n    }\n  }\n\n  // Save baseline product integrity snapshot in store_settings if not already saved\n  const existingBaseline = db\n    .prepare(\"SELECT value_json FROM store_settings WHERE key = \'catalogue_integrity_baseline\'\")\n    .get() as { value_json: string } | undefined;\n  if (!existingBaseline) {\n    const prods = db.prepare(\'SELECT * FROM products ORDER BY id ASC\').all() as any[];\n    const vars = db.prepare(\'SELECT * FROM product_variants ORDER BY id ASC\').all() as any[];\n    const snapshot = prods.map((p) => ({\n      id: p.id,\n      name: p.name,\n      slug: p.slug,\n      categorySlug: p.category_slug,\n      sku: p.sku,\n      sellingPricePaise: p.selling_price_paise,\n      stockQty: p.stock_qty,\n      status: p.status,\n      variantSkus: vars.filter((v) => v.product_id === p.id).map((v) => v.sku),\n    }));\n    db.prepare(`\n      INSERT INTO store_settings (key, value_json, updated_at) VALUES (\'catalogue_integrity_baseline\', ?, ?)\n    `).run(JSON.stringify(snapshot), now);\n  }\n}\n\nexport function writeAuditLog(params: {\n  actorId?: string | null;\n  actorEmail: string;\n  actorRole: string;\n  action: string;\n  entityType: string;\n  entityId?: string | null;\n  details?: Record<string, unknown>;\n  ipAddress?: string;\n}): void {\n  db.prepare(`\n    INSERT INTO audit_logs (id, actor_id, actor_email, actor_role, action, entity_type, entity_id, details_json, ip_address, created_at)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n  `).run(\n    `aud-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,\n    params.actorId || null,\n    params.actorEmail,\n    params.actorRole,\n    params.action,\n    params.entityType,\n    params.entityId || null,\n    JSON.stringify(params.details || {}),\n    params.ipAddress || \'127.0.0.1\',\n    new Date().toISOString()\n  );\n}\n\nexport function receiveGoodsTransaction(params: {\n  supplierId: string;\n  poNumber: string;\n  notes?: string;\n  actorEmail: string;\n  items: Array<{ productId: string; quantity: number; unitCostPaise: number }>;\n}): { purchaseOrderId: string; totalCostPaise: number } {\n  return runInTransaction(() => {\n    const now = new Date().toISOString();\n    const poId = `po-${Date.now()}`;"
    num_lines: 1117
