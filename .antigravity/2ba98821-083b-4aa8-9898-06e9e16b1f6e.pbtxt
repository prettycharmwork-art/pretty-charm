026-1001\\\\\\\"]\');\\n  return { afterPaymentVerifiedText: card?.textContent?.trim()?.slice(0, 320) };\\n}\\\" && \\\\\\nplaywright-cli click \\\"[data-testid=\'confirm-order-btn-PC-2026-1001\']\\\" && \\\\\\nplaywright-cli eval \\\"async () => {\\n  await new Promise(r => setTimeout(r, 800));\\n  const card = document.querySelector(\'[data-testid=\\\\\\\"admin-order-card-PC-2026-1001\\\\\\\"]\');\\n  const confirmWa = document.querySelector(\'[data-testid=\\\\\\\"send-confirmation-whatsapp-PC-2026-1001\\\\\\\"]\');\\n  if (!confirmWa) throw new Error(\'Send Confirmation via WhatsApp button missing after confirm\');\\n  return {\\n    afterConfirmText: card?.textContent?.trim()?.slice(0, 320),\\n    confirmationWhatsappHref: confirmWa.getAttribute(\'href\')?.slice(0, 140)\\n  };\\n}\\\" && \\\\\\nplaywright-cli screenshot --filename=.playwright-cli/admin-orders-verified.png && \\\\\\nplaywright-cli close\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Verifying admin payment and order confirmation\", \"toolSummary\":\"Verify admin payment and order confirmation\"}"
