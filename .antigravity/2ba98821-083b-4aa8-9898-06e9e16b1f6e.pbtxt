            lines {
              text: "    return false;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  entry.count += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
