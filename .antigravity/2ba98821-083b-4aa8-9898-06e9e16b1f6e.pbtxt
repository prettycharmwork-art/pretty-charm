            lines {
              text: "  if (subtotalPaise <= 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (subtotalPaise >= rules.freeShippingThresholdPaise) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
