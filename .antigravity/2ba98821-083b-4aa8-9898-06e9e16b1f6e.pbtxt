  code_action {
    action_spec {
      command {
        instruction: "Update checkPinCodeServiceability in src/shared/domainLogic.ts so valid 6-digit Indian PIN codes not explicitly disabled in configuredPins are serviceable for Pan-India dispatch"
        is_edit: true
        file {
          absolute_uri: "file:///src/shared/domainLogic.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  const match = configuredPins.find((p) => p.pincode === cleaned);\n  if (!match || !match.isServiceable) {\n    return {\n      validFormat: true,\n      isServiceable: false,\n      message: `Delivery to PIN code ${cleaned} is not enabled yet. Please contact support on WhatsApp for special dispatch from Gurugram.`,\n    };\n  }\n\n  return {\n    validFormat: true,\n    isServiceable: true,\n    city: match.city,\n    state: match.state,\n    message: `Ships from Gurugram to ${match.city}, ${match.state} (${cleaned}). Estimated delivery date will be shared once dispatched.`,\n  };\n}"
          replacement_content: "  const match = configuredPins.find((p) => p.pincode === cleaned);\n  if (match && !match.isServiceable) {\n    return {\n      validFormat: true,\n      isServiceable: false,\n      message: `Delivery to PIN code ${cleaned} is not enabled yet. Please contact support on WhatsApp for special dispatch from Gurugram.`,\n    };\n  }\n\n  return {\n    validFormat: true,\n    isServiceable: true,\n    city: match?.city,\n    state: match?.state,\n    message: match\n      ? `Ships from Gurugram to ${match.city}, ${match.state} (${cleaned}). Estimated delivery date will be shared once dispatched.`\n      : `Ships Pan-India from Gurugram (${cleaned}). Estimated delivery date will be shared once dispatched.`,\n  };\n}"
          start_line: 280
          end_line: 298
        }
      }
    }
