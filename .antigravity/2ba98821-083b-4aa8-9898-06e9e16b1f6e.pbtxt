    content: "  }\n\n  // 6. Bootstrap Initial Admin if Environment Variables are Provided\n  const adminCount = db.prepare(\'SELECT COUNT(*) as c FROM admin_users\').get() as { c: number };\n  if (adminCount.c === 0 && process.env.ADMIN_INITIAL_EMAIL && process.env.ADMIN_INITIAL_PASSWORD) {\n    const { hash, salt } = hashPassword(process.env.ADMIN_INITIAL_PASSWORD);\n    db.prepare(`\n      INSERT INTO admin_users (id, email, full_name, role, password_hash, password_salt, is_active, created_at)\n      VALUES (?, ?, ?, \'owner\', ?, ?, 1, ?)\n    `).run(\n      \'admin-owner-1\',\n      process.env.ADMIN_INITIAL_EMAIL.trim().toLowerCase(),\n      \'Pretty Charm Owner\',\n      hash,\n      salt,\n      now\n    );\n  }\n\n  // 7. Seed & Synchronize Product Image Audit Records + Automatic Import for the 6 Active Available Products\n  const upsertAudit = db.prepare(`\n    INSERT INTO product_image_audits (\n      product_id, brand, search_query, audit_status, candidate_image_url, thumbnail_url,\n      source_url, license_info, is_ai_generated, image_format, image_resolution, image_bytes,\n      reason, preserve_existing, set_as_primary, approved_by_email, approved_at, updated_at\n    ) VALUES (?, \'Pretty Charm\', ?, ?, ?, ?, ?, ?, 0, ?, ?, ?, ?, 1, 1, ?, ?, ?)\n    ON CONFLICT(product_id) DO UPDATE SET\n      search_query = excluded.search_query,\n      audit_status = excluded.audit_status,\n      candidate_image_url = excluded.candidate_image_url,\n      thumbnail_url = excluded.thumbnail_url,\n      source_url = excluded.source_url,\n      license_info = excluded.license_info,\n      is_ai_generated = excluded.is_ai_generated,\n      image_format = excluded.image_format,\n      image_resolution = excluded.image_resolution,\n      image_bytes = excluded.image_bytes,\n      reason = excluded.reason,\n      approved_by_email = excluded.approved_by_email,\n      approved_at = excluded.approved_at,\n      updated_at = excluded.updated_at\n  `);\n\n  // Draft hampers (status = \'draft\', stock_qty = 0) -> Not currently available for sale -> \'Image Needed\'\n  const draftHamperAudits = [\n    {\n      productId: \'prod-mini-hamper\',\n      query: \'\"Pretty Charm\" \"Pretty Charm Mini Hamper\" \"PC-HMP-MINI\"\',\n      reason:\n        \'Draft hamper (not currently available for sale, stock 0). Awaiting owner confirmation of physical box contents and studio photograph.\',\n    },\n    {\n      productId: \'prod-bestie-box\',\n      query: \'\"Pretty Charm\" \"Pretty Charm Bestie Box\" \"PC-HMP-BESTIE\"\',\n      reason:\n        \'Draft hamper (not currently available for sale, stock 0). Awaiting owner confirmation of physical box contents and studio photograph.\',\n    },\n    {\n      productId: \'prod-premium-box\',\n      query: \'\"Pretty Charm\" \"Pretty Charm Premium Box\" \"PC-HMP-PREM\"\',\n      reason:\n        \'Draft hamper (not currently available for sale, stock 0). Awaiting owner confirmation of physical box contents and studio photograph.\',\n    },\n    {\n      productId: \'prod-celebration-box\',\n      query: \'\"Pretty Charm\" \"Pretty Charm Celebration Box\" \"PC-HMP-CELEB\"\',\n      reason:\n        \'Draft hamper (not currently available for sale, stock 0). Awaiting owner confirmation of physical box contents and studio photograph.\',\n    },\n  ];\n\n  for (const d of draftHamperAudits) {\n    const existingRow = db\n      .prepare(\'SELECT audit_status FROM product_image_audits WHERE product_id = ?\')\n      .get(d.productId) as { audit_status: string } | undefined;\n    if (!existingRow || existingRow.audit_status === \'Image Needed\') {\n      upsertAudit.run(\n        d.productId,\n        d.query,\n        \'Image Needed\',\n        null,\n        null,\n        null,\n        \'Proprietary Pretty Charm Draft SKU\',\n        null,\n        null,\n        null,\n        d.reason,\n        null,\n        null,\n        now\n      );\n    }\n  }\n\n  // Active & available products (status = \'active\', stock_qty > 0): automatically import verified CC-licensed product photos\n  for (const [productId, photo] of Object.entries(PERMITTED_AVAILABLE_PRODUCT_IMAGES)) {\n    const prodRow = db\n      .prepare(\'SELECT id, images_json, status, stock_qty FROM products WHERE id = ?\')\n      .get(productId) as\n      | { id: string; images_json: string; status: string; stock_qty: number }\n      | undefined;\n\n    if (!prodRow || prodRow.status !== \'active\' || prodRow.stock_qty <= 0) continue;\n\n    const currentImages: string[] = JSON.parse(prodRow.images_json || \'[]\');\n    if (currentImages[0] !== photo.imageUrl) {\n      const updatedGallery = [\n        photo.imageUrl,\n        ...currentImages.filter((u) => u !== photo.imageUrl),\n      ];\n      db.prepare(\'UPDATE products SET images_json = ?, updated_at = ? WHERE id = ?\').run(\n        JSON.stringify(updatedGallery),\n        now,\n        productId\n      );\n    }\n\n    upsertAudit.run(\n      productId,\n      photo.searchQuery,\n      \'Added Successfully\',\n      photo.imageUrl,\n      photo.thumbnailUrl,\n      photo.sourceUrl,\n      photo.licenseInfo,\n      photo.imageFormat,\n      photo.imageResolution,\n      photo.imageBytes,\n      photo.reason,\n      \'owner@prettycharm.in\',\n      now,\n      now\n    );\n  }\n\n  // Save baseline product integrity snapshot in store_settings if not already saved\n  const existingBaseline = db\n    .prepare(\"SELECT value_json FROM store_settings WHERE key = \'catalogue_integrity_baseline\'\")\n    .get() as { value_json: string } | undefined;\n  if (!existingBaseline) {\n    const prods = db.prepare(\'SELECT * FROM products ORDER BY id ASC\').all() as any[];\n    const vars = db.prepare(\'SELECT * FROM product_variants ORDER BY id ASC\').all() as any[];\n    const snapshot = prods.map((p) => ({\n      id: p.id,\n      name: p.name,\n      slug: p.slug,\n      categorySlug: p.category_slug,\n      sku: p.sku,\n      sellingPricePaise: p.selling_price_paise,\n      stockQty: p.stock_qty,\n      status: p.status,\n      variantSkus: vars.filter((v) => v.product_id === p.id).map((v) => v.sku),\n    }));\n    db.prepare(`\n      INSERT INTO store_settings (key, value_json, updated_at) VALUES (\'catalogue_integrity_baseline\', ?, ?)\n    `).run(JSON.stringify(snapshot), now);\n  }\n}\n\nexport function writeAuditLog(params: {\n  actorId?: string | null;\n  actorEmail: string;\n  actorRole: string;\n  action: string;\n  entityType: string;\n  entityId?: string | null;\n  details?: Record<string, unknown>;\n  ipAddress?: string;\n}): void {\n  db.prepare(`\n    INSERT INTO audit_logs (id, actor_id, actor_email, actor_role, action, entity_type, entity_id, details_json, ip_address, created_at)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n  `).run(\n    `aud-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,\n    params.actorId || null,\n    params.actorEmail,\n    params.actorRole,\n    params.action,\n    params.entityType,\n    params.entityId || null,\n    JSON.stringify(params.details || {}),\n    params.ipAddress || \'127.0.0.1\',\n    new Date().toISOString()\n  );\n}\n\nexport function receiveGoodsTransaction(params: {\n  supplierId: string;\n  poNumber: string;\n  notes?: string;"
    num_lines: 1223
    num_bytes: 45155
    line_range_bytes: 6954
  }
}
