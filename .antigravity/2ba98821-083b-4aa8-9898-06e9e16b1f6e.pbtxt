              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const [cameraPreset, setCameraPreset] = useState<CameraPreset>(\'studio\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const [dockCollapsed, setDockCollapsed] = useState<boolean>(false);"
